{
  "file_scan_exclusions": ["**/.docs", "**/.cache", "**/.githooks", "..."],
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "lint": {
          "cssConflict": "ignore",
          "suggestCanonicalClasses": "ignore",
        },
      },
    },
  },
  "languages": {
    "TypeScript": { "enable_language_server": false },
    "JavaScript": { "enable_language_server": false },
  },
}
