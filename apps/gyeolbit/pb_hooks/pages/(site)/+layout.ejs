<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1" />
    <title><%= meta('title') %></title>
    <meta
      name="description"
      content="<%= meta('description') %>" />
    <link
      rel="icon"
      type="image/png"
      href="<%= asset('/assets/favicon.png') %>" />
    <link
      rel="stylesheet"
      href="<%= asset('/assets/style.css') %>" />
    <script
      defer
      src="<%= asset('/assets/vendor/alpine-3.15.12-cdn.min.js') %>"></script>
    <%- slots.head %>
  </head>

  <body>
    <main><%- slots.body || slot %></main>
  </body>
</html>
