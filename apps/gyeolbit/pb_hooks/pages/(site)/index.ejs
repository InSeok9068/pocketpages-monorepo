<script server>
  const BIRTH_PLACES = [
    { id: 'seoul', label: '서울', longitude: 126.98, correctTime: true },
    { id: 'busan', label: '부산', longitude: 129.08, correctTime: true },
    { id: 'daegu', label: '대구', longitude: 128.6, correctTime: true },
    { id: 'incheon', label: '인천', longitude: 126.71, correctTime: true },
    { id: 'gwangju', label: '광주', longitude: 126.85, correctTime: true },
    { id: 'daejeon', label: '대전', longitude: 127.38, correctTime: true },
    { id: 'ulsan', label: '울산', longitude: 129.31, correctTime: true },
    { id: 'sejong', label: '세종', longitude: 127.29, correctTime: true },
    { id: 'gyeonggi', label: '경기', longitude: 127.03, correctTime: true },
    { id: 'gangwon', label: '강원', longitude: 127.73, correctTime: true },
    { id: 'chungbuk', label: '충북', longitude: 127.49, correctTime: true },
    { id: 'chungnam', label: '충남', longitude: 126.67, correctTime: true },
    { id: 'jeonbuk', label: '전북', longitude: 127.15, correctTime: true },
    { id: 'jeonnam', label: '전남', longitude: 126.46, correctTime: true },
    { id: 'gyeongbuk', label: '경북', longitude: 128.73, correctTime: true },
    { id: 'gyeongnam', label: '경남', longitude: 128.68, correctTime: true },
    { id: 'jeju', label: '제주', longitude: 126.53, correctTime: true },
    { id: 'other', label: '해외 · 기타', longitude: 135, correctTime: false },
  ]

  const GENDER_LABELS = {
    female: '여성',
    male: '남성',
    private: '선택 안 함',
  }

  function readText(value) {
    return String(value || '').trim()
  }

  function padNumber(value) {
    const text = String(value)
    return text.length < 2 ? `0${text}` : text
  }

  function getPlace(placeId) {
    return (
      BIRTH_PLACES.find(function (place) {
        return place.id === placeId
      }) || BIRTH_PLACES[0]
    )
  }

  /**
   * 오늘이 속한 사주 연도부터 3년간의 세운 간지를 만세력에서 가져옵니다.
   *
   * 세운은 달력 연도가 아니라 입춘을 경계로 바뀝니다.
   */
  function getAnnualPillars(manseryeok, year, month, day) {
    const startYear = manseryeok.isBeforeLichun(month, day) ? year - 1 : year
    const pillars = []

    for (let offset = 0; offset < 3; offset += 1) {
      const targetYear = startYear + offset
      // 입춘(2월 4일경) 직후 날짜의 연주가 해당 사주 연도의 세운 간지입니다.
      pillars.push({
        year: targetYear,
        pillar: manseryeok.getGapja(targetYear, 2, 10).yearPillar,
      })
    }

    return pillars
  }

  function buildPrompt(result) {
    const timeText = result.timeUnknown
      ? '태어난 시간 모름 — 시주는 제외하고 해석'
      : result.inputTime + ' (' + result.correctedTimeText + ')'
    const lunarText =
      result.lunar.year
      + '년 '
      + result.lunar.month
      + '월 '
      + result.lunar.day
      + '일'
      + (result.lunar.isLeapMonth ? ' 윤달' : '')
    const pillarText = [
      '년주 ' + result.saju.yearPillar + '(' + result.saju.yearPillarHanja + ')',
      '월주 ' + result.saju.monthPillar + '(' + result.saju.monthPillarHanja + ')',
      '일주 ' + result.saju.dayPillar + '(' + result.saju.dayPillarHanja + ')',
      result.saju.hourPillar ? '시주 ' + result.saju.hourPillar + '(' + result.saju.hourPillarHanja + ')' : '시주 미상',
    ].join(' · ')

    const promptLines = [
      '당신은 한국 사주명리의 여러 해석 관점을 균형 있게 설명하는 해석가입니다.',
      '아래 계산된 만세력 원국을 기준으로, 과장하거나 운명을 단정하지 말고 실생활에 적용 가능한 언어로 풀어주세요.',
      '',
      '## 해석 대상',
      '- 성별: ' + result.genderLabel,
      '- 출생 입력: ' + result.calendarLabel + ' ' + result.inputDate,
      '- 태어난 시간: ' + timeText,
      '- 태어난 지역: ' + result.place.label + ' (대표 경도 ' + result.place.longitude + '° 기준)',
      '',
      '## 계산된 만세력',
      '- 양력: ' + result.solar.year + '년 ' + result.solar.month + '월 ' + result.solar.day + '일',
      '- 음력: ' + lunarText,
      '- 사주 원국: ' + pillarText,
      '- 일간: ' + result.analysis.dayMaster.label,
      '- 겉글자 오행 분포: ' + result.analysis.elementProfile.text,
      '- 천간 십신: ' + result.analysis.stemTenGodText,
      '- 지지 본기 십신: ' + result.analysis.branchTenGodText,
      '- 지장간과 십신:',
    ]

    result.analysis.hiddenStemLines.forEach(function (line) {
      promptLines.push('  - ' + line)
    })

    promptLines.push('- 월령과 계절: ' + result.analysis.monthCommand.text)
    promptLines.push('- 일간 기준 12운성: ' + result.analysis.twelveStageText)
    promptLines.push('- 원국의 고정 관계:')
    if (result.analysis.natalRelationLines.length > 0) {
      result.analysis.natalRelationLines.forEach(function (line) {
        promptLines.push('  - ' + line)
      })
    } else {
      promptLines.push('  - 천간합·지지 합충형파해·삼합·방합 중 확인된 관계 없음')
    }

    promptLines.push('- 향후 3년 세운(입춘 기준):')
    result.analysis.annualFortuneLines.forEach(function (line) {
      promptLines.push('  - ' + line)
    })

    promptLines.push(
      '- 주의: 오행 개수는 겉글자 기준이며 지장간 가중치, 월령, 조후, 합화는 반영하지 않았습니다.',
      '- 주의: 합·삼합·방합은 관계의 존재만 표시하며 실제 합화 성립을 뜻하지 않습니다.',
      '',
      '## 요청할 풀이',
      '1. 내 기본 성격 구조: 겉으로 보이는 모습과 실제 내면 성향의 차이',
      '2. 인간관계에서 반복되는 문제 패턴과 그 원인',
      '3. 연애 스타일과 잘 맞는 사람, 충돌하기 쉬운 사람의 유형',
      '4. 결혼 생활에서 생길 수 있는 현실적인 갈등 지점과 조율법',
      '5. 돈을 벌고 관리하는 방식의 성향: 안정형, 기복형, 타이밍형 여부',
      '6. 사회생활에서 인정받는 방식과 힘들어지는 환경',
      '7. ' + result.currentYear + '년부터 3년간 흐름이 좋아지는 시기와 주의할 시기',
      '8. 스스로 고치면 삶이 편해질 가능성이 높은 습관 3가지',
      '',
      '## 해석 원칙',
      '- 제공된 사주 원국은 다시 계산하지 말고 그대로 사용하세요.',
      '- 제공된 지장간·십신·월령·12운성·원국 관계·세운은 다시 계산하지 마세요.',
      '- 모든 관계를 같은 비중으로 다루지 말고 월령·일간·원국 구조와 직접 관련된 요소를 우선하세요.',
      '- 신강·신약, 조후, 용신과 합화 성립은 제공된 확정 계산과 구분하여 해석하세요.',
      '- 각 항목을 [관찰] → [해석] → [현실적인 조언] 순서로 작성하세요.',
      '- 학파에 따라 달라지는 판단은 하나로 단정하지 말고 다른 가능성을 짧게 밝혀주세요.',
      '- 건강, 투자, 법률 문제를 확정적으로 예언하지 마세요.',
      '- 태어난 시간이 없으면 시주와 시주에 의존하는 해석은 제외하거나 불확실성을 표시하세요.',
      '- 막연한 좋은 말보다 근거가 된 원국의 글자와 관계를 함께 적어주세요.',
      '- 전체 답변은 읽기 쉬운 한국어로, 항목별 제목을 붙여 작성하세요.',
      '',
      '## 개인정보 및 대화 맥락',
      '- 이 요청에 적힌 정보만 사용하고, 저장된 메모리·과거 대화·사용자 프로필을 참조하지 마세요.',
      '- 생년 정보와 해석 결과를 장기 메모리나 이후 대화의 개인화 정보로 저장하지 마세요.',
      '- 플랫폼에서 이 요청을 보장할 수 없다면 그 사실을 짧게 알리고, 제공된 정보 범위 안에서만 답하세요.'
    )

    return promptLines.join('\n')
  }

  meta('title', '결빛 사주 · 나의 결을 비추다')
  meta('description', '출생 정보로 만세력을 계산하고 AI에게 보낼 사주 풀이 프롬프트를 준비합니다.')

  const formValues = {
    calendarType: 'solar',
    birthYear: '',
    birthMonth: '',
    birthDay: '',
    birthTime: '12:00',
    timeUnknown: false,
    isLeapMonth: false,
    birthPlace: 'seoul',
    gender: 'female',
  }
  let promptText = ''
  let resultSummary = null
  let formError = ''

  dbg('gyeolbit/home:request', { method: String(request.method || '') })

  if (request.method === 'POST') {
    const { dateutil } = require('@pocketpages/utils')
    const manseryeok = require('@fullstackfamily/manseryeok')
    const sajuAnalysis = resolve('saju-analysis')
    const form = body()

    formValues.calendarType = readText(form.calendarType) === 'lunar' ? 'lunar' : 'solar'
    formValues.birthYear = readText(form.birthYear)
    formValues.birthMonth = readText(form.birthMonth)
    formValues.birthDay = readText(form.birthDay)
    formValues.birthTime = readText(form.birthTime) || '12:00'
    formValues.timeUnknown = readText(form.timeUnknown) === 'on'
    formValues.isLeapMonth = readText(form.isLeapMonth) === 'on'
    formValues.birthPlace = readText(form.birthPlace) || 'seoul'
    formValues.gender = GENDER_LABELS[readText(form.gender)] ? readText(form.gender) : 'private'

    try {
      const year = Number(formValues.birthYear)
      const month = Number(formValues.birthMonth)
      const day = Number(formValues.birthDay)

      if (!/^\d{4}$/.test(formValues.birthYear) || year < 1900 || year > 2050) {
        throw new Error('출생 연도는 1900년부터 2050년 사이로 입력해 주세요.')
      }
      if (!/^\d{1,2}$/.test(formValues.birthMonth) || month < 1 || month > 12) {
        throw new Error('출생 월을 정확히 입력해 주세요.')
      }
      if (!/^\d{1,2}$/.test(formValues.birthDay) || day < 1 || day > 31) {
        throw new Error('출생 일을 정확히 입력해 주세요.')
      }

      const inputDate = year + '-' + padNumber(month) + '-' + padNumber(day)
      let solar = { year: year, month: month, day: day }

      if (formValues.calendarType === 'solar') {
        const dateOnlyIso = dateutil.toDateOnlyIso(inputDate)
        if (!dateOnlyIso || dateOnlyIso.slice(0, 10) !== inputDate) {
          throw new Error('실제로 존재하는 양력 날짜를 입력해 주세요.')
        }
      } else {
        const converted = manseryeok.lunarToSolar(year, month, day, formValues.isLeapMonth)
        solar = converted.solar
      }

      let hour
      let minute = 0
      if (!formValues.timeUnknown) {
        const timeMatch = formValues.birthTime.match(/^(\d{2}):(\d{2})$/)
        if (!timeMatch) throw new Error('태어난 시간을 정확히 입력해 주세요.')

        hour = Number(timeMatch[1])
        minute = Number(timeMatch[2])
        if (hour > 23 || minute > 59) throw new Error('태어난 시간을 정확히 입력해 주세요.')
      }

      const place = getPlace(formValues.birthPlace)

      dbg('gyeolbit/home:calculate-saju', {
        calendarType: formValues.calendarType,
        solarDate: solar.year + '-' + padNumber(solar.month) + '-' + padNumber(solar.day),
        hasBirthTime: !formValues.timeUnknown,
        birthPlace: place.id,
      })

      const saju = manseryeok.calculateSaju(solar.year, solar.month, solar.day, hour, minute, {
        longitude: place.longitude,
        applyTimeCorrection: place.correctTime,
      })
      const lunar = manseryeok.solarToLunar(solar.year, solar.month, solar.day).lunar
      const today = dateutil.formatDate(Date.now(), 'YYYY-MM-DD').split('-').map(Number)
      const annualPillars = getAnnualPillars(manseryeok, today[0], today[1], today[2])
      const currentYear = annualPillars[0].year
      const analysis = sajuAnalysis.analyzeSaju(saju, annualPillars)
      const correctedTimeText = saju.correctedTime
        ? padNumber(saju.correctedTime.hour) + ':' + padNumber(saju.correctedTime.minute) + ' 경도 보정'
        : formValues.timeUnknown
          ? '시간 미입력'
          : formValues.birthTime + ' 보정 없음'
      const result = {
        calendarLabel: formValues.calendarType === 'lunar' ? '음력' : '양력',
        correctedTimeText: correctedTimeText,
        currentYear: currentYear,
        analysis: analysis,
        genderLabel: GENDER_LABELS[formValues.gender],
        inputDate: inputDate + (formValues.isLeapMonth && formValues.calendarType === 'lunar' ? ' 윤달' : ''),
        inputTime: formValues.birthTime,
        lunar: lunar,
        place: place,
        saju: saju,
        solar: solar,
        timeUnknown: formValues.timeUnknown,
      }

      promptText = buildPrompt(result)
      resultSummary = result
    } catch (exception) {
      formError = String(exception && exception.message ? exception.message : exception)
      warn('gyeolbit/home:invalid-input', { error: formError })
    }
  }
</script>

<div class="app-shell">
  <header class="app-header">
    <a
      class="brand"
      href="/"
      aria-label="결빛 홈">
      <span
        class="brand-mark"
        aria-hidden="true">
        結
      </span>
      <span>
        <strong>결빛 사주</strong>
        <small>나의 결을 비추다</small>
      </span>
    </a>
    <span class="privacy-badge">서버 저장 없음</span>
  </header>

  <% if (!resultSummary) { %>
  <section
    class="screen screen-form"
    x-data="{ calendarType: '<%= formValues.calendarType %>', timeUnknown: <%= formValues.timeUnknown ? 'true' : 'false' %> }">
    <div class="intro-copy">
      <p class="eyebrow">STEP 1 · 출생 정보</p>
      <h1>
        풀이 전에,
        <br />
        <em>정확한 원국</em>
        부터 준비해요.
      </h1>
      <p>입력한 정보로 만세력을 계산하고 AI에게 보낼 질문을 한 번에 정리해 드려요.</p>
    </div>

    <form
      method="post"
      class="birth-form">
      <% if (formError) { %>
      <div
        class="form-error"
        role="alert">
        <%= formError %>
      </div>
      <% } %>

      <div class="field-group compact-group">
        <span class="field-label">달력 기준</span>
        <div class="segment-control">
          <label>
            <input
              type="radio"
              name="calendarType"
              value="solar"
              x-model="calendarType" />
            <span>양력</span>
          </label>
          <label>
            <input
              type="radio"
              name="calendarType"
              value="lunar"
              x-model="calendarType" />
            <span>음력</span>
          </label>
        </div>
      </div>

      <div class="field-group">
        <div class="field-heading">
          <label
            class="field-label"
            for="birth-year">
            생년월일
          </label>
          <label
            class="inline-check"
            x-show="calendarType === 'lunar'"
            x-cloak>
            <input
              type="checkbox"
              name="isLeapMonth"
              <%= formValues.isLeapMonth ? 'checked' : '' %> />
            <span>윤달</span>
          </label>
        </div>
        <div class="date-grid">
          <label class="input-wrap year-input">
            <input
              id="birth-year"
              name="birthYear"
              type="number"
              inputmode="numeric"
              min="1900"
              max="2050"
              placeholder="1990"
              value="<%= formValues.birthYear %>"
              required />
            <span>년</span>
          </label>
          <label class="input-wrap">
            <input
              name="birthMonth"
              type="number"
              inputmode="numeric"
              min="1"
              max="12"
              placeholder="5"
              value="<%= formValues.birthMonth %>"
              required />
            <span>월</span>
          </label>
          <label class="input-wrap">
            <input
              name="birthDay"
              type="number"
              inputmode="numeric"
              min="1"
              max="31"
              placeholder="15"
              value="<%= formValues.birthDay %>"
              required />
            <span>일</span>
          </label>
        </div>
      </div>

      <div class="form-row">
        <div class="field-group">
          <div class="field-heading">
            <label
              class="field-label"
              for="birth-time">
              태어난 시간
            </label>
            <label class="inline-check">
              <input
                type="checkbox"
                name="timeUnknown"
                x-model="timeUnknown"
                <%= formValues.timeUnknown ? 'checked' : '' %> />
              <span>모름</span>
            </label>
          </div>
          <input
            id="birth-time"
            class="control"
            name="birthTime"
            type="time"
            value="<%= formValues.birthTime %>"
            :disabled="timeUnknown"
            :required="!timeUnknown" />
        </div>

        <div class="field-group">
          <label
            class="field-label"
            for="birth-place">
            태어난 지역
          </label>
          <select
            id="birth-place"
            class="control"
            name="birthPlace">
            <% BIRTH_PLACES.forEach(function (place) { %>
            <option
              value="<%= place.id %>"
              <%= formValues.birthPlace === place.id ? 'selected' : '' %>>
              <%= place.label %>
            </option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="field-group compact-group">
        <span class="field-label">성별</span>
        <div class="segment-control gender-control">
          <label>
            <input
              type="radio"
              name="gender"
              value="female"
              <%= formValues.gender === 'female' ? 'checked' : '' %> />
            <span>여성</span>
          </label>
          <label>
            <input
              type="radio"
              name="gender"
              value="male"
              <%= formValues.gender === 'male' ? 'checked' : '' %> />
            <span>남성</span>
          </label>
          <label>
            <input
              type="radio"
              name="gender"
              value="private"
              <%= formValues.gender === 'private' ? 'checked' : '' %> />
            <span>미선택</span>
          </label>
        </div>
      </div>

      <button
        class="primary-button"
        type="submit">
        <span>AI용 프롬프트 만들기</span>
        <span aria-hidden="true">→</span>
      </button>
    </form>

    <p class="privacy-note">생년 정보는 프롬프트 생성에만 사용되며 서버에 저장하지 않습니다.</p>
  </section>
  <% } else { %>
  <section
    class="screen screen-result"
    x-data="{ copied: false }">
    <div class="result-heading">
      <div>
        <p class="eyebrow">STEP 2 · 프롬프트 완성</p>
        <h1>
          원국을 담은 질문이
          <br />
          <em>준비됐어요.</em>
        </h1>
      </div>
      <div
        class="pillar-orbit"
        aria-label="사주 원국">
        <span><%= resultSummary.saju.yearPillar %></span>
        <span><%= resultSummary.saju.monthPillar %></span>
        <span><%= resultSummary.saju.dayPillar %></span>
        <span><%= resultSummary.saju.hourPillar || '미상' %></span>
      </div>
    </div>

    <div class="result-meta">
      <span>
        일간
        <strong><%= resultSummary.analysis.dayMaster.label %></strong>
      </span>
      <span><%= resultSummary.analysis.elementProfile.text %></span>
    </div>

    <label class="prompt-editor">
      <span class="prompt-label">
        <strong>AI에게 보낼 내용</strong>
        <small>가능하면 AI 서비스의 임시 대화에서 사용하세요.</small>
      </span>
      <textarea
        x-ref="prompt"
        spellcheck="false">
<%= promptText %></textarea>
    </label>

    <div class="result-actions">
      <a
        class="secondary-button"
        href="/">
        다시 입력
      </a>
      <button
        class="primary-button copy-button"
        type="button"
        @click="navigator.clipboard.writeText($refs.prompt.value).then(() => { copied = true; setTimeout(() => copied = false, 1600) })">
        <span x-text="copied ? '복사했어요' : '프롬프트 복사'">프롬프트 복사</span>
        <span
          aria-hidden="true"
          x-text="copied ? '✓' : '⧉'">
          ⧉
        </span>
      </button>
    </div>

    <p class="privacy-note">
      프롬프트만으로 AI의 저장 정책은 바뀌지 않습니다. 생년 정보는 가능하면 임시 대화 모드에서 사용하세요.
    </p>
  </section>
  <% } %>
</div>
