<script server>
  const homeItemsData = resolve('home-items-data')
  const { dateutil } = require('@pocketpages/utils')
  const input = body() || {}
  const isHtmx = String(request.header('HX-Request') || '').toLowerCase() === 'true'
  const userId = request.auth ? String(request.auth.get('id') || '') : ''
  const section = String(input.section || '')
  const title = String(input.title || '').trim()
  const frequencyValues = ['none', 'weekly', 'monthly']
  const repeatFrequency =
    frequencyValues.indexOf(String(input.repeatFrequency || 'none')) >= 0
      ? String(input.repeatFrequency || 'none')
      : 'none'
  const repeatWeekdays = homeItemsData.readWeekdays(input.repeatWeekdays)
  const intervalField = repeatFrequency === 'monthly' ? input.repeatMonthlyInterval : input.repeatWeeklyInterval
  const interval = Math.max(1, Math.min(12, parseInt(String(intervalField || '1'), 10) || 1))
  const enteredDate = String(input.nextDueDate || '').trim()
  const today = dateutil.formatDate(new Date(), dateutil.FORMATS.DATE)
  const dueDateText = enteredDate || today
  let returnSection = String(input.returnSection || section)
  if (['task', 'purchase', 'grocery'].indexOf(returnSection) < 0) returnSection = 'task'
  const filters = homeItemsData.readFilters({
    section: returnSection,
    keyword: input.returnKeyword,
    status: input.returnStatus,
    tag: input.returnTag,
  })
  let listMessage = ''

  dbg('homepocket/xapi/items/create:start', { userId, section, titleLength: title.length })

  try {
    if (request.method !== 'POST') throw new Error('잘못된 요청입니다.')
    if (!userId) throw new Error('로그인이 필요합니다.')
    if (['task', 'purchase', 'grocery'].indexOf(section) < 0) throw new Error('항목 구분을 확인해 주세요.')
    if (!title) throw new Error('항목 이름을 입력해 주세요.')
    if (title.length > 200) throw new Error('항목 이름은 200자 이내로 입력해 주세요.')
    if (enteredDate && (!/^\d{4}-\d{2}-\d{2}$/.test(enteredDate) || !dateutil.toDateOnlyIso(enteredDate)))
      throw new Error('예정일을 확인해 주세요.')
    if (section === 'task' && repeatFrequency === 'weekly' && !repeatWeekdays.length)
      throw new Error('매주 반복할 요일을 선택해 주세요.')

    const channelValue = section === 'task' ? '' : String(input.channel || '')
    if (channelValue && ['offline', 'online'].indexOf(channelValue) < 0) throw new Error('구매 태그를 확인해 주세요.')
    let repeatDayOfMonth = parseInt(String(input.repeatDayOfMonth || ''), 10) || 0
    if (section === 'task' && repeatFrequency === 'monthly') {
      if (!repeatDayOfMonth) repeatDayOfMonth = Number(dueDateText.slice(8, 10))
      if (repeatDayOfMonth < 1 || repeatDayOfMonth > 31)
        throw new Error('매월 반복 날짜는 1일부터 31일 사이로 입력해 주세요.')
    }

    const collection = $app.findCollectionByNameOrId('homeItems')
    const record = new Record(collection)
    record.set('user', userId)
    record.set('title', title)
    record.set('section', section)
    record.set('channel', channelValue)
    record.set('status', 'open')
    record.set('repeatFrequency', section === 'task' ? repeatFrequency : 'none')
    record.set('repeatInterval', section === 'task' && repeatFrequency !== 'none' ? interval : 1)
    record.set('repeatWeekdays', section === 'task' && repeatFrequency === 'weekly' ? repeatWeekdays : [])
    record.set('repeatDayOfMonth', section === 'task' && repeatFrequency === 'monthly' ? repeatDayOfMonth : 0)
    record.set(
      'nextDueDate',
      section === 'task' && repeatFrequency !== 'none' ? dateutil.toDateOnlyIso(dueDateText) : ''
    )
    record.set('lastCompletedAt', '')
    record.set(
      'note',
      String(input.note || '')
        .trim()
        .slice(0, 2000)
    )
    $app.save(record)
    response.header('HX-Trigger', JSON.stringify({ 'home-item-created': { section } }))

    info('homepocket/xapi/items/create:success', { userId, itemId: String(record.get('id') || ''), section })
  } catch (exception) {
    listMessage = String(exception.message || exception)
    error('homepocket/xapi/items/create:failed', { userId, section, error: listMessage })
  }

  if (!isHtmx) {
    const target =
      '/?section='
      + encodeURIComponent(filters.section)
      + (filters.keyword ? '&keyword=' + encodeURIComponent(filters.keyword) : '')
      + '&status='
      + encodeURIComponent(filters.status)
      + (filters.tag ? '&tag=' + encodeURIComponent(filters.tag) : '')
    dbg('homepocket/xapi/items/create:redirect', {
      status: 303,
      redirectTo: target,
      message: listMessage || '항목을 추가했습니다.',
    })
    redirect(target, { status: 303, message: listMessage || '항목을 추가했습니다.' })
    return
  }

  const itemCards = userId ? homeItemsData.listItems(userId, filters) : []
</script>
<%- include('home-items-list.ejs', { itemCards, filters, listMessage }) %>
