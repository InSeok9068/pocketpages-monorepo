<script server>
  const homeItemsData = resolve('home-items-data')
  const filters = homeItemsData.readFilters(request.url.query || {})
  const sectionTitles = {
    task: '할 일',
    purchase: '구매',
    grocery: '장보기',
  }
  const sectionOrder = ['task', 'purchase', 'grocery']
  const userId = request.auth ? String(request.auth.get('id') || '') : ''
  const sectionPanels = []

  if (userId) {
    for (const section of sectionOrder) {
      const panelFilters = homeItemsData.readFilters({
        section,
        keyword: filters.keyword,
        status: filters.status,
        tag: section === filters.section ? filters.tag : '',
      })
      sectionPanels.push({
        filters: panelFilters,
        sectionTitle: sectionTitles[section],
        itemCards: homeItemsData.listItems(userId, panelFilters),
      })
    }
  }

  meta('title', sectionTitles[filters.section])
  meta('description', '생활 목록')
</script>

<div class="home-page<%= request.auth ? ' has-bottom-nav' : '' %>">
  <% if (request.auth) { %>
  <div
    class="home-section-swiper"
    data-home-section-swiper
    data-initial-section="<%= filters.section %>">
    <div class="swiper-wrapper">
      <% for (const panel of sectionPanels) { %>
      <div
        class="swiper-slide<%= panel.filters.section === filters.section ? ' is-active' : '' %>"
        data-home-section-slide="<%= panel.filters.section %>">
        <%- include('home-section-panel.ejs', {
          filters: panel.filters,
          sectionTitle: panel.sectionTitle,
          itemCards: panel.itemCards,
          showFlash: panel.filters.section === filters.section,
        }) %>
      </div>
      <% } %>
    </div>
  </div>
  <% } else { %>
  <%- include('home-section-panel.ejs', {
    filters,
    sectionTitle: sectionTitles[filters.section],
    itemCards: [],
    showFlash: true,
  }) %>
  <% } %>
</div>

<% if (request.auth) { %>
<nav
  class="bottom-nav"
  aria-label="주요 메뉴">
  <div class="bottom-nav-inner">
    <a
      class="bottom-nav-link <%= filters.section === 'task' ? 'is-active' : '' %>"
      href="/?section=task"
      data-home-section-tab="task"
      <% if (filters.section === 'task') { %>aria-current="page"<% } %>>
      <span class="bottom-nav-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M9 6h11M9 12h11M9 18h11"></path>
          <path d="m3.5 6 1 1 2-2M3.5 12l1 1 2-2M3.5 18l1 1 2-2"></path>
        </svg>
      </span>
      <span>할 일</span>
    </a>
    <a
      class="bottom-nav-link <%= filters.section === 'purchase' ? 'is-active' : '' %>"
      href="/?section=purchase"
      data-home-section-tab="purchase"
      <% if (filters.section === 'purchase') { %>aria-current="page"<% } %>>
      <span class="bottom-nav-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M6 8h12l-1 12H7L6 8Z"></path>
          <path d="M9 9V6a3 3 0 0 1 6 0v3"></path>
        </svg>
      </span>
      <span>구매</span>
    </a>
    <a
      class="bottom-nav-link <%= filters.section === 'grocery' ? 'is-active' : '' %>"
      href="/?section=grocery"
      data-home-section-tab="grocery"
      <% if (filters.section === 'grocery') { %>aria-current="page"<% } %>>
      <span class="bottom-nav-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="m5 10 2 10h10l2-10H5Z"></path>
          <path d="m8 10 4-6 4 6"></path>
        </svg>
      </span>
      <span>장보기</span>
    </a>
  </div>
</nav>
<script
  defer
  src="<%= asset('/assets/vendor/swiper-12.2.0.min.js') %>"></script>
<script
  defer
  src="<%= asset('/assets/home-filters.js') %>"></script>
<script
  defer
  src="<%= asset('/assets/home-sections.js') %>"></script>
<% } %>
