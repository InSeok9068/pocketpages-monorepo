<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1" />
    <title><%= meta('title') %></title>
    <meta
      name="description"
      content="<%= meta('description') %>" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="<%= asset('/assets/favicon.svg') %>" />
    <link
      rel="apple-touch-icon"
      href="<%= asset('/assets/icon-192.png') %>" />
    <link
      rel="manifest"
      href="<%= asset('/assets/manifest.webmanifest') %>" />
    <meta
      name="theme-color"
      content="#f8faf9" />
    <meta
      name="mobile-web-app-capable"
      content="yes" />
    <meta
      name="apple-mobile-web-app-capable"
      content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="default" />
    <meta
      name="apple-mobile-web-app-title"
      content="Homepocket" />
    <link
      rel="stylesheet"
      href="<%= asset('/assets/style.css') %>" />
    <script src="<%= asset('/assets/vendor/htmx-2.0.11.min.js') %>"></script>
    <script
      defer
      src="<%= asset('/assets/vendor/alpine-3.17.4-cdn.min.js') %>"></script>
    <%- slots.head %>
  </head>

  <body>
    <main><%- slots.body || slot %></main>
  </body>
</html>
