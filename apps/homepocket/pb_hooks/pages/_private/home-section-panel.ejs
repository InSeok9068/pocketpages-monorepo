<div class="home-app">
    <header class="home-header">
      <div>
        <div class="home-title-row">
          <h1 class="home-title"><%= sectionTitle %></h1>
          <% if (request.auth) { %>
          <span class="home-count"><%= itemCards.length %></span>
          <% } %>
        </div>
      </div>

      <div
        class="menu-wrap"
        x-data="{ menuOpen: false }"
        x-on:click.outside="menuOpen = false"
        x-on:keydown.escape.window="menuOpen = false">
        <button
          class="icon-button"
          type="button"
          aria-label="메뉴 열기"
          x-on:click="menuOpen = !menuOpen"
          x-bind:aria-expanded="menuOpen.toString()">
          <svg
            class="icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <div
          class="menu-popover"
          x-cloak
          x-show="menuOpen"
          x-transition.origin.top.right>
          <% if (request.auth) { %>
          <a
            class="menu-link"
            href="/settings">
            설정
          </a>
          <form
            method="post"
            action="/xapi/auth/sign-out">
            <button
              class="menu-link menu-button"
              type="submit">
              로그아웃
            </button>
          </form>
          <% } else { %>
          <a
            class="menu-link"
            href="/sign-in">
            로그인
          </a>
          <a
            class="menu-link"
            href="/sign-up">
            회원가입
          </a>
          <% } %>
        </div>
      </div>
    </header>

    <% if (showFlash) { %>
    <%- include('flash-alert.ejs', { flashMessage: params.__flash }) %>
    <% } %>

    <% if (!request.auth) { %>
    <section class="signed-out-panel">
      <p>목록을 보려면 로그인해 주세요.</p>
      <a
        class="primary-link"
        href="/sign-in">
        로그인
      </a>
    </section>
    <% } else { %>
    <section class="capture-card">
      <form
        id="home-item-form-<%= filters.section %>"
        class="item-form"
        method="post"
        action="/xapi/items/create"
        hx-post="/xapi/items/create"
        hx-target="#home-items-<%= filters.section %>"
        hx-swap="outerHTML"
        x-data="{}"
        x-ref="form"
        x-on:home-item-created.window="if ($event.detail.section === '<%= filters.section %>') { const location = $refs.form.querySelector('input[name=channel]:checked')?.value; $refs.form.reset(); if ('<%= filters.section %>' === 'storage' && location) { const option = $refs.form.querySelector('input[name=channel][value=' + location + ']'); if (option) option.checked = true; } $refs.title.focus() }">
        <input
          type="hidden"
          name="section"
          value="<%= filters.section %>" />
        <input
          type="hidden"
          name="returnSection"
          value="<%= filters.section %>" />
        <input
          type="hidden"
          name="returnKeyword"
          value="<%= filters.keyword %>" />
        <input
          type="hidden"
          name="returnStatus"
          value="<%= filters.status %>" />
        <input
          type="hidden"
          name="returnTag"
          value="<%= filters.tag %>" />
        <div class="capture-row">
          <label class="capture-label">
            <span class="visually-hidden">항목 이름</span>
            <input
              class="capture-input"
              type="text"
              name="title"
              x-ref="title"
              maxlength="200"
              required
              autocomplete="off"
              placeholder="<%= filters.section === 'grocery' ? '무엇을 장볼까요?' : filters.section === 'purchase' ? '무엇을 구매할까요?' : filters.section === 'storage' ? '무엇을 보관할까요?' : '무엇을 할까요?' %>" />
          </label>
          <button
            class="add-button"
            type="submit"
            aria-label="추가">
            <svg
              class="icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
          </button>
        </div>
        <% if (filters.section === 'storage') { %>
        <fieldset class="choice-field storage-position-field">
          <legend class="field-caption">보관 위치 <span class="muted">(필수)</span></legend>
          <div class="choice-options storage-location-options">
            <label class="choice-option">
              <input
                class="choice-input storage-choice-input visually-hidden"
                type="radio"
                name="channel"
                value="fridge"
                required />
              <span class="choice-button">냉장</span>
            </label>
            <label class="choice-option">
              <input
                class="choice-input storage-choice-input visually-hidden"
                type="radio"
                name="channel"
                value="freezer"
                required />
              <span class="choice-button">냉동</span>
            </label>
          </div>
        </fieldset>
        <% } %>
        <% if (filters.section === 'task') { %>
        <details
          class="optional-details"
          x-data="{ frequency: 'none' }"
          x-on:home-item-created.window="if ($event.detail.section === '<%= filters.section %>') frequency = 'none'">
          <summary class="optional-summary">
            <svg
              class="chevron-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
            반복 설정
            <span class="muted">(선택)</span>
          </summary>
          <div class="optional-panel">
            <fieldset class="choice-field">
              <legend class="field-caption">반복 주기</legend>
              <div class="choice-options">
                <label class="choice-option">
                  <input
                    class="choice-input visually-hidden"
                    type="radio"
                    name="repeatFrequency"
                    value="none"
                    x-model="frequency"
                    checked />
                  <span class="choice-button">안 함</span>
                </label>
                <label class="choice-option">
                  <input
                    class="choice-input visually-hidden"
                    type="radio"
                    name="repeatFrequency"
                    value="weekly"
                    x-model="frequency" />
                  <span class="choice-button">매주</span>
                </label>
                <label class="choice-option">
                  <input
                    class="choice-input visually-hidden"
                    type="radio"
                    name="repeatFrequency"
                    value="monthly"
                    x-model="frequency" />
                  <span class="choice-button">매월</span>
                </label>
              </div>
            </fieldset>
            <label class="field-label">
              첫 예정일
              <input
                class="field-control"
                type="date"
                name="nextDueDate" />
            </label>
            <div
              class="wide-field"
              x-show="frequency === 'weekly'"
              x-cloak>
              <p class="field-caption">요일</p>
              <div class="weekdays">
                <label class="weekday-option">
                  <input
                    type="checkbox"
                    name="repeatWeekdays"
                    value="mon" />
                  월
                </label>
                <label class="weekday-option">
                  <input
                    type="checkbox"
                    name="repeatWeekdays"
                    value="tue" />
                  화
                </label>
                <label class="weekday-option">
                  <input
                    type="checkbox"
                    name="repeatWeekdays"
                    value="wed" />
                  수
                </label>
                <label class="weekday-option">
                  <input
                    type="checkbox"
                    name="repeatWeekdays"
                    value="thu" />
                  목
                </label>
                <label class="weekday-option">
                  <input
                    type="checkbox"
                    name="repeatWeekdays"
                    value="fri" />
                  금
                </label>
                <label class="weekday-option">
                  <input
                    type="checkbox"
                    name="repeatWeekdays"
                    value="sat" />
                  토
                </label>
                <label class="weekday-option">
                  <input
                    type="checkbox"
                    name="repeatWeekdays"
                    value="sun" />
                  일
                </label>
              </div>
              <fieldset class="choice-field compact-field">
                <legend class="field-caption">반복 간격</legend>
                <div class="choice-options">
                  <label class="choice-option">
                    <input
                      class="choice-input visually-hidden"
                      type="radio"
                      name="repeatWeeklyInterval"
                      value="1"
                      checked />
                    <span class="choice-button">매주</span>
                  </label>
                  <label class="choice-option">
                    <input
                      class="choice-input visually-hidden"
                      type="radio"
                      name="repeatWeeklyInterval"
                      value="2" />
                    <span class="choice-button">2주마다</span>
                  </label>
                </div>
              </fieldset>
            </div>
            <div
              class="wide-field"
              x-show="frequency === 'monthly'"
              x-cloak>
              <label class="field-label">
                매월 며칠
                <input
                  class="field-control"
                  type="number"
                  name="repeatDayOfMonth"
                  min="1"
                  max="31"
                  placeholder="예: 1일" />
              </label>
              <fieldset class="choice-field compact-field">
                <legend class="field-caption">반복 간격</legend>
                <div class="choice-options">
                  <label class="choice-option">
                    <input
                      class="choice-input visually-hidden"
                      type="radio"
                      name="repeatMonthlyInterval"
                      value="1"
                      checked />
                    <span class="choice-button">매월</span>
                  </label>
                  <label class="choice-option">
                    <input
                      class="choice-input visually-hidden"
                      type="radio"
                      name="repeatMonthlyInterval"
                      value="2" />
                    <span class="choice-button">2개월마다</span>
                  </label>
                </div>
              </fieldset>
            </div>
            <label class="field-label wide-field">
              메모 (선택)
              <input
                class="field-control"
                type="text"
                name="note"
                maxlength="2000" />
            </label>
          </div>
        </details>
        <% } else if (filters.section === 'storage') { %>
        <details class="optional-details">
          <summary class="optional-summary">
            <svg
              class="chevron-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
            보관 메모
            <span class="muted">(선택)</span>
          </summary>
          <div class="optional-panel">
            <label class="field-label">
              보관 정보
              <input
                class="field-control"
                type="text"
                name="note"
                maxlength="2000"
                placeholder="예: 냉동 · 2봉 · 10/12까지" />
            </label>
          </div>
        </details>
        <% } else { %>
        <details class="optional-details">
          <summary class="optional-summary">
            <svg
              class="chevron-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
            태그와 메모
            <span class="muted">(선택)</span>
          </summary>
          <div class="optional-panel">
            <fieldset class="choice-field">
              <legend class="field-caption">구매 태그</legend>
              <div class="choice-options">
                <label class="choice-option">
                  <input
                    class="choice-input visually-hidden"
                    type="radio"
                    name="channel"
                    value=""
                    checked />
                  <span class="choice-button">없음</span>
                </label>
                <label class="choice-option">
                  <input
                    class="choice-input channel-choice-input visually-hidden"
                    type="radio"
                    name="channel"
                    value="offline" />
                  <span class="choice-button">오프라인</span>
                </label>
                <label class="choice-option">
                  <input
                    class="choice-input channel-choice-input visually-hidden"
                    type="radio"
                    name="channel"
                    value="online" />
                  <span class="choice-button">온라인</span>
                </label>
              </div>
            </fieldset>
            <label class="field-label">
              메모 (선택)
              <input
                class="field-control"
                type="text"
                name="note"
                maxlength="2000" />
            </label>
          </div>
        </details>
        <% } %>
      </form>
    </section>
    <% } %>

  <% if (request.auth) { %>
    <section class="filter-section">
      <form
        id="home-filter-form-<%= filters.section %>" data-home-filter-form
        method="get"
        action="/"
        hx-get="/xapi/items/list"
        hx-target="#home-items-<%= filters.section %>"
        hx-swap="outerHTML"
        hx-trigger="submit, change">
        <input
          type="hidden"
          name="section"
          value="<%= filters.section %>" />
        <div class="filter-row">
          <label class="filter-pill">
            <span class="visually-hidden">상태</span>
            <select
              class="filter-select"
              name="status">
              <option
                value="open"
                <%= filters.status === 'open' ? 'selected' : '' %>>
                상태 · <%= filters.section === 'storage' ? '보관 중' : '할 일' %>
              </option>
              <option
                value="done"
                <%= filters.status === 'done' ? 'selected' : '' %>>
                상태 · <%= filters.section === 'storage' ? '소비 완료' : '완료됨' %>
              </option>
            </select>
            <svg
              class="filter-chevron"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true">
              <path d="m7 10 5 5 5-5"></path>
            </svg>
          </label>
          <% if (filters.section === 'storage') { %>
          <label class="filter-pill">
            <span class="visually-hidden">보관 위치 태그</span>
            <select
              class="filter-select"
              name="tag">
              <option value="">위치 · 전체</option>
              <option value="fridge" <%= filters.tag === 'fridge' ? 'selected' : '' %>>위치 · 냉장</option>
              <option value="freezer" <%= filters.tag === 'freezer' ? 'selected' : '' %>>위치 · 냉동</option>
              <option value="untagged" <%= filters.tag === 'untagged' ? 'selected' : '' %>>위치 · 미지정</option>
            </select>
            <svg
              class="filter-chevron"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true">
              <path d="m7 10 5 5 5-5"></path>
            </svg>
          </label>
          <% } else { %>
          <label class="filter-pill">
            <span class="visually-hidden">태그</span>
            <select
              class="filter-select"
              name="tag">
              <option value="">태그 · 전체</option>
              <% if (filters.section === 'task') { %>
              <option
                value="none"
                <%= filters.tag === 'none' ? 'selected' : '' %>>
                태그 · 반복 없음
              </option>
              <option
                value="weekly"
                <%= filters.tag === 'weekly' ? 'selected' : '' %>>
                태그 · 매주
              </option>
              <option
                value="monthly"
                <%= filters.tag === 'monthly' ? 'selected' : '' %>>
                태그 · 매월
              </option>
              <% } else { %>
              <option
                value="offline"
                <%= filters.tag === 'offline' ? 'selected' : '' %>>
                태그 · 오프라인
              </option>
              <option
                value="online"
                <%= filters.tag === 'online' ? 'selected' : '' %>>
                태그 · 온라인
              </option>
              <option
                value="untagged"
                <%= filters.tag === 'untagged' ? 'selected' : '' %>>
                태그 · 없음
              </option>
              <% } %>
            </select>
            <svg
              class="filter-chevron"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true">
              <path d="m7 10 5 5 5-5"></path>
            </svg>
          </label>
          <% } %>
        </div>
      </form>
    </section>

    <%- include('home-items-list.ejs', { itemCards, filters, listMessage: '' }) %>
    <% } %>
  </div>
