<script server>
  const coupleData = resolve('couple-data')
  const currentYear = String(new Date().getFullYear())
  const previousYear = String(Number(currentYear) - 1)
  const photos = coupleData.listPhotos($app, 'all')

  meta('title', '추억 | 둘콩')
  meta('description', '우리 둘의 사진과 추억')
</script>

<div
  class="mx-auto min-h-[100dvh] w-full max-w-[480px] bg-[#fbfaf6] text-[#292923] shadow-[0_0_60px_rgba(70,76,53,0.08)]"
  data-signals="<%= stringify({
    photoModalOpen: false,
    photoModalMode: 'create',
    photoEditId: '',
    photoEditIsChatBackground: false,
    photoCaption: '',
    photoTakenAt: '',
    photoLocationName: '',
    photoFilter: 'all',
    photoCount: photos.length,
    photoSelectionMode: false,
    selectedPhotoIds: [],
    selectedPhotoCount: 0,
    photoViewerOpen: false,
    photoViewerUrl: '',
    photoViewerCaption: '',
    photoViewerMeta: '',
  }) %>">
  <div class="px-5 pt-[max(1.25rem,env(safe-area-inset-top))] pb-30">
    <header class="flex items-center gap-3 py-2">
      <div class="shrink-0">
        <p class="m-0 text-xs font-bold tracking-[0.1em] text-[#98a081]">우리의 기록</p>
        <h1 class="mt-1 mb-0 text-[28px] font-extrabold tracking-[-0.045em]">추억</h1>
      </div>
      <section
        class="inline-flex flex-col rounded-[15px] border border-[#dce7c8] bg-[#edf3df] px-3.5 py-2 text-[#354922]"
        aria-labelledby="memory-summary-title">
        <span
          class="text-[10px] font-medium text-[#7f8c68]"
          data-text="$photoSelectionMode ? '선택한 사진' : '함께 모은 순간'">
          함께 모은 순간
        </span>
        <strong
          id="memory-summary-title"
          class="mt-0.5 text-sm font-bold"
          data-text="$photoSelectionMode ? $selectedPhotoCount + '장 선택' : $photoCount + '장'">
          <%= photos.length %>장
        </strong>
      </section>
      <button
        type="button"
        data-show="!$photoSelectionMode"
        data-on:click="
          $photoModalMode = 'create'
          $photoEditId = ''
          $photoEditIsChatBackground = false
          $photoCaption = ''
          $photoTakenAt = ''
          $photoLocationName = ''
          if (window.dulkongPhotoPond) window.dulkongPhotoPond.removeFiles()
          $photoModalOpen = true
        "
        class="ml-auto flex h-11 w-11 shrink-0 items-center justify-center rounded-[16px] border-0 bg-[#dcebbf] text-[#4e672f] shadow-[0_6px_18px_rgba(92,112,57,0.15)]"
        aria-label="사진 추가">
        <span
          class="i-lucide-plus h-5 w-5"
          aria-hidden="true"></span>
      </button>
    </header>

    <main class="mt-4">
      <div class="mb-5 flex items-center gap-2">
        <div
          data-show="!$photoSelectionMode"
          class="memory-filter-scroll flex min-w-0 flex-1 gap-2 overflow-x-auto pb-1"
          aria-label="추억 기간 필터">
          <% [{ value: 'all', label: '전체' }, { value: currentYear, label: currentYear + '년' }, { value: previousYear, label: previousYear + '년' }, { value: 'favorite', label: '즐겨찾기' }].forEach(function (filter) { %>
          <button
            type="button"
            data-on:click="
              $photoFilter = '<%= filter.value %>'
              @get('/xapi/photos/list')
            "
            data-class="
              {
                'bg-[#354922] text-white': $photoFilter === '<%= filter.value %>',
                'bg-[#efede5] text-[#77766d]': $photoFilter !== '<%= filter.value %>',
              }
            "
            class="shrink-0 rounded-full border-0 px-3 py-2 text-sm font-bold">
            <%= filter.label %>
          </button>
          <% }) %>
        </div>
        <button
          type="button"
          data-on:click="if ($photoSelectionMode) window.dulkongExitPhotoSelection(); else window.dulkongEnterPhotoSelection()"
          data-class="{
            'bg-transparent text-[#77766d]': !$photoSelectionMode,
            'bg-[#354922] text-white': $photoSelectionMode,
          }"
          class="ml-auto flex h-9 w-9 shrink-0 items-center justify-center rounded-[14px] border-0"
          data-attr:aria-label="$photoSelectionMode ? '사진 선택 취소' : '사진 선택'">
          <span
            data-class="{ 'i-lucide-square-check-big': !$photoSelectionMode, 'i-lucide-x': $photoSelectionMode }"
            class="h-4 w-4"
            aria-hidden="true"></span>
        </button>
      </div>
      <%- include('photo-grid.ejs', { photos }) %>
    </main>
  </div>

  <div
    data-show="$photoModalOpen"
    class="fixed inset-0 z-60 flex items-end justify-center bg-black/35 px-3"
    data-on:click="$photoModalOpen = false">
    <section
      class="mb-[max(0.75rem,env(safe-area-inset-bottom))] box-border max-h-[calc(100dvh-1.5rem)] w-full max-w-[456px] overflow-y-auto rounded-[28px] bg-[#fffefa] p-5 shadow-[0_24px_70px_rgba(30,31,27,0.28)]"
      data-on:click__stop="true">
      <div class="mb-4 flex items-center justify-between">
        <div>
          <p
            class="m-0 text-xs font-bold text-[#98a081]"
            data-text="$photoModalMode === 'edit' ? '추억 다듬기' : '새 추억'">
            새 추억
          </p>
          <h2
            class="mt-1 mb-0 text-xl font-bold"
            data-text="$photoModalMode === 'edit' ? '사진 정보 수정' : '사진 올리기'">
            사진 올리기
          </h2>
        </div>
        <button
          type="button"
          data-on:click="$photoModalOpen = false"
          class="flex h-9 w-9 items-center justify-center rounded-full border-0 bg-[#f0eee7]"
          aria-label="닫기">
          <span class="i-lucide-x h-4 w-4"></span>
        </button>
      </div>
      <form
        id="photo-upload-form"
        method="post"
        action="/xapi/photos/upload"
        enctype="multipart/form-data"
        data-on:submit__prevent="
          if ($photoModalMode === 'edit') @post('/xapi/photos/update')
          else @post('/xapi/photos/upload', { contentType: 'form' })
        "
        class="space-y-3">
        <div data-show="$photoModalMode === 'create'">
          <input
            id="photo-image"
            class="filepond"
            type="file"
            name="image"
            accept="image/jpeg,image/png,image/webp,image/heic,image/heif"
            multiple
            data-attr:required="$photoModalMode === 'create'"
            required />
          <button
            id="photo-add-more"
            type="button"
            hidden
            class="mb-4 h-10 w-full rounded-[16px] border border-[#dce7c8] bg-[#edf3df] text-sm font-bold text-[#4e672f]">
            사진 더 추가
          </button>
        </div>
        <input
          data-bind:photo-caption
          type="text"
          name="caption"
          maxlength="1000"
          placeholder="이 순간의 한마디"
          class="box-border w-full rounded-[18px] border border-[#e4e1d6] bg-[#f7f5ef] px-4 py-3 text-sm outline-none focus:border-[#9fbd6f]" />
        <div class="grid grid-cols-2 gap-2">
          <input
            data-bind:photo-taken-at
            type="date"
            name="takenAt"
            class="box-border min-w-0 rounded-[18px] border border-[#e4e1d6] bg-[#f7f5ef] px-3 py-3 text-sm outline-none" />
          <input
            data-bind:photo-location-name
            type="text"
            name="locationName"
            maxlength="120"
            placeholder="장소(선택)"
            class="box-border min-w-0 rounded-[18px] border border-[#e4e1d6] bg-[#f7f5ef] px-3 py-3 text-sm outline-none" />
        </div>
        <button
          type="submit"
          class="h-12 w-full rounded-[18px] border-0 bg-[#354922] text-sm font-bold text-white"
          data-text="$photoModalMode === 'edit' ? '사진 정보 수정' : '추억으로 저장'">
          추억으로 저장
        </button>
      </form>
      <form
        data-show="$photoModalMode === 'edit'"
        data-on:submit__prevent="@post('/xapi/photos/chat-background')"
        class="mt-3">
        <button
          type="submit"
          data-attr:disabled="$photoEditIsChatBackground"
          data-text="$photoEditIsChatBackground ? '채팅방 배경으로 사용 중' : '채팅방 배경으로 설정'"
          class="h-12 w-full rounded-[18px] border border-[#dce7c8] bg-[#edf3df] text-sm font-bold text-[#4e672f] disabled:opacity-60">
          채팅방 배경으로 설정
        </button>
      </form>
      <form
        data-show="$photoModalMode === 'edit'"
        data-on:submit__prevent="if (confirm('이 사진을 삭제할까요?')) @post('/xapi/photos/delete')"
        class="mt-3">
        <button
          type="submit"
          class="h-12 w-full rounded-[18px] border border-[#ead8d4] bg-[#fff4f1] text-sm font-bold text-[#b24b3f]">
          사진 삭제
        </button>
      </form>
    </section>
  </div>

  <div
    data-show="$photoViewerOpen"
    class="fixed inset-0 z-80 flex items-center justify-center bg-[#181914]/94 px-4 pt-[max(1rem,env(safe-area-inset-top))] pb-[max(1rem,env(safe-area-inset-bottom))] backdrop-blur-sm"
    data-on:click="$photoViewerOpen = false">
    <button
      type="button"
      data-on:click__stop="$photoViewerOpen = false"
      class="absolute z-10 flex h-11 w-11 items-center justify-center rounded-full border-0 bg-white/12 text-white backdrop-blur-md"
      style="top: max(1rem, env(safe-area-inset-top)); right: max(1rem, env(safe-area-inset-right))"
      aria-label="사진 닫기">
      <span
        class="i-lucide-x h-5 w-5"
        aria-hidden="true"></span>
    </button>
    <section
      class="relative flex max-h-full w-full max-w-[720px] flex-col items-center justify-center"
      data-on:click__stop="true"
      aria-label="확대된 추억 사진">
      <img
        data-attr:src="$photoViewerUrl"
        data-attr:alt="$photoViewerCaption"
        class="max-h-[calc(100dvh-10rem)] max-w-full rounded-[24px] object-contain shadow-[0_24px_80px_rgba(0,0,0,0.38)]" />
      <div class="mt-4 w-full max-w-[560px] text-center text-white">
        <p
          class="m-0 text-base font-bold"
          data-text="$photoViewerCaption"></p>
        <p
          class="mt-1 mb-0 text-xs font-medium text-white/55"
          data-text="$photoViewerMeta"></p>
      </div>
    </section>
  </div>

  <div
    data-show="!$photoSelectionMode">
    <%- include('app-bottom-nav.ejs', { currentPath: '/memories' }) %>
  </div>
  <div
    data-show="$photoSelectionMode"
    class="fixed right-0 bottom-0 left-0 z-70 mx-auto box-border w-full max-w-[480px] border-t border-[#ead8d4] bg-[#fffefa]/96 px-5 pt-3 shadow-[0_-10px_30px_rgba(47,48,42,0.1)] backdrop-blur-md"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))">
    <button
      type="button"
      data-attr:disabled="$selectedPhotoCount === 0"
      data-text="$selectedPhotoCount > 0 ? '선택한 ' + $selectedPhotoCount + '장 삭제' : '삭제할 사진을 선택해 주세요'"
      data-on:click="
        if ($selectedPhotoCount > 0 && confirm('선택한 사진 ' + $selectedPhotoCount + '장을 삭제할까요?')) {
          @post('/xapi/photos/delete', {
            payload: { selectedPhotoIds: $selectedPhotoIds, photoFilter: $photoFilter },
          })
        }
      "
      class="h-12 w-full rounded-[18px] border-0 bg-[#c95c50] text-sm font-bold text-white disabled:bg-[#e7dfdc] disabled:text-[#a99e99]">
      삭제할 사진을 선택해 주세요
    </button>
  </div>
</div>

<script src="<%= asset('/assets/image-resize.js') %>"></script>
<script>
  ;(function () {
    function clearPhotoPress(button) {
      if (!button) return
      if (button.dulkongPressTimer) {
        clearTimeout(button.dulkongPressTimer)
        button.dulkongPressTimer = null
      }

      var card = button.closest('.photo-card')
      if (card) card.classList.remove('photo-card--pressing')
    }

    function patchPhotoSelection() {
      if (!window.patchSignals) return
      window.patchSignals({
        photoSelectionMode: window.dulkongPhotoSelectionMode,
        selectedPhotoIds: window.dulkongSelectedPhotoIds.slice(),
        selectedPhotoCount: window.dulkongSelectedPhotoIds.length,
      })
    }

    window.dulkongPhotoSelectionMode = false
    window.dulkongSelectedPhotoIds = []

    window.dulkongEnterPhotoSelection = function () {
      window.dulkongPhotoSelectionMode = true
      window.dulkongSelectedPhotoIds = []
      patchPhotoSelection()
    }

    window.dulkongExitPhotoSelection = function () {
      window.dulkongPhotoSelectionMode = false
      window.dulkongSelectedPhotoIds = []
      patchPhotoSelection()
    }

    window.dulkongTogglePhotoSelection = function (button) {
      var photoId = button ? String(button.dataset.photoId || '') : ''
      if (!photoId) return

      var selectedIndex = window.dulkongSelectedPhotoIds.indexOf(photoId)
      if (selectedIndex >= 0) window.dulkongSelectedPhotoIds.splice(selectedIndex, 1)
      else window.dulkongSelectedPhotoIds.push(photoId)
      patchPhotoSelection()
    }

    window.dulkongStartPhotoPress = function (event) {
      if (window.dulkongPhotoSelectionMode) return
      if (event.pointerType === 'mouse' && event.button !== 0) return

      var button = event.currentTarget
      clearPhotoPress(button)
      button.dulkongPressStartX = event.clientX
      button.dulkongPressStartY = event.clientY

      var card = button.closest('.photo-card')
      if (card) card.classList.add('photo-card--pressing')

      button.dulkongPressTimer = setTimeout(function () {
        button.dulkongPressTimer = null
        button.dulkongSuppressClick = true
        clearPhotoPress(button)

        if (navigator.vibrate) navigator.vibrate(20)
        if (window.patchSignals) {
          window.patchSignals({
            photoModalMode: 'edit',
            photoEditId: button.dataset.photoId || '',
            photoEditIsChatBackground: button.dataset.photoChatBackground === 'true',
            photoCaption: button.dataset.photoCaption || '',
            photoTakenAt: button.dataset.photoTakenAt || '',
            photoLocationName: button.dataset.photoLocationName || '',
            photoModalOpen: true,
          })
        }

        clearTimeout(button.dulkongSuppressTimer)
        button.dulkongSuppressTimer = setTimeout(function () {
          button.dulkongSuppressClick = false
        }, 800)
      }, 1000)
    }

    window.dulkongMovePhotoPress = function (event) {
      var button = event.currentTarget
      var movedX = Math.abs(event.clientX - Number(button.dulkongPressStartX || 0))
      var movedY = Math.abs(event.clientY - Number(button.dulkongPressStartY || 0))

      if (movedX > 10 || movedY > 10) clearPhotoPress(button)
    }

    window.dulkongEndPhotoPress = function (event) {
      clearPhotoPress(event.currentTarget)
    }

    window.dulkongCancelPhotoPress = function (event) {
      clearPhotoPress(event.currentTarget)
    }

    window.dulkongOpenPhoto = function (event) {
      var button = event.currentTarget

      if (window.dulkongPhotoSelectionMode) {
        window.dulkongTogglePhotoSelection(button)
        return
      }

      if (button.dulkongSuppressClick) {
        button.dulkongSuppressClick = false
        event.preventDefault()
        event.stopPropagation()
        return
      }

      if (!window.patchSignals) return
      window.patchSignals({
        photoViewerUrl: button.dataset.photoViewerUrl || '',
        photoViewerCaption: button.dataset.photoCaption || '',
        photoViewerMeta: button.dataset.photoViewerMeta || '',
        photoViewerOpen: true,
      })
    }

    var input = document.getElementById('photo-image')
    if (!input || !window.FilePond || window.FilePond.find(input)) return
    var uploadField = input.parentElement

    if (!window.dulkongFilePondReady) {
      window.FilePond.registerPlugin(window.FilePondPluginImagePreview)
      window.dulkongFilePondReady = true
    }

    window.dulkongPhotoPond = window.FilePond.create(input, {
      storeAsFile: true,
      allowMultiple: true,
      maxFiles: 10,
      allowProcess: false,
      credits: false,
      imagePreviewHeight: 180,
      labelIdle:
        '<span class="filepond-label"><span class="i-lucide-image-plus filepond-label-icon"></span><strong>사진 선택</strong><small>최대 10장까지 고르거나 이곳에 놓아주세요</small></span>',
      labelFileWaitingForSize: '사진 확인 중',
      labelFileLoading: '사진 불러오는 중',
      labelFileLoadError: '사진을 불러오지 못했어요',
      labelFileRemoveError: '사진을 제거하지 못했어요',
      labelButtonRemoveItem: '사진 제거',
      labelTapToCancel: '눌러서 취소',
      labelTapToRetry: '눌러서 다시 시도',
      labelTapToUndo: '눌러서 되돌리기',
    })

    var addMoreButton = document.getElementById('photo-add-more')
    function syncPhotoUploadControls(items) {
      var fileCount = items.length
      var maxFiles = 10
      window.dulkongPhotoPond.element.classList.toggle('dulkong-filepond--has-files', fileCount > 0)
      if (!addMoreButton) return

      addMoreButton.hidden = fileCount === 0 || fileCount >= maxFiles
      addMoreButton.textContent = '사진 더 추가 · ' + fileCount + '/' + maxFiles
    }

    window.dulkongPhotoPond.on('updatefiles', syncPhotoUploadControls)
    syncPhotoUploadControls(window.dulkongPhotoPond.getFiles())
    if (addMoreButton) {
      addMoreButton.addEventListener('click', function () {
        window.dulkongPhotoPond.browse()
      })
    }

    var form = document.getElementById('photo-upload-form')
    if (!form || form.dulkongResizeInstalled) return
    form.dulkongResizeInstalled = true

    form.addEventListener(
      'submit',
      function (event) {
        var uploadFieldHidden =
          uploadField && (uploadField.hidden || window.getComputedStyle(uploadField).display === 'none')
        if (form.dulkongResizeBypass || uploadFieldHidden || typeof window.dulkongResizeImageFile !== 'function') {
          return
        }

        var items = window.dulkongPhotoPond.getFiles().filter(function (item) {
          return item.file instanceof File
        })
        if (!items.length) return

        event.preventDefault()
        event.stopImmediatePropagation()
        if (form.dulkongResizePending) return
        form.dulkongResizePending = true

        var submitter = event.submitter
        var submitButton = submitter || form.querySelector('button[type="submit"]')
        var originalButtonText = submitButton ? submitButton.textContent : ''
        if (submitButton) {
          submitButton.disabled = true
          submitButton.textContent = '사진 줄이는 중...'
        }

        Promise.all(
          items.map(function (item) {
            return window
              .dulkongResizeImageFile(item.file, { maxEdge: 1920, quality: 0.82 })
              .catch(function (resizeError) {
                console.warn('Dulkong photo upload uses the original image', resizeError)
                return item.file
              })
          })
        )
          .then(function (resizedFiles) {
            var storedInputs = form.querySelectorAll('input[type="file"][name="image"]')
            if (storedInputs.length !== resizedFiles.length) {
              throw new Error('업로드할 사진 필드를 찾지 못했습니다.')
            }

            resizedFiles.forEach(function (resizedFile, index) {
              var transfer = new DataTransfer()
              transfer.items.add(resizedFile)
              storedInputs[index].files = transfer.files
            })
          })
          .catch(function (resizeError) {
            console.warn('Dulkong photo upload uses the selected images', resizeError)
          })
          .then(function () {
            form.dulkongResizeBypass = true
            form.dulkongResizePending = false
            if (submitButton) {
              submitButton.disabled = false
              submitButton.textContent = originalButtonText
            }

            if (submitter) form.requestSubmit(submitter)
            else form.requestSubmit()
            form.dulkongResizeBypass = false
          })
      },
      true
    )
  })()
</script>
