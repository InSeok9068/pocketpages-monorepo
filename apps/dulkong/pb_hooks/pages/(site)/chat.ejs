<script server>
  const coupleData = resolve('couple-data')
  const profiles = coupleData.getCoupleProfiles($app, request.auth)
  const messagePage = coupleData.getMessagePage($app, profiles.current.id, {
    limit: 50,
    partnerLastReadAt: profiles.partner.lastReadAt,
  })
  const messages = messagePage.messages
  const oldestMessage = messages.length ? messages[0] : null
  const newestMessage = messages.length ? messages[messages.length - 1] : null
  const backgroundPhoto = coupleData.getChatBackgroundPhoto($app)

  meta('title', '대화 | 둘콩')
  meta('description', '우리 둘만의 실시간 대화')
</script>

<div
  id="chat-page"
  class="fixed inset-0 mx-auto flex w-full max-w-[480px] flex-col overflow-hidden bg-[#f7f5ee] text-[#292923] shadow-[0_0_60px_rgba(70,76,53,0.08)]"
  data-signals="<%= stringify({
    draft: '',
    clientMessageId: '',
    chatHandledRevision: 0,
    chatReceiptRevision: 0,
    chatHandledReceiptRevision: 0,
    chatReceiptUpdating: false,
    chatPartnerReadAt: profiles.partner.lastReadAt,
    chatReadAt: '',
    chatSending: false,
    chatUpdating: false,
    chatStickToBottom: false,
    chatAtBottom: true,
    chatHasNewMessage: false,
    messageHasMore: messagePage.hasMore,
    messageHistoryLoading: false,
    oldestMessageCreated: oldestMessage ? oldestMessage.createdAt : '',
    oldestMessageId: oldestMessage ? oldestMessage.id : '',
    newestMessageCreated: newestMessage ? newestMessage.createdAt : '',
    newestMessageId: newestMessage ? newestMessage.id : '',
  }) %>"
  data-init="@post('/xapi/messages/read')"
  data-effect="
    if ($chatRevision && $chatRevision !== $chatHandledRevision) {
      if (!$chatUpdating) {
        $chatHandledRevision = $chatRevision
        $chatUpdating = true
        $chatStickToBottom = $chatAtBottom && document.visibilityState === 'visible'
        if (!$chatStickToBottom) $chatHasNewMessage = true
        @get('/xapi/messages/updates')
        if ($chatStickToBottom) @post('/xapi/messages/read')
      }
    }
    if ($chatReceiptRevision && $chatReceiptRevision !== $chatHandledReceiptRevision) {
      if (!$chatReceiptUpdating) {
        $chatHandledReceiptRevision = $chatReceiptRevision
        $chatReceiptUpdating = true
        @get('/xapi/messages/receipt')
      }
    }
  "
  data-on:focus__window="
    if (document.visibilityState === 'visible' && !$chatUpdating) {
      $chatUpdating = true
      $chatStickToBottom = $chatAtBottom
      @get('/xapi/messages/updates')
      if ($chatStickToBottom) @post('/xapi/messages/read')
    }
  ">
  <% if (backgroundPhoto) { %>
  <img
    src="<%= backgroundPhoto.imageUrl %>"
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-40"
    aria-hidden="true" />
  <div
    class="pointer-events-none absolute inset-0 bg-[#f7f5ee]/40"
    aria-hidden="true"></div>
  <% } %>
  <header
    class="relative z-10 shrink-0 border-b border-[#e8e5da] bg-[#fbfaf6]/92 px-5 pt-[max(1rem,env(safe-area-inset-top))] pb-3 backdrop-blur-md">
    <div class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <span
          class="<%= profiles.partner.colorClass %> relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-lg"
          aria-hidden="true">
          <%= profiles.partner.emoji %>
        </span>
        <div class="min-w-0">
          <h1 class="m-0 truncate text-[17px] font-bold"><%= profiles.partner.name %></h1>
          <p class="mt-0.5 mb-0 flex items-center gap-1.5 text-xs font-medium text-[#779550]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#82ae4d]"></span>
            둘콩으로 연결됨
          </p>
        </div>
      </div>
      <button
        type="button"
        data-on:click="
          $chatAtBottom = true
          $chatHasNewMessage = false
          @get('/xapi/messages/list')
          @post('/xapi/messages/read')
        "
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-0 bg-transparent text-[#89917d] opacity-65 active:bg-[#efeee8] active:opacity-100"
        aria-label="대화 다시 불러오기"
        title="대화 다시 불러오기">
        <span
          class="i-lucide-refresh-cw h-4 w-4"
          aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <%- include('message-list.ejs', { messages, partnerName: profiles.partner.name, positionOnLoad: true }) %>

  <button
    type="button"
    data-show="$chatHasNewMessage"
    data-on:click="
      $chatHasNewMessage = false
      $chatAtBottom = true
      $chatStickToBottom = true
      window.dulkongChatForceBottom = true
      window.dulkongScrollChatToBottom()
      if (!$chatUpdating) {
        $chatUpdating = true
        @get('/xapi/messages/updates')
      }
      @post('/xapi/messages/read')
    "
    class="chat-new-message-button z-10 flex items-center gap-1.5 rounded-full border-0 bg-[#354922] px-4 py-2.5 text-xs font-bold text-white shadow-[0_10px_28px_rgba(53,73,34,0.24)]">
    새 메시지
    <span aria-hidden="true">↓</span>
  </button>

  <form
    method="post"
    action="/xapi/messages/send"
    data-on:submit__prevent="
      if (!$chatSending) {
        $chatSending = true
        $clientMessageId = 'web_' + Date.now()
        @post('/xapi/messages/send')
      }
    "
    class="relative z-10 shrink-0 border-t border-[#e8e5da] bg-[#fffefa] px-4 py-3">
    <div class="flex items-end gap-2">
      <label class="block min-w-0 flex-1">
        <span class="sr-only">메시지</span>
        <textarea
          id="chat-draft"
          data-bind:draft
          rows="1"
          maxlength="5000"
          class="box-border block h-12 max-h-28 min-h-12 w-full resize-none rounded-[24px] border border-[#e4e1d6] bg-[#f7f5ef] px-4 py-3 text-sm outline-none focus:border-[#9fbd6f]"
          placeholder="메시지를 입력하세요"></textarea>
      </label>
      <button
        type="submit"
        data-attr:disabled="$chatSending || !$draft.trim()"
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-0 bg-[#354922] text-white disabled:opacity-35"
        aria-label="메시지 보내기">
        <span class="i-lucide-arrow-up h-5 w-5"></span>
      </button>
    </div>
  </form>

  <script>
    window.dulkongIsChatAtBottom = function () {
      var list = document.getElementById('message-list')
      return !list || list.scrollHeight - list.scrollTop - list.clientHeight < 48
    }

    window.dulkongScrollChatToBottom = function () {
      requestAnimationFrame(function () {
        var list = document.getElementById('message-list')
        if (!list) return
        list.scrollTop = list.scrollHeight
        list.classList.remove('message-list--positioning')
        list.dataset.ready = 'true'
      })
    }

    window.dulkongDeduplicateChatMessages = function () {
      var seenMessageIds = {}
      var rows = document.querySelectorAll('#message-rows > [id^="message-"]')

      Array.prototype.forEach.call(rows, function (row) {
        if (seenMessageIds[row.id]) seenMessageIds[row.id].remove()
        seenMessageIds[row.id] = row
      })
    }

    window.dulkongApplyChatReadReceipt = function (readAt) {
      var selectedReceipt = null
      var rows = document.querySelectorAll('#message-rows > [data-message-mine="true"]')

      Array.prototype.forEach.call(rows, function (row) {
        var receipt = row.querySelector('[data-chat-read-receipt]')
        if (!receipt) return
        receipt.hidden = true
        if (readAt && row.dataset.messageCreated <= readAt) selectedReceipt = receipt
      })

      if (selectedReceipt) selectedReceipt.hidden = false
    }

    window.dulkongFinishChatUpdate = function (stickToBottom) {
      window.dulkongDeduplicateChatMessages()
      if (stickToBottom || window.dulkongChatForceBottom) window.dulkongScrollChatToBottom()
      window.dulkongChatForceBottom = false
    }

    window.dulkongScrollChatToBottom()
    if (document.readyState !== 'complete')
      window.addEventListener('load', window.dulkongScrollChatToBottom, { once: true })
    setTimeout(window.dulkongScrollChatToBottom, 100)
  </script>
  <%- include('app-bottom-nav.ejs', { currentPath: '/chat' }) %>
</div>
