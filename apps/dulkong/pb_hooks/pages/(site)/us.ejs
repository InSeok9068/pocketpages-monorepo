<script server>
  const coupleData = resolve('couple-data')
  const profiles = coupleData.getCoupleProfiles($app, request.auth)
  const anniversaries = coupleData.listAnniversaries($app)
  const relationship =
    anniversaries.filter(function (item) {
      return item.kind === 'relationship_start'
    })[0] || null
  const pushConfigured = Boolean(String(env('DULKONG_ONESIGNAL_APPID') || '').trim())
  const pushEnabled = Boolean(request.auth.get('pushEnabled'))

  meta('title', '우리 | 둘콩')
  meta('description', '우리 둘의 정보와 기념일')
</script>

<div
  class="mx-auto min-h-[100dvh] w-full max-w-[480px] bg-[#fbfaf6] text-[#292923] shadow-[0_0_60px_rgba(70,76,53,0.08)]"
  data-signals="<%= stringify({
    anniversaryModalOpen: false,
    anniversaryModalMode: 'create',
    anniversaryId: '',
    anniversaryTitle: '',
    anniversaryDate: '',
    anniversaryKind: 'custom',
    anniversaryRecurrence: 'none',
    anniversaryRelatedUserId: '',
    anniversaryEmoji: '',
  }) %>">
  <div class="px-5 pt-[max(1.25rem,env(safe-area-inset-top))] pb-30">
    <header class="flex items-center justify-between py-2">
      <div>
        <p class="m-0 text-xs font-bold tracking-[0.1em] text-[#98a081]">둘콩 커플</p>
        <h1 class="mt-1 mb-0 text-[28px] font-extrabold tracking-[-0.045em]">우리</h1>
      </div>
    </header>
    <main class="mt-6 space-y-6">
      <section
        class="rounded-[28px] bg-[#dcebbf] p-5 text-center shadow-[0_16px_36px_rgba(92,112,57,0.13)]"
        aria-labelledby="couple-title">
        <div class="mx-auto flex w-fit items-center">
          <span
            class="<%= profiles.current.colorClass %> flex h-15 w-15 items-center justify-center rounded-full border-4 border-[#dcebbf] text-xl">
            <%= profiles.current.emoji %>
          </span>
          <span
            class="<%= profiles.partner.colorClass %> -ml-3 flex h-15 w-15 items-center justify-center rounded-full border-4 border-[#dcebbf] text-xl">
            <%= profiles.partner.emoji %>
          </span>
        </div>
        <h2
          id="couple-title"
          class="mt-3 mb-0 text-xl font-bold tracking-[-0.035em]">
          <%= profiles.current.name %>
          <span class="text-[#75964c]">♥</span>
          <%= profiles.partner.name %>
        </h2>
        <p class="mt-1 mb-0 text-sm font-medium text-[#66784c]">
          <%= relationship ? relationship.dateLabel + '부터 함께' : '우리의 첫날을 등록해 보세요' %>
        </p>
      </section>

      <section aria-labelledby="days-title">
        <div class="mb-3 flex items-center justify-between">
          <h2
            id="days-title"
            class="m-0 text-lg font-bold tracking-[-0.03em]">
            우리의 날
          </h2>
          <button
            type="button"
            data-on:click="
              $anniversaryModalMode = 'create'
              $anniversaryId = ''
              $anniversaryTitle = ''
              $anniversaryDate = ''
              $anniversaryKind = 'custom'
              $anniversaryRecurrence = 'none'
              $anniversaryRelatedUserId = ''
              $anniversaryEmoji = ''
              $anniversaryModalOpen = true
            "
            class="border-0 bg-transparent text-sm font-bold text-[#71834f]">
            +추가
          </button>
        </div>
        <%- include('anniversary-list.ejs', { anniversaries }) %>
      </section>

      <section
        class="flex items-center gap-3 rounded-[22px] bg-white p-4 shadow-[0_7px_20px_rgba(48,49,43,0.05)]"
        aria-labelledby="push-title">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#eef5df] text-[#607a3c]">
          <span
            class="i-lucide-bell h-5 w-5"
            aria-hidden="true"></span>
        </span>
        <div class="min-w-0 flex-1">
          <h2
            id="push-title"
            class="m-0 text-sm font-bold">
            채팅 알림
          </h2>
          <p
            id="push-status"
            class="mt-1 mb-0 text-xs leading-4.5 text-[#8b8a80]">
            <%= pushConfigured ? (pushEnabled ? '이 기기의 알림 상태를 확인하고 있어요.' : '새 메시지를 놓치지 않도록 알려드려요.') : 'OneSignal 환경 설정이 필요해요.' %>
          </p>
        </div>
        <button
          id="push-toggle"
          type="button"
          class="min-h-10 shrink-0 rounded-full border-0 bg-[#354922] px-4 text-xs font-bold text-white disabled:cursor-not-allowed disabled:opacity-45"
          <%= pushConfigured ? '' : 'disabled' %>>
          <%= pushEnabled ? '알림 끄기' : '알림 받기' %>
        </button>
      </section>

      <form
        method="post"
        action="/xapi/auth/sign-out"
        data-on:submit__prevent="@post('/xapi/auth/sign-out')">
        <button
          type="submit"
          class="flex w-full items-center justify-between rounded-[22px] border-0 bg-white px-4 py-4 text-left text-sm font-bold shadow-[0_7px_20px_rgba(48,49,43,0.05)]">
          <span class="flex items-center gap-3">
            <span class="i-lucide-log-out h-5 w-5 text-[#7c8e5d]"></span>
            <%= profiles.current.name %>님 로그아웃
          </span>
          <span class="i-lucide-chevron-right h-4 w-4 text-[#b3b2a8]"></span>
        </button>
      </form>
    </main>
  </div>

  <div
    data-show="$anniversaryModalOpen"
    class="fixed inset-0 z-60 flex items-end justify-center bg-black/35 px-3"
    data-on:click="$anniversaryModalOpen = false">
    <section
      class="mb-[max(0.75rem,env(safe-area-inset-bottom))] box-border w-full max-w-[456px] rounded-[28px] bg-[#fffefa] p-5 shadow-[0_24px_70px_rgba(30,31,27,0.28)]"
      data-on:click__stop="true">
      <div class="mb-4 flex items-center justify-between">
        <div>
          <p class="m-0 text-xs font-bold text-[#98a081]">우리의 날</p>
          <h2
            class="mt-1 mb-0 text-xl font-bold"
            data-text="$anniversaryModalMode === 'edit' ? '기념일 수정' : '기념일 추가'">
            기념일 추가
          </h2>
        </div>
        <button
          type="button"
          data-on:click="$anniversaryModalOpen = false"
          class="flex h-9 w-9 items-center justify-center rounded-full border-0 bg-[#f0eee7]"
          aria-label="닫기">
          <span class="i-lucide-x h-4 w-4"></span>
        </button>
      </div>
      <form
        method="post"
        action="/xapi/anniversaries/create"
        data-on:submit__prevent="
          if ($anniversaryModalMode === 'edit') @post('/xapi/anniversaries/update')
          else @post('/xapi/anniversaries/create')
        "
        class="space-y-3">
        <input
          data-bind:anniversary-title
          type="text"
          maxlength="120"
          required
          placeholder="기념일 이름"
          class="box-border w-full rounded-[18px] border border-[#e4e1d6] bg-[#f7f5ef] px-4 py-3 text-sm outline-none" />
        <input
          data-bind:anniversary-date
          type="date"
          required
          class="box-border w-full rounded-[18px] border border-[#e4e1d6] bg-[#f7f5ef] px-4 py-3 text-sm outline-none" />
        <div class="grid grid-cols-2 gap-2">
          <select
            data-bind:anniversary-kind
            data-on:change="if ($anniversaryKind === 'birthday' || $anniversaryKind === 'relationship_start') $anniversaryRecurrence = 'yearly'"
            class="box-border min-w-0 rounded-[18px] border border-[#e4e1d6] bg-[#f7f5ef] px-3 py-3 text-sm">
            <option value="custom">기념일</option>
            <option value="relationship_start">우리가 만난 날</option>
            <option value="birthday">생일</option>
          </select>
          <select
            data-bind:anniversary-recurrence
            data-attr:disabled="$anniversaryKind === 'birthday' || $anniversaryKind === 'relationship_start'"
            class="box-border min-w-0 rounded-[18px] border border-[#e4e1d6] bg-[#f7f5ef] px-3 py-3 text-sm">
            <option value="none">한 번만</option>
            <option value="yearly">매년</option>
          </select>
        </div>
        <label
          data-show="$anniversaryKind === 'birthday'"
          class="block">
          <span class="mb-1.5 block px-1 text-xs font-bold text-[#77766d]">누구의 생일인가요?</span>
          <select
            data-bind:anniversary-related-user-id
            class="box-border w-full rounded-[18px] border border-[#e4e1d6] bg-[#f7f5ef] px-3 py-3 text-sm">
            <option value="">선택해 주세요</option>
            <option value="<%= profiles.current.id %>"><%= profiles.current.name %></option>
            <option value="<%= profiles.partner.id %>"><%= profiles.partner.name %></option>
          </select>
        </label>
        <input
          data-bind:anniversary-emoji
          type="text"
          maxlength="16"
          placeholder="이모지(선택)"
          class="box-border w-full rounded-[18px] border border-[#e4e1d6] bg-[#f7f5ef] px-4 py-3 text-sm outline-none" />
        <button
          type="submit"
          class="h-12 w-full rounded-[18px] border-0 bg-[#354922] text-sm font-bold text-white"
          data-text="$anniversaryModalMode === 'edit' ? '기념일 수정' : '기념일 저장'">
          기념일 저장
        </button>
      </form>
    </section>
  </div>
  <%- include('app-bottom-nav.ejs', { currentPath: '/us' }) %>
</div>

<% if (pushConfigured) { %>
<script>
  ;(function () {
    const button = document.getElementById('push-toggle')
    const status = document.getElementById('push-status')
    let oneSignal = null
    let busy = false

    if (!button || !status) return

    function isIosDevice() {
      return /iPhone|iPad|iPod/i.test(navigator.userAgent)
    }

    function isStandaloneWebApp() {
      return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true
    }

    function getSubscription() {
      if (!oneSignal || !oneSignal.User || !oneSignal.User.PushSubscription) return null
      return oneSignal.User.PushSubscription
    }

    function render(enabled, message) {
      button.textContent = enabled ? '알림 끄기' : '알림 받기'
      button.dataset.enabled = enabled ? 'true' : 'false'
      button.disabled = busy
      status.textContent = message
    }

    function savePreference(enabled) {
      return fetch('/api/push/preference', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: enabled }),
      }).then(function (response) {
        return response.json().then(function (result) {
          if (!response.ok || !result.ok) {
            throw new Error(result.message || '알림 설정을 저장하지 못했어요.')
          }

          return result
        })
      })
    }

    function finish(enabled, message) {
      busy = false
      render(enabled, message)
    }

    button.disabled = true

    if (!window.__dulkongOneSignalReady) {
      finish(false, 'OneSignal을 불러오지 못했어요. 잠시 후 다시 시도해 주세요.')
      return
    }

    window.__dulkongOneSignalReady
      .then(function (readyOneSignal) {
        oneSignal = readyOneSignal
        const subscription = getSubscription()
        const enabled = Boolean(subscription && subscription.optedIn)

        if (isIosDevice() && !isStandaloneWebApp()) {
          render(false, 'iPhone에서는 홈 화면에 추가한 둘콩 앱에서 켤 수 있어요.')
          return
        }

        if (!subscription) {
          render(false, '현재 브라우저에서는 웹 푸시를 지원하지 않아요.')
          button.disabled = true
          return
        }

        render(enabled, enabled ? '새 채팅이 오면 이 기기로 알려드려요.' : '새 메시지를 놓치지 않도록 알려드려요.')
      })
      .catch(function () {
        finish(false, '알림 기능을 준비하지 못했어요. 잠시 후 다시 시도해 주세요.')
      })

    button.addEventListener('click', function () {
      if (busy) return

      if (isIosDevice() && !isStandaloneWebApp()) {
        render(false, '공유 메뉴에서 홈 화면에 추가한 뒤 둘콩 앱으로 열어주세요.')
        return
      }

      const subscription = getSubscription()
      if (!subscription) {
        render(false, '알림 기능이 아직 준비되지 않았어요.')
        return
      }

      const enable = !subscription.optedIn
      const operation = enable ? subscription.optIn() : subscription.optOut()
      busy = true
      render(!enable, enable ? '알림 권한을 확인하고 있어요.' : '알림을 끄고 있어요.')

      Promise.resolve(operation)
        .then(function () {
          if (Boolean(subscription.optedIn) !== enable) {
            throw new Error(enable ? '알림 권한이 허용되지 않았어요.' : '알림 구독을 끄지 못했어요.')
          }

          return savePreference(enable)
        })
        .then(function () {
          finish(enable, enable ? '새 채팅이 오면 이 기기로 알려드려요.' : '이 기기의 채팅 알림을 껐어요.')
        })
        .catch(function (pushError) {
          console.warn('Dulkong push preference failed', pushError)
          finish(Boolean(subscription.optedIn), String(pushError.message || '알림 설정을 바꾸지 못했어요.'))
        })
    })
  })()
</script>
<% } %>
