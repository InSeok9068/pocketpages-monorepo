<script server>
  const { createOneSignalClient } = require('@pocketpages/onesignal')
  const coupleData = resolve('couple-data')
  const { getChatSticker } = resolve('chat-stickers')
  const { patchAppToast } = resolve('patch-app-toast')

  if (request.method !== 'POST' || !request.auth) {
    patchAppToast(datastar, '로그인이 필요합니다.', 'error')
    return
  }

  const signals = datastar.requestSignals({
    draft: '',
    clientMessageId: '',
    clientId: '',
    stickerId: '',
    newestMessageCreated: '',
    newestMessageId: '',
  })
  const userId = String(request.auth.get('id') || '')
  const bodyText = String(signals.draft || '').trim()
  const stickerId = String(signals.stickerId || '').trim()
  const sticker = getChatSticker(stickerId)
  const isSticker = Boolean(stickerId)
  const clientMessageId = String(signals.clientMessageId || '').trim() || 'web_' + String(new Date().getTime())
  const senderClientId = String(signals.clientId || '')

  dbg('dulkong/xapi/messages/send:start', {
    userId,
    clientMessageId,
    messageType: isSticker ? 'sticker' : 'text',
    bodyLength: bodyText.length,
  })

  try {
    if (isSticker && !sticker) throw new Error('사용할 수 없는 스티커예요.')
    if (!isSticker && !bodyText) throw new Error('메시지를 입력해 주세요.')
    if (!isSticker && bodyText.length > 5000) throw new Error('메시지는 5,000자까지 보낼 수 있어요.')

    const collection = $app.findCollectionByNameOrId('messages')
    const record = new Record(collection)
    record.set('sender', userId)
    record.set('clientMessageId', clientMessageId)
    record.set('type', isSticker ? 'sticker' : 'text')
    record.set('body', isSticker ? sticker.label : bodyText)
    if (isSticker) record.set('systemData', { stickerId: sticker.id })
    record.set('clientCreatedAt', new Date().toISOString())
    $app.save(record)

    info('dulkong/xapi/messages/send:success', { messageId: String(record.get('id') || ''), userId })
    const profiles = coupleData.getCoupleProfiles($app, request.auth)
    const messages = coupleData.getMessagesAfter(
      $app,
      userId,
      String(signals.newestMessageCreated || ''),
      String(signals.newestMessageId || ''),
      100
    )
    const newestMessage = messages.length ? messages[messages.length - 1] : coupleData.mapMessage(record, userId)
    datastar.removeElements('#message-empty-state')
    datastar.patchElements(include('message-rows.ejs', { messages: messages.length ? messages : [newestMessage] }), {
      selector: '#message-rows',
      mode: 'append',
    })
    datastar.patchSignals({
      draft: isSticker ? String(signals.draft || '') : '',
      clientMessageId: '',
      stickerId: '',
      stickerPickerOpen: false,
      chatSending: false,
      chatAtBottom: true,
      chatHasNewMessage: false,
      newestMessageCreated: newestMessage.createdAt,
      newestMessageId: newestMessage.id,
      chatPartnerReadAt: profiles.partner.lastReadAt,
    })
    datastar.executeScript(
      "var draft=document.getElementById('chat-draft'); if(draft && "
        + JSON.stringify(!isSticker)
        + ") draft.value=''; if(window.dulkongApplyChatReadReceipt) window.dulkongApplyChatReadReceipt("
        + JSON.stringify(profiles.partner.lastReadAt)
        + '); if(window.dulkongFinishChatUpdate) window.dulkongFinishChatUpdate(true);'
    )
    datastar.realtime.patchSignals({ chatRevision: new Date().getTime() }, undefined, {
      filter: function (clientId) {
        return !senderClientId || clientId !== senderClientId
      },
    })

    if (profiles.partner.id && profiles.partner.pushEnabled && !profiles.partner.chatMuted) {
      const oneSignalAppId = String(env('DULKONG_ONESIGNAL_APPID') || '').trim()
      const oneSignalApiKey = String(env('DULKONG_ONESIGNAL_APIKEY') || '').trim()

      if (!oneSignalAppId || !oneSignalApiKey) {
        warn('dulkong/xapi/messages/send:push-skipped', {
          messageId: String(record.get('id') || ''),
          reason: 'onesignal_not_configured',
        })
      } else {
        try {
          const messageBody = isSticker ? sticker.art + ' ' + sticker.label : bodyText
          const pushBody = messageBody.length > 100 ? messageBody.slice(0, 100) + '…' : messageBody
          const pushOrigin = String($app.settings().meta.appURL || '')
            .trim()
            .replace(/\/+$/, '')
          const oneSignal = createOneSignalClient({
            appId: oneSignalAppId,
            apiKey: oneSignalApiKey,
            timeoutSeconds: 5,
          })
          const pushResult = oneSignal.createNotification({
            include_aliases: {
              external_id: [profiles.partner.id],
            },
            target_channel: 'push',
            headings: {
              en: profiles.current.name + '에게 메시지가 왔어요 💬',
            },
            contents: {
              en: pushBody,
            },
            url: pushOrigin + '/chat',
            isAnyWeb: true,
          })

          if (pushResult.ok) {
            info('dulkong/xapi/messages/send:push-success', {
              messageId: String(record.get('id') || ''),
              notificationId: pushResult.notificationId,
              recipientId: profiles.partner.id,
            })
          } else {
            warn('dulkong/xapi/messages/send:push-failed', {
              messageId: String(record.get('id') || ''),
              recipientId: profiles.partner.id,
              statusCode: pushResult.statusCode,
              error: pushResult.errorMessage,
            })
          }
        } catch (pushException) {
          warn('dulkong/xapi/messages/send:push-failed', {
            messageId: String(record.get('id') || ''),
            recipientId: profiles.partner.id,
            error: String(pushException.message || pushException),
          })
        }
      }
    }
  } catch (exception) {
    error('dulkong/xapi/messages/send:failed', {
      userId,
      clientMessageId,
      error: String(exception.message || exception),
    })
    datastar.patchSignals({ chatSending: false })
    patchAppToast(datastar, String(exception.message || '메시지를 보내지 못했어요.'), 'error')
  }
</script>
