<script server>
  const coupleData = resolve('couple-data')
  const { patchAppToast } = resolve('patch-app-toast')

  if (!request.auth) {
    patchAppToast(datastar, '로그인이 필요합니다.', 'error')
    return
  }

  const userId = String(request.auth.get('id') || '')
  const profiles = coupleData.getCoupleProfiles($app, request.auth)
  const page = coupleData.getMessagePage($app, userId, {
    limit: 50,
    partnerLastReadAt: profiles.partner.lastReadAt,
  })
  const oldestMessage = page.messages.length ? page.messages[0] : null
  const newestMessage = page.messages.length ? page.messages[page.messages.length - 1] : null
  dbg('dulkong/xapi/messages/list:query', { userId })
  datastar.patchElements(
    include('message-list.ejs', {
      messages: page.messages,
      partnerName: profiles.partner.name,
      positionOnLoad: false,
    }),
    {
      selector: '#message-list',
      mode: 'outer',
    }
  )
  datastar.patchSignals({
    chatAtBottom: true,
    chatHasNewMessage: false,
    messageHasMore: page.hasMore,
    messageHistoryLoading: false,
    oldestMessageCreated: oldestMessage ? oldestMessage.createdAt : '',
    oldestMessageId: oldestMessage ? oldestMessage.id : '',
    newestMessageCreated: newestMessage ? newestMessage.createdAt : '',
    newestMessageId: newestMessage ? newestMessage.id : '',
    chatPartnerReadAt: profiles.partner.lastReadAt,
  })
  datastar.executeScript(
    'if(window.dulkongApplyChatReadReceipt) window.dulkongApplyChatReadReceipt('
      + JSON.stringify(profiles.partner.lastReadAt)
      + '); if(window.dulkongFinishChatUpdate) window.dulkongFinishChatUpdate(true);'
  )
</script>
