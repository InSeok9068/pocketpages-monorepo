<script server>
  const coupleData = resolve('couple-data')
  const { patchAppToast } = resolve('patch-app-toast')

  if (request.method !== 'POST' || !request.auth) {
    patchAppToast(datastar, '로그인이 필요합니다.', 'error')
    return
  }

  const signals = datastar.requestSignals({ photoEditId: '', photoFilter: 'all' })
  const photoId = String(signals.photoEditId || '').trim()
  const photoFilter = String(signals.photoFilter || 'all')
  const userId = String(request.auth.get('id') || '')

  dbg('dulkong/xapi/photos/delete:start', { photoId, userId })

  try {
    if (!photoId) throw new Error('삭제할 사진을 찾지 못했어요.')

    const record = $app.findFirstRecordByFilter('photos', "id = {:photoId} && deletedAt = ''", {
      photoId: photoId,
    })
    $app.delete(record)

    info('dulkong/xapi/photos/delete:success', { photoId, userId })
    datastar.patchElements(include('photo-grid.ejs', { photos: coupleData.listPhotos($app, photoFilter) }), {
      selector: '#photo-results',
      mode: 'outer',
    })
    datastar.patchSignals({
      photoModalOpen: false,
      photoModalMode: 'create',
      photoEditId: '',
      photoCaption: '',
      photoTakenAt: '',
      photoLocationName: '',
    })
    patchAppToast(datastar, '사진을 삭제했어요.', 'success')
  } catch (exception) {
    error('dulkong/xapi/photos/delete:failed', {
      photoId,
      userId,
      error: String(exception.message || exception),
    })
    patchAppToast(datastar, '사진을 삭제하지 못했어요.', 'error')
  }
</script>
