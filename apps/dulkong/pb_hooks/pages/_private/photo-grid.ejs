<div id="photo-results">
  <section aria-label="사진 목록">
    <% if (!photos.length) { %>
    <div class="rounded-[24px] border border-dashed border-[#d9d7cc] bg-white/65 px-5 py-12 text-center">
      <span
        class="i-lucide-image-plus mx-auto block h-9 w-9 text-[#9bb471]"
        aria-hidden="true"></span>
      <p class="mt-3 mb-0 text-sm font-bold text-[#55554d]">아직 모은 사진이 없어요.</p>
      <p class="mt-1 mb-0 text-xs text-[#99988e]">오늘의 순간을 첫 추억으로 올려 보세요.</p>
    </div>
    <% } else { %>
    <div class="grid grid-cols-2 gap-3">
      <% photos.forEach(function (photo) { %>
      <article
        data-class="{ 'ring-3 ring-[#91aa68] ring-offset-2': $selectedPhotoIds.includes('<%= photo.id %>') }"
        class="photo-card group relative aspect-square overflow-hidden rounded-[24px] bg-[#e8e6dc]">
        <img
          src="<%= photo.imageUrl %>"
          alt="<%= photo.caption || '추억 사진' %>"
          class="h-full w-full object-cover"
          loading="lazy" />
        <div
          class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/65 to-transparent px-3 pt-10 pb-3 text-white">
          <% if (photo.caption) { %>
          <p class="m-0 truncate text-sm font-bold"><%= photo.caption %></p>
          <% } %>
          <p class="mt-0.5 mb-0 text-[11px] font-medium text-white/75">
            <%= photo.dateLabel %><%= photo.locationName ? ' · ' + photo.locationName : '' %>
          </p>
        </div>
        <button
          type="button"
          data-photo-id="<%= photo.id %>"
          data-photo-chat-background="<%= photo.isChatBackground ? 'true' : 'false' %>"
          data-photo-caption="<%= photo.caption %>"
          data-photo-taken-at="<%= photo.takenAt %>"
          data-photo-location-name="<%= photo.locationName %>"
          data-photo-viewer-url="<%= photo.imageUrl %>"
          data-photo-viewer-meta="<%= photo.dateLabel + (photo.locationName ? ' · ' + photo.locationName : '') %>"
          data-on:pointerdown="window.dulkongStartPhotoPress(evt)"
          data-on:pointermove="window.dulkongMovePhotoPress(evt)"
          data-on:pointerup="window.dulkongEndPhotoPress(evt)"
          data-on:pointercancel="window.dulkongCancelPhotoPress(evt)"
          data-on:contextmenu__prevent="true"
          data-on:click="window.dulkongOpenPhoto(evt)"
          class="photo-viewer-trigger absolute inset-0 cursor-zoom-in rounded-[24px] border-0 bg-transparent"
          aria-label="<%= photo.caption || '추억 사진' %> 크게 보기. 길게 누르면 수정"></button>
        <div
          data-show="$photoSelectionMode"
          data-class="{
            'bg-[#354922] text-white': $selectedPhotoIds.includes('<%= photo.id %>'),
            'bg-white/88 text-transparent': !$selectedPhotoIds.includes('<%= photo.id %>'),
          }"
          class="pointer-events-none absolute top-2 left-2 z-20 flex h-8 w-8 items-center justify-center rounded-full border-2 border-white shadow-[0_2px_8px_rgba(0,0,0,0.18)]">
          <span
            class="i-lucide-check h-4 w-4"
            aria-hidden="true"></span>
        </div>
        <button
          type="button"
          data-show="!$photoSelectionMode"
          data-on:click__stop="
            @post('/xapi/photos/favorite', {
              payload: { photoId: '<%= photo.id %>', photoFilter: $photoFilter },
            })
          "
          class="photo-favorite-button <%= photo.isFavorite ? 'photo-favorite-button--active' : '' %> absolute top-2 right-2 flex h-8 w-8 items-center justify-center rounded-full border-0 bg-black/28 text-white backdrop-blur-sm"
          aria-pressed="<%= photo.isFavorite ? 'true' : 'false' %>"
          aria-label="즐겨찾기 <%= photo.isFavorite ? '해제' : '추가' %>">
          <% if (photo.isFavorite) { %>
          <span
            class="photo-favorite-heart"
            aria-hidden="true">
            ♥
          </span>
          <% } else { %>
          <span
            class="i-lucide-heart h-4 w-4"
            aria-hidden="true"></span>
          <% } %>
        </button>
      </article>
      <% }) %>
    </div>
    <% } %>
  </section>
</div>
