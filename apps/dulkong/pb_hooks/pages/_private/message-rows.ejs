<% messages.forEach(function (message) { %>
<div
  id="message-<%= message.id %>"
  data-message-created="<%= message.createdAt %>"
  data-message-mine="<%= message.mine ? 'true' : 'false' %>"
  class="<%= message.mine ? 'justify-end' : '' %> flex items-end gap-2">
  <% if (message.mine) { %>
  <div
    class="mb-1 flex min-w-8 shrink-0 flex-col items-end gap-0.5 text-[10px] leading-none font-medium whitespace-nowrap text-[#7f7e75]">
    <span
      data-chat-read-receipt
      class="font-semibold text-[#567336]"
      <% if (!message.showReadReceipt) { %>hidden<% } %>>
      읽음
    </span>
    <time><%= message.timeLabel %></time>
  </div>
  <% } %>
  <% if (message.sticker) { %>
  <img
    src="<%= asset(message.sticker.imagePath) %>"
    alt="둘콩 스티커: <%= message.sticker.label %>"
    class="h-36 w-36 object-contain" />
  <% } else { %>
  <div
    class="<%= message.mine ? 'rounded-[18px_18px_6px_18px] bg-[#cfe5a6] text-[#30421d]' : 'rounded-[18px_18px_18px_6px] bg-white' %> max-w-[76%] min-w-0 px-3.5 py-2.5 text-sm leading-5 break-words shadow-[0_5px_16px_rgba(58,59,51,0.06)]">
    <% message.lines.forEach(function (line) { %>
    <span class="block min-h-5"><%= line %></span>
    <% }) %>
  </div>
  <% } %>
  <% if (!message.mine) { %>
  <time class="mb-1 shrink-0 text-[10px] leading-none font-medium whitespace-nowrap text-[#7f7e75]">
    <%= message.timeLabel %>
  </time>
  <% } %>
</div>
<% }) %>
