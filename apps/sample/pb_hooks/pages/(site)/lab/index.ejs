<script server>
  meta('title', 'PocketPages Lab')
  meta('description', 'PocketPages core feature lab')

  /** @type {{ theme?: string } | null} */
  const prefCookie = request.cookies('lab_pref') || null
  const labInput = {
    query: String(request.url.query.q || '').trim(),
    header: String(request.header('X-Lab') || '').trim(),
    method: request.method,
    cookieValue: prefCookie,
  }
  const parsedUrl = url('https://example.test/path?item=lab')
  const labView = {
    query: labInput.query,
    header: labInput.header,
    method: labInput.method,
    cookieTheme: labInput.cookieValue && labInput.cookieValue.theme ? String(labInput.cookieValue.theme) : '',
    urlItem: String(parsedUrl.query.item || ''),
    stringified: stringify({ lab: 'ok' }),
    appEnv: String(env('APP_ENV') || 'development').trim(),
    relativeAsset: asset('lab-asset.css'),
    absoluteAsset: asset('/assets/style.css'),
  }

  response.header('X-Lab-Page', 'rendered')
  response.cookie('lab_seen', { at: 'lab' }, { path: '/lab', maxAge: 120, httpOnly: true, sameSite: 'strict' })

  dbg('page/lab:index:response', {
    method: labView.method,
    query: labView.query,
    hasCookie: !!labView.cookieTheme,
  })
</script>

