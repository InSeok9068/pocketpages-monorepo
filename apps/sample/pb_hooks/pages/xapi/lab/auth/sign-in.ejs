<script server>
  const form = body() || {}
  const email = String(form.email || '')
    .trim()
    .toLowerCase()
  const password = form.password === undefined || form.password === null ? '' : String(form.password)

  dbg('xapi/lab/auth/sign-in:start', { email })

  try {
    if (!email || !password) throw new Error('Email and password are required.')

    const authData = signInWithPassword(email, password)

    dbg('xapi/lab/auth/sign-in:response', {
      status: 303,
      redirectTo: '/lab/auth',
      message: 'Signed in.',
      authId: String((authData.record && authData.record.id) || ''),
    })
    redirect('/lab/auth', { status: 303, message: 'Signed in.' })
    return
  } catch (exception) {
    warn('xapi/lab/auth/sign-in:failed', { email, error: String(exception.message || exception) })
  }

  dbg('xapi/lab/auth/sign-in:response', { status: 303, redirectTo: '/lab/auth', error: 'Sign in failed.' })
  redirect('/lab/auth', { status: 303, message: 'Sign in failed.' })
  return
</script>
