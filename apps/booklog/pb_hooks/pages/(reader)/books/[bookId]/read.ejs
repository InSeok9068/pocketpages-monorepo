                  x-bind:value="Math.floor(cloudAudioPosition)"
                  x-bind:disabled="cloudAudioBusy || !(cloudAudioDuration > 0)"
                  x-on:input="cloudAudioSeeking = true; cloudAudioPosition = Number($event.target.value)"
                  x-on:change="cloudAudioSeeking = false; seekCloudAudio(Number($event.target.value))"
                  class="block w-full accent-[#8e5521]" />
