            <span
              x-show="!readAloudBusy && !readAloudPlaying"
              x-cloak>
              재생
            </span>
            <span
              x-show="readAloudBusy"
              x-cloak>
              준비 중
            </span>
            <span
              x-show="readAloudPlaying"
              x-cloak>
              재생 중
            </span>
          </button>
          <button
            type="button"
            x-on:click="stopReadAloud()"
            x-bind:disabled="!readAloudPlaying && !readAloudBusy"
            class="inline-flex items-center justify-center rounded-full border-none bg-stone-100 px-4 py-3 text-sm font-semibold text-stone-700 ring-0 outline-none disabled:opacity-60">
            정지
          </button>
        </div>
      </div>
    </div>
  </div>

  <div
    x-show="searchOpen"
    x-cloak
    class="fixed inset-0 z-40 bg-[rgba(24,19,16,0.21)]">
    <div
      class="box-border flex h-dvh items-start justify-center px-4 pt-[clamp(2rem,12dvh,6rem)] pb-[max(1rem,env(safe-area-inset-bottom))] sm:px-6">
      <div
        class="box-border max-h-full w-full max-w-3xl shrink-0 overflow-y-auto overscroll-contain rounded-[1.75rem] border border-stone-200/80 bg-[rgba(255,255,255,0.94)] p-4 shadow-[0_24px_60px_rgba(24,19,16,0.16)]">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 class="text-base font-semibold text-stone-950">책 전체 검색</h2>
          <button
            type="button"
            x-on:click="closeSearch()"
            aria-label="검색 닫기"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border-none bg-[#f7f2e8] text-stone-700 ring-0 outline-none">
            <span
              class="i-lucide-x h-4 w-4"
              aria-hidden="true"></span>
          </button>
        </div>

        <div class="mb-3 flex gap-2">
          <input
            id="reader-search-input"
            x-model="searchQuery"
            x-on:keydown.enter.prevent="performSearch()"
            type="text"
            placeholder="찾을 문장을 입력해 주세요"
            class="box-border min-w-0 flex-1 rounded-full border-0 bg-[#fbf5ec] px-4 py-3 text-sm text-[#2f251c] shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1)] transition outline-none placeholder:text-[#b59f87] focus:bg-[#fffaf2] focus:shadow-[inset_0_0_0_1.5px_rgba(155,111,69,0.32)]" />
          <button
            type="button"
            x-on:click="performSearch()"
            x-bind:disabled="searching"
            class="shrink-0 rounded-full border-none bg-stone-950 px-4 py-3 text-sm font-semibold text-white ring-0 outline-none disabled:opacity-60">
            <span
              x-show="!searching"
              x-cloak>
              검색
            </span>
            <span
              x-show="searching"
              x-cloak>
              검색 중
            </span>
          </button>
        </div>

        <p
          x-show="searchMessage"
          x-cloak
          class="mb-3 text-sm text-stone-500"
          x-text="searchMessage"></p>

        <div class="max-h-[60vh] overflow-y-auto">
          <template x-if="!searchResults.length && !searching && !searchMessage">
            <p
              class="rounded-[1.25rem] bg-[#fbf7ef] px-4 py-4 text-sm leading-6 text-stone-500 shadow-[inset_0_0_0_1px_rgba(118,87,52,0.08)]">
              검색어를 입력하면 책 전체를 훑어서 결과를 보여줍니다.
            </p>
          </template>

          <div
            x-show="searchResults.length"
            x-cloak
            class="space-y-2">
            <template
              x-for="result in searchResults"
              :key="result.cfi">
              <button
                type="button"
                x-on:click="goToSearchResult(result)"
                class="block w-full rounded-[1.25rem] border-none bg-[#fbf7ef] px-4 py-3 text-left text-sm text-stone-700 shadow-[inset_0_0_0_1px_rgba(118,87,52,0.08)] ring-0 transition outline-none hover:bg-[#f7f0e3]">
                <span
                  x-show="result.chapterLabel"
                  x-text="result.chapterLabel"
                  class="mb-1 block text-xs leading-5 font-semibold text-[#956536]"></span>
                <span
                  x-html="result.excerptHtml || result.excerpt"
                  class="block leading-6"></span>
              </button>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    x-show="tocOpen"
    x-cloak
    class="fixed inset-0 z-40 bg-[rgba(24,19,16,0.21)]">
    <div
      class="box-border flex h-dvh items-start justify-center px-4 pt-[clamp(2rem,12dvh,6rem)] pb-[max(1rem,env(safe-area-inset-bottom))] sm:px-6">
      <div
        class="box-border max-h-full w-full max-w-3xl shrink-0 overflow-y-auto overscroll-contain rounded-[1.75rem] border border-stone-200/80 bg-[rgba(255,255,255,0.94)] p-4 shadow-[0_24px_60px_rgba(24,19,16,0.16)]">
        <div class="mb-3 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-semibold text-stone-950">목차</h2>
            <p
              class="mt-1 text-sm text-stone-500"
              x-text="currentChapterLabel ? '현재 위치: ' + currentChapterLabel : '현재 위치를 확인하는 중입니다.'"></p>
          </div>
          <button
            type="button"
            x-on:click="closeToc()"
            aria-label="목차 닫기"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border-none bg-[#f7f2e8] text-stone-700 ring-0 outline-none">
            <span
              class="i-lucide-x h-4 w-4"
              aria-hidden="true"></span>
          </button>
        </div>

        <div
          id="reader-toc-scroll"
          class="max-h-[60vh] overflow-y-auto">
          <template x-if="!tocReady || !tocItems.length">
            <p
              class="rounded-[1.25rem] bg-[#fbf7ef] px-4 py-4 text-sm leading-6 text-stone-500 shadow-[inset_0_0_0_1px_rgba(118,87,52,0.08)]"
              x-text="tocReady ? tocMessage : '목차를 불러오는 중입니다.'"></p>
          </template>

          <template x-if="tocReady && tocItems.length">
            <div class="space-y-1">
              <template
                x-for="item in tocItems"
                :key="item.id || item.href || item.label">
                <div class="space-y-1">
                  <button
                    type="button"
                    x-on:click="goToTocItem(item)"
                    x-bind:data-toc-key="item.key || ''"
                    x-bind:aria-current="isActiveTocItem(item) ? 'true' : null"
                    x-bind:class="isActiveTocItem(item) ? 'bg-stone-950 text-white' : 'bg-[#fbf7ef] text-stone-700 hover:bg-[#f7f0e3]'"
                    class="block w-full rounded-[1.1rem] border-none px-4 py-3 text-left text-sm leading-6 shadow-[inset_0_0_0_1px_rgba(118,87,52,0.08)] ring-0 transition outline-none">
                    <span x-text="item.label || '제목 없음'"></span>
                  </button>
                  <template x-if="item.subitems && item.subitems.length">
                    <div class="ml-4 border-l border-[rgba(118,87,52,0.12)] pl-3">
                      <template
                        x-for="child in item.subitems"
                        :key="child.id || child.href || child.label">
                        <button
                          type="button"
                          x-on:click="goToTocItem(child)"
                          x-bind:data-toc-key="child.key || ''"
                          x-bind:aria-current="isActiveTocItem(child) ? 'true' : null"
                          x-bind:class="isActiveTocItem(child) ? 'bg-stone-950 text-white' : 'bg-[#fbf7ef] text-stone-700 hover:bg-[#f7f0e3]'"
                          class="block w-full rounded-[1.1rem] border-none px-4 py-3 text-left text-sm leading-6 shadow-[inset_0_0_0_1px_rgba(118,87,52,0.08)] ring-0 transition outline-none">
                          <span x-text="child.label || '제목 없음'"></span>
                        </button>
                      </template>
                    </div>
                  </template>
                </div>
              </template>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>

  <div
    x-show="highlightOpen"
    x-cloak
    class="fixed inset-0 z-40 bg-[rgba(24,19,16,0.21)]">
    <div
      class="box-border flex h-dvh items-start justify-center px-4 pt-[clamp(2rem,12dvh,6rem)] pb-[max(1rem,env(safe-area-inset-bottom))] sm:px-6">
      <div
        class="box-border max-h-full w-full max-w-3xl shrink-0 overflow-y-auto overscroll-contain rounded-[1.75rem] border border-stone-200/80 bg-[rgba(255,255,255,0.94)] p-4 shadow-[0_24px_60px_rgba(24,19,16,0.16)]">
        <div class="mb-3 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-semibold text-stone-950">인상 깊은 문구 추가</h2>
            <p
              x-show="currentChapterLabel"
              x-cloak
              class="mt-1 text-sm text-stone-500"
              x-text="currentChapterLabel"></p>
          </div>
          <button
            type="button"
            x-on:click="closeHighlight()"
            aria-label="문구 추가 닫기"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border-none bg-[#f7f2e8] text-stone-700 ring-0 outline-none">
            <span
              class="i-lucide-x h-4 w-4"
              aria-hidden="true"></span>
          </button>
        </div>

        <div class="space-y-3">
          <label class="block space-y-2">
            <span class="text-sm font-medium text-stone-700">문구</span>
            <textarea
              id="reader-highlight-quote"
              x-model="highlightQuoteText"
              rows="5"
              class="box-border block w-full min-w-0 rounded-[1.25rem] border-0 bg-[#fbf5ec] px-4 py-4 text-[15px] leading-7 text-[#2f251c] shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1),0_10px_24px_rgba(157,121,72,0.08)] transition outline-none placeholder:text-[#b59f87]"
              placeholder="복사한 문구를 붙여넣어 주세요."></textarea>
          </label>

          <label class="block space-y-2">
            <span class="text-sm font-medium text-stone-700">메모</span>
            <textarea
              x-model="highlightNoteText"
              rows="3"
              class="box-border block w-full min-w-0 rounded-[1.25rem] border-0 bg-[#fbf5ec] px-4 py-4 text-[15px] leading-7 text-[#2f251c] shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1),0_10px_24px_rgba(157,121,72,0.08)] transition outline-none placeholder:text-[#b59f87]"
              placeholder="짧은 생각이 있으면 같이 남겨두세요."></textarea>
          </label>
        </div>

        <p
          x-show="highlightMessage"
          x-cloak
          class="mt-3 text-sm text-stone-500"
          x-text="highlightMessage"></p>

        <div class="mt-4 flex gap-2">
          <button
            type="button"
            x-on:click="saveHighlight()"
            x-bind:disabled="savingHighlight"
            class="inline-flex items-center justify-center rounded-full border-none bg-stone-950 px-4 py-3 text-sm font-semibold text-white ring-0 outline-none disabled:opacity-60">
            <span
              x-show="!savingHighlight"
              x-cloak>
              문구 저장
            </span>
            <span
              x-show="savingHighlight"
              x-cloak>
              저장 중
            </span>
          </button>
          <button
            type="button"
            x-on:click="closeHighlight()"
            x-bind:disabled="savingHighlight"
            class="inline-flex items-center justify-center rounded-full border-none bg-stone-100 px-4 py-3 text-sm font-semibold text-stone-700 ring-0 outline-none disabled:opacity-60">
            닫기
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="ios-safe-screen mx-auto flex min-h-screen max-w-none flex-col px-0 pt-0 pb-0 sm:px-0">
    <div
      x-cloak
      x-show="loading"
      class="pointer-events-none fixed top-5 left-1/2 z-40 max-w-[calc(100vw-6rem)] -translate-x-1/2 rounded-full bg-[rgba(24,19,16,0.82)] px-5 py-3 text-center text-sm font-medium text-white shadow-[0_18px_40px_rgba(24,19,16,0.28)] backdrop-blur-sm">
      EPUB 파일을 불러오는 중입니다.
    </div>

    <div
      x-cloak
      x-show="errorMessage"
      class="pointer-events-none fixed top-5 left-1/2 z-40 max-w-[calc(100vw-6rem)] -translate-x-1/2 rounded-full bg-[rgba(122,54,32,0.9)] px-5 py-3 text-center text-sm font-medium text-white shadow-[0_18px_40px_rgba(67,28,16,0.28)] backdrop-blur-sm"
      x-text="errorMessage"></div>

    <div
      x-cloak
      x-show="savePositionMessage"
      class="pointer-events-none fixed top-5 left-1/2 z-40 max-w-[calc(100vw-6rem)] -translate-x-1/2 rounded-full bg-[rgba(24,19,16,0.82)] px-5 py-3 text-center text-sm font-medium text-white shadow-[0_18px_40px_rgba(24,19,16,0.28)] backdrop-blur-sm"
      x-text="savePositionMessage"></div>

    <div class="min-h-0 flex-1 bg-white">
      <div
        id="epub-reader"
        class="ios-safe-screen-fill h-screen overflow-y-auto px-0 py-0 sm:px-0 sm:py-0"></div>
    </div>
  </div>
</section>

<script>
  window.booklogReaderConfig = {
    readerUrl: '<%= epubReaderUrl %>',
    bookId: '<%= bookId %>',
    bookFileId: '<%= bookFileId %>',
    readerCacheKey: '<%= userId %>:<%= bookFileHash || bookId %>',
    initialShelfStatus: '<%= initialShelfStatus %>',
  }
</script>
<script src="<%= asset('/assets/booklog-audio.js') %>"></script>
<script src="<%= asset('/assets/booklog-reader.js') %>"></script>
