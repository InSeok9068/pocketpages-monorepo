              class="space-y-3">
              <div class="space-y-1">
                <div class="flex items-center justify-between gap-2">
                  <p class="m-0 flex min-w-0 items-baseline gap-1.5 text-sm font-semibold text-stone-900">
                    <span
                      class="truncate"
                      x-text="cloudAudioBusy && !(cloudAudioDuration > 0) ? '불러오는 중' : cloudAudioChapter || 'AI 오디오북'"></span>
                    <span
                      x-show="cloudAudioChapterOrder"
                      x-text="cloudAudioChapterOrder"
                      class="shrink-0 text-xs font-medium text-stone-500 tabular-nums"></span>
                  </p>
                  <button
                    type="button"
                    x-on:click="goToListeningPosition()"
                    x-bind:disabled="!(cloudAudioDuration > 0)"
                    class="inline-flex shrink-0 items-center gap-1 rounded-full border-none bg-[#efe2d2] px-3 py-1.5 text-xs font-semibold text-[#8e5521] disabled:opacity-40">
