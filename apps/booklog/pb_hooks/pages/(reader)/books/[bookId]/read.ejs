                </button>
              </div>
            </div>
            <p
              role="status"
              x-show="cloudAudioMessage"
              x-text="cloudAudioMessage"
              class="m-0 rounded-[1rem] bg-[#fbf5ec] px-3 py-2 text-sm leading-6 text-stone-700"></p>
          </div>
          <% } %>
          <template x-if="readAloudEngine === 'local' && !readAloudSupported">
            <p
              class="rounded-[1.25rem] bg-[#fbf7ef] px-4 py-4 text-sm leading-6 text-stone-500 shadow-[inset_0_0_0_1px_rgba(118,87,52,0.08)]">
              이 브라우저는 읽어주기 기능을 지원하지 않습니다.
            </p>
          </template>

