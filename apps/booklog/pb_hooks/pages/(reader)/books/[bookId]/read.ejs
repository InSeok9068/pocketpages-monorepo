                  class="box-border block w-full min-w-0 rounded-[1.1rem] border-0 bg-[#fbf5ec] px-4 py-3 text-sm text-[#2f251c] shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1)] outline-none">
                  <template
                    x-for="voice in readAloudVoices"
                    :key="voice.name + '::' + voice.lang">
                    <option
                      :value="voice.name"
                      x-text="voice.label"></option>
                  </template>
                </select>
              </label>

