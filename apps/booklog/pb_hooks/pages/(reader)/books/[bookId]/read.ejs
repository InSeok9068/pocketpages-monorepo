                  <span
                    class="i-lucide-chevron-down h-4 w-4 transition group-open:rotate-180"
                    aria-hidden="true"></span>
                </summary>
                <div class="flex flex-wrap gap-2 pt-1">
                  <button
                    type="button"
                    x-on:click="startCloudAudio(true)"
                    x-bind:disabled="cloudAudioBusy"
                    class="rounded-full border-none bg-stone-100 px-4 py-2.5 text-sm font-semibold text-stone-700 disabled:opacity-60">
