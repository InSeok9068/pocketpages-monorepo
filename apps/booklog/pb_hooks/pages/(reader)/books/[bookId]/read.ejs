                    x-bind:class="cloudAudioSleep ? 'bg-[#efe2d2] text-[#8e5521]' : 'bg-stone-100 text-stone-700'"
                    class="inline-flex items-center gap-1 rounded-full border-none px-3 py-2 text-sm font-semibold tabular-nums">
                    <span
                      class="i-lucide-moon h-4 w-4"
                      aria-hidden="true"></span>
                    <span x-text="cloudAudioSleep ? cloudAudioSleepLabel : '타이머'"></span>
                  </button>
                </div>
                <button
                  type="button"
                  x-on:click="stopReadAloud()"
                  class="rounded-full border-none bg-transparent px-3 py-2 text-sm font-semibold text-stone-600">
