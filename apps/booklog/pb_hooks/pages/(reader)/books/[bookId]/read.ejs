                  <span x-text="formatAudioTime(cloudAudioPosition)"></span>
                  <% if (showAudioDetail) { %>
                  <span
                    class="truncate"
                    x-text="cloudAudioDetail"></span>
                  <% } %>
                  <span x-text="formatAudioTime(cloudAudioDuration)"></span>
                </div>
              </div>
              <div class="flex items-center justify-center gap-3">
                <button
                  type="button"
                  aria-label="이전 챕터"
                  x-on:click="moveCloudAudioChapter(-1)"
                  x-bind:disabled="cloudAudioBusy || !cloudAudioHasPrevious"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border-none bg-transparent text-stone-700 disabled:opacity-30">
                  <span
                    class="i-lucide-skip-back h-5 w-5"
                    aria-hidden="true"></span>
                </button>
                <button
                  type="button"
                  aria-label="15초 뒤로"
                  x-on:click="seekCloudAudioBy(-15)"
                  x-bind:disabled="cloudAudioBusy || !(cloudAudioDuration > 0)"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-full border-none bg-stone-100 text-stone-700 disabled:opacity-40">
                  <span
                    class="i-lucide-rotate-ccw h-5 w-5"
                    aria-hidden="true"></span>
                </button>
                <button
                  type="button"
                  x-bind:aria-label="cloudAudioActive ? '일시 정지' : '재생'"
                  x-on:click="toggleCloudAudio()"
                  x-bind:disabled="cloudAudioBusy"
                  class="inline-flex h-14 w-14 items-center justify-center rounded-full border-none bg-[#8e5521] text-white disabled:opacity-60">
                  <span
                    x-show="!cloudAudioActive"
                    class="i-lucide-play h-6 w-6"
                    aria-hidden="true"></span>
                  <span
                    x-show="cloudAudioActive"
                    class="i-lucide-pause h-6 w-6"
                    aria-hidden="true"></span>
                </button>
                <button
                  type="button"
                  aria-label="15초 앞으로"
                  x-on:click="seekCloudAudioBy(15)"
                  x-bind:disabled="cloudAudioBusy || !(cloudAudioDuration > 0)"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-full border-none bg-stone-100 text-stone-700 disabled:opacity-40">
                  <span
                    class="i-lucide-rotate-cw h-5 w-5"
                    aria-hidden="true"></span>
                </button>
                <button
                  type="button"
                  aria-label="다음 챕터"
                  x-on:click="moveCloudAudioChapter(1)"
                  x-bind:disabled="cloudAudioBusy || !cloudAudioHasNext"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border-none bg-transparent text-stone-700 disabled:opacity-30">
                  <span
                    class="i-lucide-skip-forward h-5 w-5"
                    aria-hidden="true"></span>
                </button>
