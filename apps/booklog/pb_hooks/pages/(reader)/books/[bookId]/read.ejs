        class="box-border max-h-full w-full max-w-3xl shrink-0 overflow-y-auto overscroll-contain rounded-[1.75rem] border border-stone-200/80 bg-[rgba(255,255,255,0.94)] p-4 shadow-[0_24px_60px_rgba(24,19,16,0.16)]">
        <div class="mb-3 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-semibold text-stone-950">읽어주기</h2>
            <p
              x-show="currentChapterLabel"
              class="mt-1 text-sm text-stone-500"
              x-text="'현재 챕터: ' + currentChapterLabel"></p>
          </div>
          <button
            type="button"
            x-on:click="closeReadAloud()"
            aria-label="읽어주기 닫기"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border-none bg-[#f7f2e8] text-stone-700 ring-0 outline-none">
            <span
              class="i-lucide-x h-4 w-4"
              aria-hidden="true"></span>
          </button>
        </div>

        <div class="space-y-4">
          <label class="mb-4 block space-y-2">
            <span class="text-sm font-medium text-stone-700">읽어주기 방식</span>
            <select
              x-model="readAloudEngine"
              x-on:change="stopReadAloud()"
              class="box-border block w-full rounded-[1.1rem] border-0 bg-[#fbf5ec] px-4 py-3 text-sm text-[#2f251c]">
              <% if (aiAudioAvailable) { %>
              <option value="ai">AI 오디오북</option>
              <% } else { %>
              <option
                value="ai"
                disabled>
                AI 오디오북 · 생성된 음성 없음
              </option>
              <% } %>
              <option value="local">로컬 오디오북 · 기기 음성</option>
            </select>
          </label>
          <% if (aiAudioAvailable) { %>
          <div
            x-show="readAloudEngine === 'ai'"
            x-effect="if (readAloudOpen && readAloudEngine === 'ai' && !cloudAudioSession) previewCloudAudio()"
            class="space-y-3">
            <audio
              id="reader-cloud-audio"
              data-book-title="<%= bookTitle %>"
              preload="metadata"
              class="hidden"
              x-effect="$el.playbackRate = Number(readAloudRate || 1)"></audio>
            <div
              x-show="!cloudAudioSession"
              class="space-y-1">
              <button
                type="button"
                aria-label="이어 듣기"
                x-on:click="startCloudAudio()"
                x-bind:disabled="cloudAudioBusy"
                class="flex w-full items-center gap-3 rounded-[1.25rem] border-none bg-[#efe2d2] px-4 py-3 text-left text-[#5c3816] disabled:opacity-60">
                <span
                  class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#8e5521] text-white">
                  <span
                    class="i-lucide-play h-5 w-5"
                    aria-hidden="true"></span>
                </span>
                <span class="min-w-0">
                  <span class="block text-base font-semibold">이어 듣기</span>
                  <span class="flex min-w-0 text-xs text-[#8e5521]">
                    <span
                      x-show="cloudAudioResumeChapter"
                      class="min-w-0 truncate"
                      x-text="cloudAudioResumeChapter"></span>
                    <span
                      x-show="cloudAudioResumeChapter"
                      class="shrink-0 px-1"
                      aria-hidden="true">
                      ·
                    </span>
                    <span
                      x-bind:class="cloudAudioResumeChapter ? 'shrink-0' : 'min-w-0 truncate'"
                      x-text="cloudAudioResumeLabel || '마지막 청취 위치를 확인하고 있습니다'"></span>
                  </span>
                </span>
              </button>
              <button
                type="button"
                x-on:click="startCloudAudioAtReadingPosition()"
                x-bind:disabled="cloudAudioBusy"
                class="flex w-full items-center gap-3 rounded-[1.25rem] border-none bg-stone-100 px-4 py-2.5 text-left text-stone-700 disabled:opacity-60">
                <span
                  class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-[#8e5521]">
                  <span
                    class="i-lucide-book-open h-5 w-5"
                    aria-hidden="true"></span>
                </span>
                <span class="text-sm font-semibold">지금 보는 곳부터 듣기</span>
              </button>
              <details class="group">
                <summary
                  class="flex cursor-pointer list-none items-center gap-1 px-1 py-2 text-sm font-medium text-stone-600">
