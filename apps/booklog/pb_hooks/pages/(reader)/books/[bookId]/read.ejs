<script server>
  const bookTitleService = resolve('book-title')
  meta('title', '북로그 리더')
  meta('description', '북로그 EPUB 리더')

  const bookId = String(params.bookId || '').trim()
  const userId = request.auth ? String(request.auth.get('id') || '') : ''
  const nowIso = new Date().toISOString()
  let bookRecord = null
  let shelfRecord = null
  let bookFileRecord = null
  let initialShelfStatus = ''

  if (!request.auth) {
    dbg('page/books/[bookId]/read:redirect', {
      status: 303,
      redirectTo: '/auth',
      message: '로그인이 필요합니다.',
    })
    redirect('/auth', {
      status: 303,
      message: '로그인이 필요합니다.',
    })
    return
  }

  if (!bookId) {
    dbg('page/books/[bookId]/read:redirect', {
      status: 303,
      redirectTo: '/',
      message: '책 정보를 찾을 수 없습니다.',
    })
    redirect('/', {
      status: 303,
      message: '책 정보를 찾을 수 없습니다.',
    })
    return
  }

  try {
    bookRecord = $app.findFirstRecordByFilter('books', 'id = {:bookId}', { bookId: bookId })
  } catch (exception) {
    bookRecord = null
  }

  if (!bookRecord) {
    dbg('page/books/[bookId]/read:redirect', {
      status: 303,
      redirectTo: '/',
      message: '책 정보를 찾을 수 없습니다.',
      bookId: bookId,
    })
    redirect('/', {
      status: 303,
      message: '책 정보를 찾을 수 없습니다.',
    })
    return
  }

  const bookDetailPath = '/books/' + bookId
  const bookTitle = bookTitleService.getMainTitle(String(bookRecord.get('title') || '').trim())
  // 구간·조각 번호는 관리자가 재생성할 구간을 찾을 때만 필요해 관리자에게만 보여줍니다.
  const showAudioDetail = request.auth.get('admin_manager') === true

  try {
    shelfRecord = $app.findFirstRecordByFilter('book_shelves', 'user_id = {:userId} && book_id = {:bookId}', {
      userId: userId,
      bookId: bookId,
    })
  } catch (exception) {
    shelfRecord = null
  }

  if (shelfRecord) {
    const shelfStatus = String(shelfRecord.get('status') || '').trim()

    initialShelfStatus = shelfStatus

    if (shelfStatus !== 'finished' && shelfStatus !== 'reading') {
      shelfRecord.set('status', 'reading')
    }

    if (!String(shelfRecord.get('started_at') || '').trim()) {
      shelfRecord.set('started_at', nowIso)
    }

    shelfRecord.set('last_read_at', nowIso)
    $app.save(shelfRecord)
  }

  const shelfBookFileId = shelfRecord ? String(shelfRecord.get('book_file_id') || '').trim() : ''

  if (shelfBookFileId) {
    try {
      bookFileRecord = $app.findFirstRecordByFilter('book_files', 'id = {:bookFileId}', {
        bookFileId: shelfBookFileId,
      })
    } catch (exception) {
      bookFileRecord = null
    }
  }

  const storedFileName = bookFileRecord ? String(bookFileRecord.get('stored_file') || '').trim() : ''
  const bookFileId = bookFileRecord ? String(bookFileRecord.get('id') || '').trim() : ''
  const bookFileHash = bookFileRecord ? String(bookFileRecord.get('file_hash') || '').trim() : ''
  const epubReaderUrl =
    bookFileRecord && storedFileName ? '/xapi/books/' + encodeURIComponent(bookId) + '/read-file' : ''

  if (!epubReaderUrl) {
    dbg('page/books/[bookId]/read:redirect', {
      status: 303,
      redirectTo: bookDetailPath,
      message: 'EPUB 파일을 찾을 수 없습니다.',
      bookId: bookId,
    })
    redirect(bookDetailPath, {
      status: 303,
      message: 'EPUB 파일을 찾을 수 없습니다.',
    })
    return
  }

  let aiAudioAvailable = false

  try {
    const audioJob = resolve('book-audio-data').findFileJob($app, bookFileId)
    aiAudioAvailable = !!audioJob && Number(audioJob.get('ready_chunks') || 0) > 0
  } catch (exception) {
    warn('page/books/[bookId]/read:audio-unavailable', {
      bookId: bookId,
      error: String(exception.message || exception),
    })
  }
</script>

