<button
  type="button"
  x-data="{ copied: false }"
  x-on:click="navigator.clipboard.writeText($el.dataset.copyText).then(function () { copied = true; setTimeout(function () { copied = false }, 1500) }).catch(function () {})"
  data-copy-text="<%= title %>"
  aria-label="도서명 복사"
  x-bind:aria-label="copied ? '도서명을 복사했습니다' : '도서명 복사'"
  class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-none bg-stone-100 text-stone-500 ring-0 transition outline-none hover:text-stone-800">
  <span
    x-show="!copied"
    class="i-lucide-copy h-3.5 w-3.5"
    aria-hidden="true"></span>
  <span
    x-show="copied"
    x-cloak
    class="i-lucide-check h-3.5 w-3.5 text-emerald-600"
    aria-hidden="true"></span>
</button>
