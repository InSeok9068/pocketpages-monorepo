<div
  id="popular-list"
  class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
  <% for (let index = 0; index < books.length; index += 1) { const book = books[index]; const ownedBookId = shelfBookIds[book.isbn13] || ''; const bookHref = ownedBookId ? '/books/' + ownedBookId + '?from=' + encodeURIComponent(fromPath) : book.detailUrl %>
  <div
    data-popular-book
    class="group mx-auto w-full max-w-[8rem] min-w-0 text-stone-900 sm:max-w-none">
    <a
      href="<%= bookHref %>"
      <% if (!ownedBookId) { %>target="_blank"
      rel="noopener noreferrer"
      <% } %>
      tabindex="-1"
      aria-hidden="true"
      class="block no-underline">
      <div
        class="relative aspect-[2/3] overflow-hidden rounded-[0.35rem] bg-gradient-to-b from-[#d8c3a5] to-[#b08968] shadow-[0_8px_18px_rgba(24,19,16,0.1)] transition group-hover:translate-y-[-1px] group-hover:shadow-[0_10px_20px_rgba(24,19,16,0.13)]">
        <% if (book.coverUrl) { %>
        <img
          src="<%= book.coverUrl %>"
          alt=""
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class="h-full w-full object-cover" />
        <% } else { %>
        <div class="absolute inset-0 box-border flex items-center justify-center px-3 text-center text-white">
          <p class="m-0 line-clamp-3 text-sm leading-5 font-semibold break-keep"><%= book.title %></p>
        </div>
        <% } %>
        <span
          class="absolute top-1.5 left-1.5 inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-stone-950/80 px-1.5 text-[12px] font-semibold text-white">
          <%= index + 1 %>
        </span>
        <% if (ownedBookId) { %>
        <span
          class="absolute right-1.5 bottom-1.5 inline-flex items-center rounded-full bg-white/92 px-2 py-0.5 text-[11px] font-semibold text-stone-800">
          도서함에 있음
        </span>
        <% } %>
      </div>
    </a>
    <div class="mt-3 min-w-0 space-y-1">
      <div class="flex items-start gap-1">
        <a
          href="<%= bookHref %>"
          <% if (!ownedBookId) { %>target="_blank"
          rel="noopener noreferrer"
          <% } %>
          data-book-link
          class="min-w-0 flex-1 text-stone-950 no-underline">
          <h3 class="m-0 line-clamp-2 text-sm leading-5 font-semibold break-words"><%= book.title %></h3>
          <% if (ownedBookId) { %>
          <span class="sr-only">도서함에 있음</span>
          <% } %>
        </a>
        <%- include('copy-title-button.ejs', { title: book.title }) %>
      </div>
      <% if (book.author) { %>
      <p class="m-0 truncate text-[12px] leading-5 font-medium text-stone-500"><%= book.author %></p>
      <% } %>
      <% if (book.loanCount) { %>
      <p class="m-0 text-[11px] leading-4 text-stone-400">대출 <%= book.loanCountText %>회</p>
      <% } %>
    </div>
  </div>
  <% } %>
</div>
