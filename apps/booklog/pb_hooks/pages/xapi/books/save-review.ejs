<script server>
  if (request.method !== 'POST') {
    dbg('xapi/books/save-review:redirect', {
      status: 303,
      redirectTo: '/',
      message: '잘못된 요청입니다.',
    })
    redirect('/', {
      status: 303,
      message: '잘못된 요청입니다.',
    })
    return
  }

  if (!request.auth) {
    dbg('xapi/books/save-review:redirect', {
      status: 303,
      redirectTo: '/auth',
      message: '로그인이 필요합니다.',
    })
    redirect('/auth', {
      status: 303,
      message: '로그인이 필요합니다.',
    })
    return
  }

  const form = body()
  const userId = String(request.auth.get('id') || '')
  const bookId = String(form.bookId || '').trim()
  const fromPath = resolve('book-navigation').getBackHref(form.from)
  const bookDetailPath = '/books/' + bookId + '?from=' + encodeURIComponent(fromPath)
  const reviewText = String(form.reviewText || '').trim()
  const nowIso = new Date().toISOString()
  let errorMessage = ''

  dbg('xapi/books/save-review:start', {
    userId: userId,
    bookId: bookId,
  })

  try {
    if (!bookId) throw new Error('책 정보가 필요합니다.')
    if (!reviewText) throw new Error('감상평을 입력해주세요.')

    const bookRecord = $app.findFirstRecordByFilter('books', 'id = {:bookId}', { bookId: bookId })
    let shelfRecord = null
    let reviewRecord = null

    try {
      shelfRecord = $app.findFirstRecordByFilter('book_shelves', 'user_id = {:userId} && book_id = {:bookId}', {
        userId: userId,
        bookId: bookId,
      })
    } catch (exception) {
      shelfRecord = null
    }

    if (!shelfRecord) throw new Error('내 도서함에 있는 책만 감상평을 남길 수 있습니다.')

    function findReview() {
      try {
        return $app.findFirstRecordByFilter('book_reviews', 'user_id = {:userId} && book_id = {:bookId}', {
          userId: userId,
          bookId: bookId,
        })
      } catch (exception) {
        return null
      }
    }

    function writeReview(record) {
      record.set('user_id', userId)
      record.set('book_id', String(bookRecord.get('id') || ''))
      record.set('visibility', 'private')
      record.set('review_text', reviewText)
      record.set('reviewed_at', nowIso)
      record.set('shelf_id', String(shelfRecord.get('id') || ''))
      $app.save(record)
    }

    reviewRecord = findReview()

    if (reviewRecord) {
      writeReview(reviewRecord)
    } else {
      try {
        writeReview(new Record($app.findCollectionByNameOrId('book_reviews')))
      } catch (saveException) {
        // 두 번 누른 저장 중 다른 요청이 먼저 만들었으면, 유니크 충돌 대신 그 감상평을 갱신합니다.
        reviewRecord = findReview()
        if (!reviewRecord) throw saveException
        info('xapi/books/save-review:concurrent-create', { userId: userId, bookId: bookId })
        writeReview(reviewRecord)
      }
    }

    dbg('xapi/books/save-review:redirect', {
      status: 303,
      redirectTo: bookDetailPath,
      message: '감상평을 저장했습니다.',
    })
    redirect(bookDetailPath, {
      status: 303,
      message: '감상평을 저장했습니다.',
    })
    return
  } catch (exception) {
    errorMessage = String(exception.message || exception)
    error('xapi/books/save-review:failed', {
      userId: userId,
      bookId: bookId,
      error: errorMessage,
    })
  }

  dbg('xapi/books/save-review:redirect', {
    status: 303,
    redirectTo: bookId ? bookDetailPath : '/',
    error: errorMessage || '감상평 저장에 실패했습니다.',
  })
  redirect(bookId ? bookDetailPath : '/', {
    status: 303,
    message: errorMessage || '감상평 저장에 실패했습니다.',
  })
  return
</script>
