<script server>
  const epubReadingMetrics = resolve('epub-reading-metrics')
  const MAX_EPUB_BYTES = 1024 * 1024 * 100

  if (request.method !== 'POST') {
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: '/',
      message: '잘못된 요청입니다.',
    })
    redirect('/', {
      status: 303,
      message: '잘못된 요청입니다.',
    })
    return
  }

  if (!request.auth) {
    warn('xapi/books/recalculate-page-count:unauthorized', {})
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: '/auth',
      message: '로그인이 필요합니다.',
    })
    redirect('/auth', {
      status: 303,
      message: '로그인이 필요합니다.',
    })
    return
  }

  const userId = String(request.auth.get('id') || '')
  const form = body()
  const bookId = String(form.bookId || '').trim()
  const bookDetailPath = bookId ? '/books/' + encodeURIComponent(bookId) : '/'

  dbg('xapi/books/recalculate-page-count:start', {
    userId: userId,
    bookId: bookId,
  })

  if (!bookId) {
    warn('xapi/books/recalculate-page-count:missing-book', {
      userId: userId,
    })
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: '/',
      message: '책 정보가 필요합니다.',
    })
    redirect('/', {
      status: 303,
      message: '책 정보가 필요합니다.',
    })
    return
  }

  let shelfRecord = null

  try {
    shelfRecord = $app.findFirstRecordByFilter('book_shelves', 'user_id = {:userId} && book_id = {:bookId}', {
      userId: userId,
      bookId: bookId,
    })
  } catch (exception) {
    shelfRecord = null
  }

  if (!shelfRecord) {
    warn('xapi/books/recalculate-page-count:shelf-not-found', {
      userId: userId,
      bookId: bookId,
    })
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: '/',
      message: '내 도서함에서 책을 찾을 수 없습니다.',
      bookId: bookId,
    })
    redirect('/', {
      status: 303,
      message: '내 도서함에서 책을 찾을 수 없습니다.',
    })
    return
  }

  let bookRecord = null

  try {
    bookRecord = $app.findFirstRecordByFilter('books', 'id = {:bookId}', {
      bookId: bookId,
    })
  } catch (exception) {
    bookRecord = null
  }

  if (!bookRecord) {
    warn('xapi/books/recalculate-page-count:book-not-found', {
      userId: userId,
      bookId: bookId,
    })
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: '/',
      message: '책 정보를 찾을 수 없습니다.',
      bookId: bookId,
    })
    redirect('/', {
      status: 303,
      message: '책 정보를 찾을 수 없습니다.',
    })
    return
  }

  const currentPageCount = Number(bookRecord.get('estimated_page_count') || 0)

  if (currentPageCount > 0) {
    dbg('xapi/books/recalculate-page-count:already-calculated', {
      userId: userId,
      bookId: bookId,
      estimatedPageCount: currentPageCount,
    })
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: bookDetailPath,
      message: '페이지 정보가 이미 있습니다.',
      bookId: bookId,
    })
    redirect(bookDetailPath, {
      status: 303,
      message: '페이지 정보가 이미 있습니다.',
    })
    return
  }

  const bookFileId = String(shelfRecord.get('book_file_id') || '').trim()
  let bookFileRecord = null

  if (bookFileId) {
    try {
      bookFileRecord = $app.findFirstRecordByFilter(
        'book_files',
        'id = {:bookFileId} && book_id = {:bookId}',
        {
          bookFileId: bookFileId,
          bookId: bookId,
        }
      )
    } catch (exception) {
      bookFileRecord = null
    }
  }

  const storedFileName = bookFileRecord ? String(bookFileRecord.get('stored_file') || '').trim() : ''

  if (!bookFileRecord || !storedFileName) {
    warn('xapi/books/recalculate-page-count:file-not-found', {
      userId: userId,
      bookId: bookId,
      bookFileId: bookFileId,
    })
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: bookDetailPath,
      message: '계산할 EPUB 파일을 찾을 수 없습니다.',
      bookId: bookId,
    })
    redirect(bookDetailPath, {
      status: 303,
      message: '계산할 EPUB 파일을 찾을 수 없습니다.',
    })
    return
  }

  const fileSize = Number(bookFileRecord.get('file_size') || 0)

  if (fileSize <= 0 || fileSize > MAX_EPUB_BYTES) {
    warn('xapi/books/recalculate-page-count:invalid-file-size', {
      userId: userId,
      bookId: bookId,
      bookFileId: bookFileId,
      fileSize: fileSize,
    })
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: bookDetailPath,
      message: 'EPUB 파일 크기를 확인할 수 없습니다.',
      bookId: bookId,
    })
    redirect(bookDetailPath, {
      status: 303,
      message: 'EPUB 파일 크기를 확인할 수 없습니다.',
    })
    return
  }

  const storageFileKey = String(bookFileRecord.baseFilesPath() || '') + '/' + storedFileName
  let readingMetrics = null

  try {
    const fsys = $app.newFilesystem()
    let fileReader = null

    try {
      fileReader = fsys.getReader(storageFileKey)
      fileReader.seek(0, 0)
      const epubBytes = new Uint8Array(toBytes(fileReader, fileSize))

      if (epubBytes.length !== fileSize) {
        throw new Error('EPUB 파일을 모두 읽지 못했습니다.')
      }

      readingMetrics = epubReadingMetrics.buildReadingMetricsFromBytes(epubBytes)
    } finally {
      if (fileReader) {
        fileReader.close()
      }

      fsys.close()
    }
  } catch (exception) {
    error('xapi/books/recalculate-page-count:failed', {
      userId: userId,
      bookId: bookId,
      bookFileId: bookFileId,
      error: String(exception.message || exception),
    })
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: bookDetailPath,
      error: '페이지 수를 다시 계산하지 못했습니다.',
      bookId: bookId,
    })
    redirect(bookDetailPath, {
      status: 303,
      message: '페이지 수를 다시 계산하지 못했습니다.',
    })
    return
  }

  if (!readingMetrics || readingMetrics.estimatedPageCount <= 0) {
    warn('xapi/books/recalculate-page-count:no-readable-text', {
      userId: userId,
      bookId: bookId,
      bookFileId: bookFileId,
      textCharCount: readingMetrics ? readingMetrics.textCharCount : 0,
    })
    dbg('xapi/books/recalculate-page-count:redirect', {
      status: 303,
      redirectTo: bookDetailPath,
      message: 'EPUB 본문에서 읽을 수 있는 텍스트를 찾지 못했습니다.',
      bookId: bookId,
    })
    redirect(bookDetailPath, {
      status: 303,
      message: 'EPUB 본문에서 읽을 수 있는 텍스트를 찾지 못했습니다.',
    })
    return
  }

  dbg('xapi/books/recalculate-page-count:save-start', {
    userId: userId,
    bookId: bookId,
    bookFileId: bookFileId,
    textCharCount: readingMetrics.textCharCount,
    estimatedPageCount: readingMetrics.estimatedPageCount,
  })

  bookRecord.set('estimated_page_count', readingMetrics.estimatedPageCount)
  $app.save(bookRecord)

  info('xapi/books/recalculate-page-count:success', {
    userId: userId,
    bookId: bookId,
    bookFileId: bookFileId,
    textCharCount: readingMetrics.textCharCount,
    estimatedPageCount: readingMetrics.estimatedPageCount,
  })

  dbg('xapi/books/recalculate-page-count:redirect', {
    status: 303,
    redirectTo: bookDetailPath,
    message: '페이지 수를 다시 계산했습니다.',
    bookId: bookId,
    estimatedPageCount: readingMetrics.estimatedPageCount,
  })
  redirect(bookDetailPath, {
    status: 303,
    message: '페이지 수를 다시 계산했습니다.',
  })
  return
</script>
