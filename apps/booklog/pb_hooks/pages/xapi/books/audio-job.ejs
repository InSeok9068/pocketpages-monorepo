<script server>
  /**
   * 결과 메시지와 함께 책 상세로 돌아갑니다.
   * @param {string} redirectTo 이동할 경로
   * @param {string} message 안내 메시지
   */
  function redirectWithMessage(redirectTo, message) {
    dbg('xapi/books/audio-job:redirect', { status: 303, redirectTo, message })
    redirect(redirectTo, { status: 303, message })
  }

  if (request.method !== 'POST') {
    redirectWithMessage('/', '잘못된 요청입니다.')
    return
  }
  if (!request.auth) {
    redirectWithMessage('/auth', '로그인이 필요합니다.')
    return
  }
  const userId = String(request.auth.get('id') || '')
  const form = body()
  const bookId = String(form.bookId || '').trim()
  const fileId = String(form.fileId || '').trim()
  const action = String(form.action || '')
  const bookDetailPath = bookId ? '/books/' + encodeURIComponent(bookId) : '/'
  dbg('xapi/books/audio-job:start', { userId, bookId, fileId, action })
  if (request.auth.get('admin_manager') !== true) {
    warn('xapi/books/audio-job:forbidden', { userId, bookId })
    redirectWithMessage(bookDetailPath, 'AI 오디오북 생성 권한이 없습니다.')
    return
  }
  if (!bookId || !fileId || ['start', 'pause', 'delete'].indexOf(action) < 0) {
    redirectWithMessage(bookDetailPath, '요청 정보를 확인해 주세요.')
    return
  }
  const audioData = resolve('book-audio-data')
  const jobService = resolve('book-audio-job-service')
  try {
    audioData.findAuthorizedFile($app, userId, bookId, fileId)
    $app.findCollectionByNameOrId('book_audio_jobs')
  } catch (_exception) {
    warn('xapi/books/audio-job:file-or-schema-missing', { userId, bookId, fileId })
    redirectWithMessage(bookDetailPath, '내 도서함의 EPUB 파일 또는 오디오북 스키마를 찾지 못했습니다.')
    return
  }
  let message = ''
  try {
    if (action === 'start') {
      const model = String(form.model || audioData.DEFAULT_MODEL).trim()
      if (!audioData.isSupportedModel(model)) {
        redirectWithMessage(bookDetailPath, 'TTS 모델을 확인해 주세요.')
        return
      }
      const result = jobService.requestJob($app, fileId, userId, audioData.getSettings(model))
      if (result.message) {
        dbg('xapi/books/audio-job:reservation', { userId, fileId, model, accepted: !!result.job })
        redirectWithMessage(bookDetailPath, result.message)
        return
      }
      info('xapi/books/audio-job:requested', { userId, fileId, model, jobId: String(result.job.get('id')) })
      message = 'AI 오디오북 생성을 예약했습니다. 2분 안에 책을 분석해 생성을 시작합니다.'
    } else if (action === 'delete') {
      const deleted = jobService.deleteAudioBook($app, fileId)
      info('xapi/books/audio-job:deleted', { userId, fileId, deleted })
      message = deleted.chunks + deleted.jobs > 0 ? 'AI 오디오북을 삭제했습니다.' : '삭제할 AI 오디오북이 없습니다.'
    } else {
      const settings = audioData.getFileSettings($app, fileId)
      const paused = jobService.pauseJob($app, fileId, settings.configHash)
      info('xapi/books/audio-job:paused', { userId, fileId, paused })
      message = paused ? 'AI 오디오북 생성을 일시 정지했습니다.' : '진행 중인 AI 오디오북 생성이 없습니다.'
    }
  } catch (exception) {
    error('xapi/books/audio-job:failed', { userId, fileId, action, error: String(exception.message || exception) })
    message = 'AI 오디오북 작업을 처리하지 못했습니다.'
  }
  redirectWithMessage(bookDetailPath, message)
</script>
