<script server>
  response.header('Cache-Control', 'no-store')
  if (request.method !== 'GET') {
    response.json(405, { ok: false, message: 'GET 요청만 가능합니다.' })
    return
  }
  if (!request.auth) {
    response.json(401, { ok: false, message: '로그인이 필요합니다.' })
    return
  }
  const query = request.url.query
  const userId = String(request.auth.get('id') || '')
  const bookId = String(query.bookId || '')
  const fileId = String(query.fileId || '')
  const sectionInput = String(query.sectionIndex == null ? '' : query.sectionIndex).trim()
  const chunkInput = String(query.chunkIndex == null ? '' : query.chunkIndex).trim()
  const sectionIndex = Number(sectionInput)
  const chunkIndex = Number(chunkInput)
  if (
    !bookId
    || !fileId
    || !sectionInput
    || !chunkInput
    || !Number.isSafeInteger(sectionIndex)
    || sectionIndex < 0
    || !Number.isSafeInteger(chunkIndex)
    || chunkIndex < 0
  ) {
    response.json(400, { ok: false, message: '챕터와 구간 정보를 확인해 주세요.' })
    return
  }
  const audioData = resolve('book-audio-data')
  try {
    audioData.findAuthorizedFile($app, userId, bookId, fileId)
  } catch (_exception) {
    response.json(404, { ok: false, message: '내 서재에서 EPUB 파일을 찾지 못했습니다.' })
    return
  }
  try {
    const settings = audioData.getSettings(String(env('BOOKLOG_TTS_MODEL') || 'gemini-3.8-flash-tts').trim())
    const chunk = audioData.findReadyChunk($app, fileId, settings.configHash, sectionIndex, chunkIndex)
    if (!chunk) {
      dbg('api/books/audio-chunk:not-ready', { userId, fileId, sectionIndex, chunkIndex })
      response.json(404, { ok: false, message: '이 구간은 아직 AI 오디오북이 생성되지 않았습니다.' })
      return
    }
    const chunkCount = audioData.countSectionChunks($app, fileId, settings.configHash, sectionIndex)
    const nextSectionIndex = audioData.findNextSectionIndex($app, fileId, settings.configHash, sectionIndex)
    dbg('api/books/audio-chunk:found', { userId, fileId, sectionIndex, chunkIndex, chunkCount, nextSectionIndex })
    response.json(200, Object.assign({ ok: true }, audioData.chunkView(chunk, bookId, chunkCount, nextSectionIndex)))
  } catch (exception) {
    error('api/books/audio-chunk:failed', { userId, fileId, error: String(exception.message || exception) })
    response.json(500, { ok: false, message: 'AI 오디오북 구간을 불러오지 못했습니다.' })
  }
</script>
