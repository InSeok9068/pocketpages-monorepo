<script server>
  response.header('Cache-Control', 'no-store')
  if (request.method !== 'GET' && request.method !== 'POST') {
    response.json(405, { ok: false, message: 'GET 또는 POST 요청만 가능합니다.' })
    return
  }
  if (!request.auth) {
    response.json(401, { ok: false, message: '로그인이 필요합니다.' })
    return
  }
  const input = request.method === 'GET' ? request.url.query : body()
  const userId = String(request.auth.get('id'))
  const bookId = String(input.bookId || '')
  const fileId = String(input.fileId || '')
  const audioData = resolve('book-audio-data')
  try {
    audioData.findAuthorizedFile($app, userId, bookId, fileId)
  } catch (_exception) {
    response.json(404, { ok: false, message: '내 서재에서 EPUB 파일을 찾지 못했습니다.' })
    return
  }
  try {
    $app.findCollectionByNameOrId('book_audio_progress')
  } catch (_exception) {
    response.json(503, { ok: false, message: '오디오북 스키마를 관리자에서 먼저 import해 주세요.' })
    return
  }
  try {
    const settings = audioData.getFileSettings($app, fileId)
    const completeAudio = audioData.getCompleteView($app, fileId, settings.configHash, bookId)
    const bindings = { userId, fileId, configHash: settings.configHash }
    const filter = 'user_id = {:userId} && file_id = {:fileId} && config_hash = {:configHash}'
    if (request.method === 'GET') {
      const progress = $app.findRecordsByFilter(
        'book_audio_progress',
        filter,
        '-last_listened_at,-updated',
        1,
        0,
        bindings
      )[0]
      let sectionIndex = progress ? Number(progress.get('section_index')) : 0
      let chunkIndex = progress ? Number(progress.get('chunk_index')) : 0
      let seconds = progress ? Number(progress.get('position_seconds')) : 0
      let isCompleted = progress ? !!progress.get('is_completed') : false
      let startsNextSection = false
      if (isCompleted) {
        const nextSectionIndex = audioData.findNextSectionIndex($app, fileId, settings.configHash, sectionIndex)
        if (nextSectionIndex >= 0) {
          sectionIndex = nextSectionIndex
          chunkIndex = 0
          seconds = 0
          isCompleted = false
          startsNextSection = true
        }
      }
      if (progress && !progress.get('is_completed')) {
        // 구간 끝까지 들은 위치는 다음 구간 처음으로 복원합니다.
        const previous = $app.findRecordsByFilter(
          'book_audio_chunks',
          'id = {:chunkId} && file_id = {:fileId}',
          '',
          1,
          0,
          { chunkId: String(progress.get('audio_chunk_id')), fileId }
        )[0]
        const duration =
          !completeAudio && previous && Number(previous.get('duration_seconds')) > 0
            ? Number(previous.get('duration_seconds'))
            : audioData.sectionTimeline($app, fileId, settings.configHash, sectionIndex)[chunkIndex] || 0
        if (duration > 0 && seconds >= duration) {
          const chunkCount = audioData.countSectionChunks($app, fileId, settings.configHash, sectionIndex)
          if (chunkIndex + 1 < chunkCount) {
            chunkIndex += 1
            seconds = 0
          }
        }
      }
      if (progress) {
        // 다시 시작하며 구간을 새로 나누면 저장된 챕터·구간이 없어질 수 있어, 남아 있는 가장 가까운 위치로 맞춥니다.
        const chunkCount = audioData.countSectionChunks($app, fileId, settings.configHash, sectionIndex)
        if (chunkCount === 0) {
          const order = audioData.readSectionOrder($app, fileId, settings.configHash)
          const later = order.filter(function (index) {
            return index > sectionIndex
          })
          if (order.length) {
            sectionIndex = later.length ? later[0] : order[order.length - 1]
            chunkIndex = 0
            seconds = 0
          }
        } else if (chunkIndex >= chunkCount) {
          chunkIndex = chunkCount - 1
          seconds = 0
        }
      }
      const chapterSeconds = progress
        ? audioData
            .sectionTimeline($app, fileId, settings.configHash, sectionIndex)
            .slice(0, chunkIndex)
            .reduce(function (total, length) {
              return total + length
            }, seconds)
        : 0
      dbg('api/books/audio-progress:load', { userId, fileId, found: !!progress })
      response.json(200, {
        ok: true,
        configHash: settings.configHash,
        completeAudio,
        progress: progress
          ? { sectionIndex, chunkIndex, seconds, chapterSeconds, isCompleted, startsNextSection }
          : null,
      })
      return
    }
    const savedConfigHash = String(input.configHash || '')
    if (!/^[a-f0-9]{64}$/.test(savedConfigHash)) {
      response.json(400, { ok: false, message: '낭독 설정 정보를 확인해 주세요.' })
      return
    }
    const chunkId = String(input.chunkId || '')
    const seconds = Number(input.seconds)
    const completed = String(input.isCompleted) === 'true'
    const restart = String(input.restart) === 'true'
    // 기기에 보관했다가 늦게 다시 보낸 저장이 더 최근 위치를 덮지 않도록, 실제로 들은 시각(서버 시각 이하)을 씁니다.
    const sentAt = Date.parse(String(input.listenedAt || ''))
    const listenedAt = new Date(isFinite(sentAt) ? Math.min(sentAt, Date.now()) : Date.now()).toISOString()
    if (!chunkId || !isFinite(seconds) || seconds < 0) {
      response.json(400, { ok: false, message: '청취 위치를 확인해 주세요.' })
      return
    }
    const storedRecord = $app.findRecordsByFilter(
      'book_audio_chunks',
      // 생성 중인 구간도 기기 음성으로 들을 수 있어, 상태와 관계없이 원래 구간이면 위치를 저장합니다.
      "id = {:chunkId} && file_id = {:fileId} && config_hash = {:configHash} && split_path = ''",
      '',
      1,
      0,
      { chunkId, fileId, configHash: savedConfigHash }
    )[0]
    const storedChunk = !!storedRecord
    const archived =
      completeAudio && savedConfigHash === settings.configHash
        ? completeAudio.parts.filter(function (p) {
            return p.chunkId === chunkId
          })
        : []
    const chunk =
      storedRecord
      || (archived.length
        ? audioData.findChunk($app, fileId, savedConfigHash, archived[0].sectionIndex, archived[0].chunkIndex)
        : null)
    if (!chunk) {
      response.json(409, { ok: false, message: '청취하던 음성 구간이 변경됐습니다. 현재 저장된 위치로 이어 듣습니다.' })
      return
    }
    const sectionIndex = Number(chunk.get('section_index'))
    const chunkIndex = Number(chunk.get('chunk_index'))
    const duration = archived.length
      ? archived[archived.length - 1].endSeconds - archived[0].startSeconds
      : Number(chunk.get('duration_seconds') || 0)
    const chunkCount = audioData.countSectionChunks($app, fileId, savedConfigHash, sectionIndex)
    // 구간 구성이 바뀐 뒤 늦게 도착한 완료 저장은 위치만 남기고, 거절해서 재생 시작을 막지 않습니다.
    const markCompleted = completed && chunkIndex === chunkCount - 1
    if (completed && !markCompleted) {
      warn('api/books/audio-progress:completion-ignored', { userId, fileId, chunkId, chunkIndex, chunkCount })
    }
    $app.runInTransaction(function (txApp) {
      const progressBindings = { userId, fileId, configHash: savedConfigHash, sectionIndex }
      let progress = txApp.findRecordsByFilter(
        'book_audio_progress',
        filter + ' && section_index = {:sectionIndex}',
        '',
        1,
        0,
        progressBindings
      )[0]
      // 다른 탭의 늦은 일반 저장이 완료 기록을 취소하지 않도록 합니다.
      if (progress && progress.get('is_completed') && !restart && !markCompleted) return
      if (
        progress
        && !markCompleted
        && Date.parse(String(progress.get('last_listened_at')).replace(' ', 'T')) > Date.parse(listenedAt)
      ) {
        return
      }
      if (!progress) progress = new Record(txApp.findCollectionByNameOrId('book_audio_progress'))
      progress.set('user_id', userId)
      progress.set('file_id', fileId)
      progress.set('config_hash', savedConfigHash)
      progress.set('section_index', sectionIndex)
      progress.set('chunk_index', chunkIndex)
      progress.set('audio_chunk_id', storedChunk ? chunkId : '')
      progress.set('position_seconds', duration > 0 ? Math.min(seconds, duration) : seconds)
      progress.set('is_completed', markCompleted)
      progress.set('last_listened_at', listenedAt)
      txApp.save(progress)
    })
    dbg('api/books/audio-progress:saved', { userId, fileId, chunkId, completed: markCompleted })
    response.json(200, { ok: true })
  } catch (exception) {
    error('api/books/audio-progress:failed', { userId, fileId, error: String(exception.message || exception) })
    response.json(500, { ok: false, message: '청취 위치를 동기화하지 못했습니다. 다시 시도해 주세요.' })
  }
</script>
