<script server>
  meta('title', '북로그 책 상세')
  meta('description', '북로그 책 상세 페이지')

  const { dateutil } = require('@pocketpages/utils')
  const bookTitleService = resolve('book-title')
  const bookAuthorView = resolve('book-author-view')
  const flashMessage = params.__flash ? String(params.__flash) : ''
  const bookId = String(params.bookId || '').trim()
  const userId = request.auth ? String(request.auth.get('id') || '') : ''
  const bookBackHref = resolve('book-navigation').getBackHref(request.url.query.from)
  const backSource = bookBackHref.split('?')[0]
  let bookBackLabel = '메인으로'
  const shelfStatusLabels = {
    queued: '읽을 예정',
    reading: '읽는 중',
    finished: '완독',
    dropped: '중단함',
  }

  if (backSource === '/library') {
    bookBackLabel = '도서함으로'
  }

  if (backSource === '/reviews') {
    bookBackLabel = '감상평으로'
  }

  if (backSource === '/highlights') {
    bookBackLabel = '문구로'
  }

  if (!request.auth) {
    dbg('page/books/[bookId]:redirect', {
      status: 303,
      redirectTo: '/auth',
      message: '로그인이 필요합니다.',
    })
    redirect('/auth', {
      status: 303,
      message: '로그인이 필요합니다.',
    })
    return
  }

  if (!bookId) {
    dbg('page/books/[bookId]:redirect', {
      status: 303,
      redirectTo: '/',
      message: '책 정보를 찾을 수 없습니다.',
    })
    redirect('/', {
      status: 303,
      message: '책 정보를 찾을 수 없습니다.',
    })
    return
  }

  let bookRecord = null
  let shelfRecord = null
  let reviewRecord = null
  let bookFileRecord = null
  let highlightRecords = []
  let highlightCards = []
  let readingDurationSeconds = 0

  try {
    bookRecord = $app.findFirstRecordByFilter('books', 'id = {:bookId}', { bookId: bookId })
  } catch (exception) {
    bookRecord = null
  }

  if (!bookRecord) {
    dbg('page/books/[bookId]:redirect', {
      status: 303,
      redirectTo: '/',
      message: '책 정보를 찾을 수 없습니다.',
      bookId: bookId,
    })
    redirect('/', {
      status: 303,
      message: '책 정보를 찾을 수 없습니다.',
    })
    return
  }

  const title = String(bookRecord.get('title') || '제목 없음')
  const mainTitle = bookTitleService.getMainTitle(title)
  const subtitle = bookTitleService.getSubtitle(title)

  const author = bookAuthorView.formatDisplayAuthor(String(bookRecord.get('author') || '').trim())
  const publicationDate = String(bookRecord.get('publication_date') || '').trim()
  const publicationYear = String(bookRecord.get('publication_year') || '').trim()
  const publisher = String(bookRecord.get('publisher') || '').trim()
  const estimatedPageCount = Number(bookRecord.get('estimated_page_count') || 0)
  const bookImageUrl = String(bookRecord.get('book_image_url') || '').trim()
  const metadataJsonState = new DynamicModel({ isMissing: 0 })
  $app
    .db()
    .newQuery(
      `
      SELECT CASE
        WHEN metadata_json IS NULL THEN 1
        WHEN TRIM(CAST(metadata_json AS TEXT)) = '' THEN 1
        WHEN LOWER(TRIM(CAST(metadata_json AS TEXT))) = 'null' THEN 1
        ELSE 0
      END AS isMissing
      FROM books
      WHERE id = {:bookId}`
    )
    .bind({ bookId: bookId })
    .one(metadataJsonState)
  const shouldShowMetadataRefreshButton = Number(metadataJsonState.isMissing) === 1

  try {
    shelfRecord = $app.findFirstRecordByFilter('book_shelves', 'user_id = {:userId} && book_id = {:bookId}', {
      userId: userId,
      bookId: bookId,
    })
  } catch (exception) {
    shelfRecord = null
  }

  const shelfStatus = shelfRecord ? String(shelfRecord.get('status') || 'queued') : 'queued'
  const shelfBookFileId = shelfRecord ? String(shelfRecord.get('book_file_id') || '').trim() : ''
  const progressPercentValue = shelfRecord ? shelfRecord.get('progress_percent') : null
  const progressPercentNumber = Number(progressPercentValue)
  const readingProgressPercent =
    progressPercentValue === null || typeof progressPercentValue === 'undefined' || isNaN(progressPercentNumber)
      ? null
      : Math.max(0, Math.min(100, Math.round(progressPercentNumber)))
  const hasReadingProgress =
    readingProgressPercent !== null
    && (readingProgressPercent > 0 || shelfStatus === 'reading' || shelfStatus === 'finished')
  const readingProgressText = hasReadingProgress ? readingProgressPercent + '%' : ''

  try {
    const readingSummary = new DynamicModel({ totalSeconds: 0 })
    $app
      .db()
      .newQuery(
        `SELECT COALESCE(SUM(duration_seconds), 0) AS totalSeconds
        FROM reading_sessions
        WHERE user_id = {:userId} AND book_id = {:bookId} AND duration_seconds > 0`
      )
      .bind({ userId: userId, bookId: bookId })
      .one(readingSummary)
    readingDurationSeconds = Number(readingSummary.totalSeconds || 0)
  } catch (exception) {
    readingDurationSeconds = 0
  }

  const readingDurationMinutes = Math.round(readingDurationSeconds / 60)

  try {
    reviewRecord = $app.findFirstRecordByFilter('book_reviews', 'user_id = {:userId} && book_id = {:bookId}', {
      userId: userId,
      bookId: bookId,
    })
  } catch (exception) {
    reviewRecord = null
  }

  const reviewText = reviewRecord ? String(reviewRecord.get('review_text') || '') : ''

  if (shelfBookFileId) {
    try {
      bookFileRecord = $app.findFirstRecordByFilter('book_files', 'id = {:bookFileId}', {
        bookFileId: shelfBookFileId,
      })
    } catch (exception) {
      bookFileRecord = null
    }
  }

  const storedFileName = bookFileRecord ? String(bookFileRecord.get('stored_file') || '').trim() : ''
  const bookFileUrl =
    bookFileRecord && storedFileName
      ? '/api/files/'
        + encodeURIComponent(String(bookFileRecord.collection().name || 'book_files'))
        + '/'
        + encodeURIComponent(String(bookFileRecord.get('id') || ''))
        + '/'
        + encodeURIComponent(storedFileName)
      : ''
  const downloadFileUrl =
    bookFileRecord && storedFileName ? '/xapi/books/' + encodeURIComponent(bookId) + '/download-file' : ''
  const audioJobFileId = bookFileRecord && storedFileName ? String(bookFileRecord.get('id') || '') : ''
  const showAudioJob = request.auth.get('admin_manager') === true && !!audioJobFileId
  let hasCompletedAudio = false
  if (audioJobFileId) {
    try {
      const audioBadgeJob = resolve('book-audio-data').findFileJob($app, audioJobFileId)
      // failed는 끝내 실패한 구간을 기기 음성으로 대신 읽는 상태라 끝까지 들을 수 있습니다.
      hasCompletedAudio =
        !!audioBadgeJob
        && Number(audioBadgeJob.get('ready_chunks') || 0) > 0
        && ['completed', 'failed'].indexOf(String(audioBadgeJob.get('status'))) >= 0
    } catch (exception) {
      dbg('page/books/[bookId]:audio-badge-unavailable', {
        bookId: bookId,
        error: String(exception.message || exception),
      })
    }
  }
  let audioJob = null
  let audioJobError = ''
  let hasStoredAudio = false
  /** @type {types.BookAudioModelOption[]} */
  let audioModelOptions = []
  let audioSelectedModel = ''
  let canRequestAudio = false

  if (showAudioJob) {
    try {
      const audioData = resolve('book-audio-data')
      const audioJobService = resolve('book-audio-job-service')
      const audioJobRecord = audioData.findFileJob($app, audioJobFileId)
      audioJob = audioJobRecord ? audioJobService.jobView(audioJobRecord) : null
      hasStoredAudio = !!audioJobRecord || audioData.countFileChunks($app, audioJobFileId) > 0
      audioModelOptions = audioData.getModelOptions($app, audioJobFileId).filter(function (option) {
        return !audioJobRecord || option.model === String(audioJobRecord.get('model'))
      })
      const availableModel = audioModelOptions.find(function (option) {
        return !option.disabled
      })
      audioSelectedModel = availableModel ? availableModel.model : ''
      canRequestAudio = !!availableModel
    } catch (exception) {
      warn('page/books/[bookId]:audio-job-unavailable', {
        bookId: bookId,
        error: String(exception.message || exception),
      })
      audioJobError = '오디오북 스키마 또는 TTS 설정을 확인해 주세요.'
    }
  }

  try {
    highlightRecords = $app.findRecordsByFilter(
      'book_highlights',
      'user_id = {:userId} && book_id = {:bookId}',
      '-highlighted_at,-updated',
      20,
      0,
      {
        userId: userId,
        bookId: bookId,
      }
    )
  } catch (exception) {
    highlightRecords = []
  }

  const selectedHighlightId = String(request.url.query.highlight || '').trim()

  if (
    selectedHighlightId
    && !highlightRecords.some(function (record) {
      return record.get('id') === selectedHighlightId
    })
  ) {
    try {
      const selectedHighlight = $app.findFirstRecordByFilter(
        'book_highlights',
        'id = {:highlightId} && user_id = {:userId} && book_id = {:bookId}',
        { highlightId: selectedHighlightId, userId: userId, bookId: bookId }
      )
      highlightRecords.unshift(selectedHighlight)
    } catch (exception) {
      dbg('page/books/[bookId]:selected-highlight-unavailable', { bookId: bookId, highlightId: selectedHighlightId })
    }
  }

  /**
   * 사용자에게 보여줄 수 있는 챕터 라벨만 남깁니다.
   * @param {string} value 원본 라벨 문자열
   * @returns {string} 표시 가능한 챕터 라벨
   */
  function formatHighlightLabel(value) {
    const normalizedValue = String(value || '').trim()

    if (
      !normalizedValue
      || /[\\/]/.test(normalizedValue)
      || /\.x?html?$/i.test(normalizedValue)
      || /^section\d+/i.test(normalizedValue)
      || /^text$/i.test(normalizedValue)
    ) {
      return ''
    }

    return normalizedValue
  }

  highlightCards = highlightRecords.map(function (highlight) {
    const highlightedAtValue = String(highlight.get('highlighted_at') || '').trim()

    return {
      id: String(highlight.get('id') || ''),
      label: formatHighlightLabel(String(highlight.get('chapter_label') || '')),
      highlightedAt: highlightedAtValue ? dateutil.formatDate(highlightedAtValue, dateutil.FORMATS.DATE) : '',
      quoteText: String(highlight.get('quote_text') || '').trim(),
      noteText: String(highlight.get('note_text') || '').trim(),
    }
  })

  let bookMetaText = publicationDate

  if (!bookMetaText && publicationYear) {
    bookMetaText = publicationYear + '년'
  }

  if (bookMetaText && publicationDate) {
    bookMetaText = dateutil.formatDate(publicationDate, dateutil.FORMATS.DATE)
  }

  if (!bookMetaText) {
    bookMetaText = '출판일 정보 없음'
  }

  let publicationMetaText = ''

  if (publisher && bookMetaText !== '출판일 정보 없음') {
    publicationMetaText = publisher + ' · ' + bookMetaText
  } else if (publisher) {
    publicationMetaText = publisher
  } else {
    publicationMetaText = bookMetaText
  }

  const readingStatusText = shelfStatusLabels[shelfStatus] || '읽을 예정'
  const readingDurationText = readingDurationMinutes + '분'
</script>

<section class="space-y-7">
  <div class="space-y-3">
    <a
      href="<%= bookBackHref %>"
      class="inline-flex items-center gap-2 rounded-full border-none bg-white/78 px-3 py-2 text-sm font-medium text-stone-700 no-underline shadow-[0_10px_22px_rgba(70,52,31,0.08)] ring-0 outline-none">
      <span
        class="i-lucide-arrow-left h-4 w-4"
        aria-hidden="true"></span>
      <%= bookBackLabel %>
    </a>
    <h1 class="text-2xl font-semibold tracking-tight text-stone-950 sm:text-3xl">책 상세</h1>
  </div>

  <% if (flashMessage) { %>
  <section
    class="rounded-[1.6rem] border border-stone-200 bg-white/85 px-5 py-4 text-sm text-stone-700 shadow-sm backdrop-blur-sm">
    <%= flashMessage %>
  </section>
  <% } %>

  <section
    class="relative rounded-[2rem] border border-stone-200/80 bg-[linear-gradient(180deg,rgba(255,252,245,0.94),rgba(245,236,222,0.96))] p-5 shadow-[0_18px_45px_rgba(73,54,31,0.08)] backdrop-blur-sm">
    <div
      class="flex flex-col gap-5 md:grid md:grid-cols-[14rem_minmax(0,1fr)] md:items-start md:gap-x-8 md:gap-y-5 lg:gap-x-12">
      <div class="w-34 shrink-0 sm:w-40 md:w-[14rem]">
        <div
          class="relative aspect-[2/3] w-full overflow-hidden rounded-[0.35rem] bg-gradient-to-b from-[#d8c3a5] to-[#b08968] shadow-[0_10px_24px_rgba(24,19,16,0.10)]">
          <% if (bookImageUrl) { %>
          <img
            src="<%= bookImageUrl %>"
            alt="<%= mainTitle %> 표지"
            class="h-full w-full object-cover" />
          <% } else { %>
          <div class="absolute inset-0 box-border px-4 py-5 text-white">
            <div class="absolute top-[34%] left-1/2 w-[78%] -translate-x-1/2 -translate-y-1/2 text-center">
              <h3 class="m-0 text-lg leading-6 font-semibold tracking-[-0.03em] break-keep"><%= mainTitle %></h3>
            </div>
            <p class="absolute right-4 bottom-5 left-4 m-0 text-right text-[12px] leading-4.5 break-keep text-white/78">
              <%= author || '저자 정보 없음' %>
            </p>
          </div>
          <% } %>
        </div>
        <% if (bookFileUrl) { %>
        <a
          href="/books/<%= bookId %>/read"
          class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full border-none bg-stone-900 px-4 py-3 text-sm font-medium text-white no-underline shadow-[0_10px_22px_rgba(24,19,16,0.12)] ring-0 transition outline-none hover:bg-stone-700 md:w-auto md:min-w-[10.5rem] md:self-start">
          <span
            class="i-lucide-book-open h-4 w-4"
            aria-hidden="true"></span>
          뷰어로 보기
        </a>
        <% } %>
      </div>

      <div class="min-w-0 flex-1 space-y-4">
        <div class="md:flex md:flex-col">
          <% if (shelfRecord) { %>
          <form
            method="post"
            action="/xapi/books/remove-from-shelf"
            class="absolute top-5 right-5 z-10 m-0 md:static md:mb-2 md:flex md:w-full md:justify-end lg:absolute lg:mb-0 lg:w-auto"
            onsubmit="
              return window.confirm('이 책을 내 도서함에서 제거할까요? 이 책과 관련된 데이터도 함께 삭제됩니다.')
            ">
            <input
              type="hidden"
              name="bookId"
              value="<%= bookId %>" />
            <button
              type="submit"
              class="inline-flex items-center rounded-full border-none bg-stone-200/50 px-3.5 py-2 text-[12px] font-medium text-stone-600 ring-0 transition outline-none hover:bg-stone-200 hover:text-stone-700 focus-visible:ring-2 focus-visible:ring-stone-400/60">
              도서함에서 제거
            </button>
          </form>
          <% } %>
          <h2
            class="text-2xl leading-tight font-semibold tracking-[-0.03em] text-stone-950 sm:text-3xl md:mt-0 lg:mt-6 lg:pr-40">
            <%= mainTitle %>
          </h2>
          <% if (subtitle) { %>
          <p class="mt-2 text-base leading-relaxed font-medium tracking-[-0.02em] text-stone-600 sm:mt-3 sm:text-lg">
            <%= subtitle %>
          </p>
          <% } %>
          <% if (hasCompletedAudio) { %>
          <p
            class="mt-3 mb-0 inline-flex items-center gap-1.5 self-start rounded-full bg-[#efe2d2] px-3 py-1 text-[12px] font-semibold text-[#8e5521]"
            title="뷰어의 읽어주기에서 AI 오디오북으로 들을 수 있습니다">
            <span
              class="i-lucide-headphones h-3.5 w-3.5"
              aria-hidden="true"></span>
            AI 오디오북
          </p>
          <% } %>
        </div>

        <dl class="grid gap-3 text-sm text-stone-700 sm:grid-cols-2 lg:gap-4">
          <div class="rounded-[1.2rem] bg-white/75 px-4 py-3 shadow-[inset_0_0_0_1px_rgba(120,93,63,0.08)]">
            <dt class="text-[11px] font-semibold tracking-[0.2em] text-stone-500 uppercase">저자</dt>
            <dd class="mt-1 text-base font-medium text-stone-900"><%= author || '저자 정보 없음' %></dd>
          </div>
          <div class="rounded-[1.2rem] bg-white/75 px-4 py-3 shadow-[inset_0_0_0_1px_rgba(120,93,63,0.08)]">
            <dt class="text-[11px] font-semibold tracking-[0.2em] text-stone-500 uppercase">출판 정보</dt>
            <dd class="mt-1 flex items-center justify-between gap-3 text-base font-medium text-stone-900">
              <span class="min-w-0"><%= publicationMetaText %></span>
              <% if (shouldShowMetadataRefreshButton) { %>
              <form
                method="post"
                action="/xapi/books/refresh-metadata"
                class="m-0 inline-flex shrink-0">
                <input
                  type="hidden"
                  name="bookId"
                  value="<%= bookId %>" />
                <input
                  type="hidden"
                  name="from"
                  value="<%= bookBackHref %>" />
                <button
                  type="submit"
                  class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-none bg-[#efe2d2] text-[#8e5521] shadow-[0_8px_18px_rgba(132,90,47,0.08)] ring-0 transition hover:bg-[#ead9c4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-600"
                  aria-label="도서 정보 다시 가져오기"
                  title="도서 정보 다시 가져오기">
                  <span
                    class="i-lucide-refresh-cw h-4 w-4"
                    aria-hidden="true"></span>
                </button>
              </form>
              <% } %>
            </dd>
          </div>
          <div class="rounded-[1.2rem] bg-white/75 px-4 py-3 shadow-[inset_0_0_0_1px_rgba(120,93,63,0.08)]">
            <dt class="text-[11px] font-semibold tracking-[0.2em] text-stone-500 uppercase">페이지 수</dt>
            <dd class="mt-1 flex items-center justify-between gap-3 text-base font-medium text-stone-900">
              <% if (estimatedPageCount > 0) { %>
              <span>약 <%= estimatedPageCount %>p</span>
              <% } else { %>
              <span>페이지 정보 없음</span>
              <% if (bookFileRecord && storedFileName) { %>
              <form
                class="inline-flex shrink-0"
                method="post"
                action="/xapi/books/recalculate-page-count">
                <input
                  type="hidden"
                  name="bookId"
                  value="<%= bookId %>" />
                <button
                  type="submit"
                  class="inline-flex h-8 w-8 items-center justify-center rounded-full border-none bg-[#efe2d2] text-[#8e5521] shadow-[0_8px_18px_rgba(132,90,47,0.08)] transition hover:bg-[#ead9c4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-600"
                  aria-label="페이지 수 다시 계산"
                  title="페이지 수 다시 계산">
                  <span
                    class="i-lucide-refresh-cw h-4 w-4"
                    aria-hidden="true"></span>
                  <span class="sr-only">페이지 수 다시 계산</span>
                </button>
              </form>
              <% } %>
              <% } %>
            </dd>
          </div>
          <div class="rounded-[1.2rem] bg-white/75 px-4 py-3 shadow-[inset_0_0_0_1px_rgba(120,93,63,0.08)]">
            <dt class="text-[11px] font-semibold tracking-[0.2em] text-stone-500 uppercase">독서 기록</dt>
            <dd class="mt-2 flex items-center justify-between gap-3 text-stone-900">
              <div class="min-w-0 flex-1 space-y-2">
                <div class="flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-1">
                  <span class="text-base font-semibold text-stone-950"><%= readingStatusText %></span>
                  <% if (readingProgressText) { %>
                  <span class="text-sm font-medium text-stone-600"><%= readingProgressText %></span>
                  <% } %>
                  <span class="text-sm font-medium text-stone-500"><%= readingDurationText %></span>
                </div>
                <% if (readingProgressText) { %>
                <div class="h-1.5 overflow-hidden rounded-full bg-stone-200/80">
                  <div
                    class="h-full rounded-full bg-stone-900"
                    style="width: <%= readingProgressPercent %>%"></div>
                </div>
                <% } %>
              </div>
              <form
                method="post"
                action="/xapi/books/reset-reading-sessions"
                class="m-0"
                onsubmit="return window.confirm('이 책의 독서 시간을 초기화할까요?')">
                <input
                  type="hidden"
                  name="bookId"
                  value="<%= bookId %>" />
                <input
                  type="hidden"
                  name="from"
                  value="<%= bookBackHref %>" />
                <button
                  type="<%= readingDurationMinutes > 0 ? 'submit' : 'button' %>"
                  aria-label="독서 시간 초기화"
                  aria-disabled="<%= readingDurationMinutes > 0 ? 'false' : 'true' %>"
                  tabindex="<%= readingDurationMinutes > 0 ? '0' : '-1' %>"
                  class="<%= readingDurationMinutes > 0 ? 'text-[#8e5521] hover:bg-[#ead9c4]' : 'text-stone-300' %> inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-none bg-[#efe2d2] text-sm font-semibold shadow-[0_8px_18px_rgba(132,90,47,0.08)] ring-0 transition outline-none disabled:cursor-not-allowed disabled:bg-stone-100 disabled:shadow-none">
                  <span
                    class="i-lucide-eraser h-4 w-4"
                    aria-hidden="true"></span>
                </button>
              </form>
            </dd>
          </div>
        </dl>

        <div class="flex flex-wrap items-center gap-2 pt-1">
          <div
            class="flex min-w-0 flex-1 rounded-full bg-white/72 p-1 shadow-[inset_0_0_0_1px_rgba(120,93,63,0.1)] sm:flex-none">
            <form
              method="post"
              action="/xapi/books/update-status"
              class="m-0 flex-1 sm:flex-none">
              <input
                type="hidden"
                name="bookId"
                value="<%= bookId %>" />
              <input
                type="hidden"
                name="from"
                value="<%= bookBackHref %>" />
              <input
                type="hidden"
                name="status"
                value="queued" />
              <button
                type="<%= shelfStatus === 'queued' ? 'button' : 'submit' %>"
                aria-pressed="<%= shelfStatus === 'queued' ? 'true' : 'false' %>"
                class="<%= shelfStatus === 'queued' ? 'bg-stone-900 text-white shadow-[0_10px_22px_rgba(24,19,16,0.12)]' : 'bg-transparent text-stone-600 hover:bg-stone-100/80' %> inline-flex h-10 w-full items-center justify-center rounded-full border-none px-3 text-sm font-semibold ring-0 transition outline-none sm:w-auto sm:min-w-[5.25rem]">
                읽을 예정
              </button>
            </form>
            <form
              method="post"
              action="/xapi/books/update-status"
              class="m-0 flex-1 sm:flex-none">
              <input
                type="hidden"
                name="bookId"
                value="<%= bookId %>" />
              <input
                type="hidden"
                name="from"
                value="<%= bookBackHref %>" />
              <input
                type="hidden"
                name="status"
                value="reading" />
              <button
                type="<%= shelfStatus === 'reading' ? 'button' : 'submit' %>"
                aria-pressed="<%= shelfStatus === 'reading' ? 'true' : 'false' %>"
                class="<%= shelfStatus === 'reading' ? 'bg-stone-900 text-white shadow-[0_10px_22px_rgba(24,19,16,0.12)]' : 'bg-transparent text-stone-600 hover:bg-stone-100/80' %> inline-flex h-10 w-full items-center justify-center rounded-full border-none px-3 text-sm font-semibold ring-0 transition outline-none sm:w-auto sm:min-w-[5.25rem]">
                읽는 중
              </button>
            </form>
            <form
              method="post"
              action="/xapi/books/update-status"
              class="m-0 flex-1 sm:flex-none">
              <input
                type="hidden"
                name="bookId"
                value="<%= bookId %>" />
              <input
                type="hidden"
                name="from"
                value="<%= bookBackHref %>" />
              <input
                type="hidden"
                name="status"
                value="finished" />
              <button
                type="<%= shelfStatus === 'finished' ? 'button' : 'submit' %>"
                aria-pressed="<%= shelfStatus === 'finished' ? 'true' : 'false' %>"
                class="<%= shelfStatus === 'finished' ? 'bg-stone-900 text-white shadow-[0_10px_22px_rgba(24,19,16,0.12)]' : 'bg-transparent text-stone-600 hover:bg-stone-100/80' %> inline-flex h-10 w-full items-center justify-center rounded-full border-none px-3 text-sm font-semibold ring-0 transition outline-none sm:w-auto sm:min-w-[5.25rem]">
                완독
              </button>
            </form>
          </div>
          <% if (downloadFileUrl) { %>
          <a
            href="<%= downloadFileUrl %>"
            aria-label="EPUB 다운로드"
            onclick="return window.confirm('EPUB 파일을 다운로드할까요?')"
            class="ml-auto inline-flex h-11 w-11 items-center justify-center rounded-full border-none bg-[#dcc6ad] text-[#6b4423] no-underline shadow-[0_12px_24px_rgba(112,84,54,0.14)] ring-0 transition outline-none hover:bg-[#d2b596]">
            <span
              class="i-lucide-download h-5 w-5"
              aria-hidden="true"></span>
          </a>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <section
    class="rounded-[2rem] border border-stone-200/80 bg-white/80 p-5 shadow-[0_18px_45px_rgba(73,54,31,0.08)] backdrop-blur-sm">
    <div class="space-y-2">
      <h3 class="text-xl font-semibold tracking-tight text-stone-950 sm:text-2xl">인상 깊은 문구</h3>
    </div>

    <% if (highlightCards.length > 0) { %>
    <div class="mt-5 space-y-3">
      <% for (let index = 0; index < highlightCards.length; index += 1) { const highlight = highlightCards[index] %>
      <article
        id="highlight-<%= highlight.id %>"
        x-data="{ editing: false }"
        class="rounded-[1.4rem] bg-[#fbf7ef] px-4 py-3.5 shadow-[inset_0_0_0_1px_rgba(118,87,52,0.08)]">
        <div x-show="!editing">
          <p class="text-[15px] leading-[1.65] font-semibold tracking-[-0.02em] text-stone-900 sm:text-base">
            <%= highlight.quoteText %>
          </p>
          <% if (highlight.noteText) { %>
          <p class="mt-2.5 text-sm leading-6 text-stone-600"><%= highlight.noteText %></p>
          <% } %>
          <div class="mt-2.5 flex items-end justify-between gap-3">
            <div class="min-w-0 flex-1">
              <% if (highlight.label) { %>
              <p class="text-[12px] leading-5 text-stone-600"><%= highlight.label %></p>
              <% } %>
              <% if (highlight.highlightedAt) { %>
              <p class="mt-0.5 text-[12px] leading-5 font-medium whitespace-nowrap text-stone-400">
                <%= highlight.highlightedAt %>
              </p>
              <% } %>
            </div>
            <div class="flex shrink-0 items-center gap-1.5">
              <%#
                                                                                                                                                                                                                                                                                                                                                                                                        수정 아이콘을 임시로 숨깁니다. 다시 필요해지면 이 주석 블록을 해제하세요.
                                                                                                                                                                                                                                                                                                                                                                                                        <button
                                                                                                                                                                                                                                                                                                                                                                                                          type="button"
                                                                                                                                                                                                                                                                                                                                                                                                          x-on:click="editing = true"
                                                                                                                                                                                                                                                                                                                                                                                                          aria-label="인상 깊은 문구 수정"
                                                                                                                                                                                                                                                                                                                                                                                                          class="inline-flex h-8 w-8 items-center justify-center rounded-full border-none bg-[#efe2d2] text-sm font-semibold text-[#8e5521] shadow-[0_6px_14px_rgba(132,90,47,0.06)] ring-0 transition outline-none hover:bg-[#ead9c4]">
                                                                                                                                                                                                                                                                                                                                                                                                          <span
                                                                                                                                                                                                                                                                                                                                                                                                            class="i-lucide-pencil h-4 w-4"
                                                                                                                                                                                                                                                                                                                                                                                                            aria-hidden="true"></span>
                                                                                                                                                                                                                                                                                                                                                                                                        </button>
                                                                                                                                                                                                                                                                                                                                                                                                        %>
              <form
                method="post"
                action="/xapi/books/delete-highlight"
                class="m-0"
                onsubmit="return window.confirm('이 문구를 삭제할까요?')">
                <input
                  type="hidden"
                  name="bookId"
                  value="<%= bookId %>" />
                <input
                  type="hidden"
                  name="from"
                  value="<%= bookBackHref %>" />
                <input
                  type="hidden"
                  name="highlightId"
                  value="<%= highlight.id %>" />
                <button
                  type="submit"
                  aria-label="인상 깊은 문구 삭제"
                  class="inline-flex h-8 w-8 items-center justify-center rounded-full border-none bg-stone-200/50 text-sm font-semibold text-stone-500 ring-0 transition outline-none hover:bg-stone-200 hover:text-stone-700 focus-visible:ring-2 focus-visible:ring-stone-400/60">
                  <span
                    class="i-lucide-trash-2 h-4 w-4"
                    aria-hidden="true"></span>
                </button>
              </form>
            </div>
          </div>
        </div>
        <form
          x-show="editing"
          x-cloak
          x-ref="editForm"
          method="post"
          action="/xapi/books/update-highlight"
          class="space-y-3">
          <input
            type="hidden"
            name="bookId"
            value="<%= bookId %>" />
          <input
            type="hidden"
            name="from"
            value="<%= bookBackHref %>" />
          <input
            type="hidden"
            name="highlightId"
            value="<%= highlight.id %>" />
          <label class="block space-y-2">
            <span class="text-sm font-medium text-stone-700">문구</span>
            <textarea
              name="quoteText"
              rows="5"
              class="box-border block w-full min-w-0 rounded-[1.25rem] border-0 bg-white/80 px-4 py-4 text-[15px] leading-7 text-[#2f251c] shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1)] transition outline-none placeholder:text-[#b59f87]"
              required>
<%= highlight.quoteText %></textarea>
          </label>
          <label class="block space-y-2">
            <span class="text-sm font-medium text-stone-700">메모</span>
            <textarea
              name="noteText"
              rows="3"
              class="box-border block w-full min-w-0 rounded-[1.25rem] border-0 bg-white/80 px-4 py-4 text-[15px] leading-7 text-[#2f251c] shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1)] transition outline-none placeholder:text-[#b59f87]">
<%= highlight.noteText %></textarea>
          </label>
          <div class="flex flex-wrap gap-2">
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-full border-none bg-stone-900 px-4 py-2.5 text-sm font-semibold text-white ring-0 transition outline-none hover:bg-stone-700">
              저장
            </button>
            <button
              type="button"
              x-on:click="$refs.editForm.reset(); editing = false"
              class="inline-flex items-center justify-center rounded-full border-none bg-white/80 px-4 py-2.5 text-sm font-semibold text-stone-700 shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1)] ring-0 outline-none">
              취소
            </button>
          </div>
        </form>
      </article>
      <% } %>
    </div>
    <% } else { %>
    <div
      class="mt-5 rounded-[1.4rem] bg-[#fbf7ef] px-4 py-4 text-sm leading-6 text-stone-500 shadow-[inset_0_0_0_1px_rgba(118,87,52,0.08)]">
      아직 저장된 문구가 없습니다. 리더에서 마음에 드는 문장을 복사해 저장해 보세요.
    </div>
    <% } %>
  </section>

  <section
    id="book-review"
    class="relative rounded-[2rem] border border-stone-200/80 bg-white/80 p-5 shadow-[0_18px_45px_rgba(73,54,31,0.08)] backdrop-blur-sm">
    <div class="space-y-2">
      <h3 class="text-xl font-semibold tracking-tight text-stone-950 sm:text-2xl">감상평</h3>
    </div>

    <% if (reviewText.trim()) { %>
    <form
      method="post"
      action="/xapi/books/delete-review"
      class="absolute right-5 bottom-5 m-0"
      onsubmit="return window.confirm('감상평을 삭제할까요?')">
      <input
        type="hidden"
        name="bookId"
        value="<%= bookId %>" />
      <input
        type="hidden"
        name="from"
        value="<%= bookBackHref %>" />
      <button
        type="submit"
        aria-label="감상평 삭제"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border-none bg-stone-200/50 text-sm font-semibold text-stone-500 ring-0 transition outline-none hover:bg-stone-200 hover:text-stone-700 focus-visible:ring-2 focus-visible:ring-stone-400/60">
        <span
          class="i-lucide-trash-2 h-4 w-4"
          aria-hidden="true"></span>
      </button>
    </form>
    <% } %>

    <div class="mt-5 space-y-4">
      <form
        class="space-y-4"
        method="post"
        action="/xapi/books/save-review">
        <input
          type="hidden"
          name="bookId"
          value="<%= bookId %>" />
        <input
          type="hidden"
          name="from"
          value="<%= bookBackHref %>" />
        <label class="block space-y-2">
          <textarea
            name="reviewText"
            data-review-draft-key="booklog.review-draft:<%= userId %>:<%= bookId %>"
            rows="8"
            aria-label="감상평"
            class="booklog-review-textarea box-border block w-full min-w-0 resize-none rounded-[1.4rem] border-0 bg-[#fbf5ec] px-4 py-4 text-[15px] leading-7 text-[#2f251c] shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1),0_10px_24px_rgba(157,121,72,0.08)] transition outline-none placeholder:text-[#b59f87] focus:bg-[#fffaf2] focus:shadow-[inset_0_0_0_1.5px_rgba(155,111,69,0.42),0_14px_28px_rgba(157,121,72,0.12)]"
            placeholder="읽으며 들었던 생각을 적어보세요.">
<%= reviewText %></textarea>
        </label>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-full border-none bg-stone-900 px-5 py-3 text-sm font-medium text-white shadow-[0_10px_22px_rgba(24,19,16,0.12)] ring-0 transition outline-none hover:bg-stone-700">
          감상평 저장
        </button>
      </form>
    </div>
  </section>

  <% if (showAudioJob) { %>
  <section
    class="space-y-4 rounded-[2rem] border border-stone-200/80 bg-white/80 p-5 shadow-[0_18px_45px_rgba(73,54,31,0.08)] backdrop-blur-sm">
    <h3 class="text-xl font-semibold tracking-tight text-stone-950 sm:text-2xl">AI 오디오북</h3>
    <% if (audioJobError) { %>
    <p class="text-sm text-stone-600"><%= audioJobError %></p>
    <% } else { %>
    <% if (audioJob) { %>
    <div class="space-y-2">
      <div class="h-2 overflow-hidden rounded-full bg-stone-200">
        <div
          class="h-full rounded-full bg-stone-900"
          style="width: <%= audioJob.percent %>%"></div>
      </div>
      <p class="text-sm font-medium text-stone-800"><%= audioJob.statusLabel %></p>
      <p class="text-xs text-stone-500">
        모델: <%= audioModelOptions[0] ? audioModelOptions[0].label : '' %> · 생성 시작 시 고정
      </p>
      <% if (audioJob.nextRunLabel) { %>
      <p class="text-xs text-stone-500"><%= audioJob.nextRunLabel %></p>
      <% } %>
      <% if (audioJob.errorMessage) { %>
      <p class="text-xs text-stone-500"><%= audioJob.errorMessage %></p>
      <% } %>
    </div>
    <% } else { %>
    <p class="text-sm text-stone-600">아직 생성을 요청하지 않았습니다.</p>
    <% } %>
    <div class="flex flex-wrap gap-2">
      <% if (!audioJob || audioJob.canStart) { %>
      <form
        method="post"
        action="/xapi/books/audio-job"
        class="m-0">
        <input
          type="hidden"
          name="bookId"
          value="<%= bookId %>" />
        <input
          type="hidden"
          name="fileId"
          value="<%= audioJobFileId %>" />
        <input
          type="hidden"
          name="action"
          value="start" />
        <fieldset class="mb-3 space-y-2">
          <legend class="mb-2 text-sm font-medium text-stone-800">생성 모델</legend>
          <% for (const option of audioModelOptions) { %>
          <label class="flex items-start gap-2 text-sm text-stone-700">
            <input
              type="radio"
              name="model"
              value="<%= option.model %>"
              <%= option.model === audioSelectedModel ? 'checked' : '' %>
              <%= option.disabled ? 'disabled' : '' %>
              required
              class="mt-1" />
            <span>
              <%= option.label %>
              <% if (option.disabled) { %>
              <span class="block text-xs text-stone-500">
                「<%= option.busyBookTitle %>」 미완료 · 완료하거나 삭제하면 사용 가능
              </span>
              <% } %>
            </span>
          </label>
          <% } %>
        </fieldset>
        <button
          type="submit"
          <%= canRequestAudio ? '' : 'disabled' %>
          class="inline-flex h-10 items-center justify-center rounded-full border-none bg-stone-900 px-4 text-sm font-semibold text-white ring-0 transition outline-none hover:bg-stone-700 disabled:cursor-not-allowed disabled:opacity-40">
          <%= audioJob ? '생성 다시 시작' : 'AI 오디오북 생성 요청' %>
        </button>
      </form>
      <% } %>
      <% if (audioJob && audioJob.canPause) { %>
      <form
        method="post"
        action="/xapi/books/audio-job"
        class="m-0">
        <input
          type="hidden"
          name="bookId"
          value="<%= bookId %>" />
        <input
          type="hidden"
          name="fileId"
          value="<%= audioJobFileId %>" />
        <input
          type="hidden"
          name="action"
          value="pause" />
        <button
          type="submit"
          class="inline-flex h-10 items-center justify-center rounded-full border-none bg-stone-100 px-4 text-sm font-semibold text-stone-700 ring-0 transition outline-none hover:bg-stone-200">
          일시 정지
        </button>
      </form>
      <% } %>
      <% if (hasStoredAudio) { %>
      <form
        method="post"
        action="/xapi/books/audio-job"
        class="m-0"
        onsubmit="return window.confirm('생성한 AI 오디오북 음성과 청취 기록을 모두 삭제할까요?')">
        <input
          type="hidden"
          name="bookId"
          value="<%= bookId %>" />
        <input
          type="hidden"
          name="fileId"
          value="<%= audioJobFileId %>" />
        <input
          type="hidden"
          name="action"
          value="delete" />
        <button
          type="submit"
          class="inline-flex h-10 items-center justify-center rounded-full border-none bg-[#efe2d2] px-4 text-sm font-semibold text-[#8e5521] ring-0 transition outline-none hover:bg-[#ead9c4]">
          오디오북 삭제
        </button>
      </form>
      <% } %>
    </div>
    <% } %>
  </section>
  <% } %>
</section>
