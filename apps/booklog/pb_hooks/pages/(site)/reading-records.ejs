<script server>
  const { dateutil } = require('@pocketpages/utils')
  const bookTitleService = resolve('book-title')

  meta('title', '북로그 독서 기록')
  meta('description', '주차별 독서 시간과 책 표지 달력을 확인하는 페이지')

  if (!request.auth) {
    dbg('page/reading-records:redirect', {
      status: 303,
      redirectTo: '/auth',
      message: '로그인이 필요합니다.',
    })
    redirect('/auth', {
      status: 303,
      message: '로그인이 필요합니다.',
    })
    return
  }

  const userId = String(request.auth.get('id') || '')
  const now = new Date()
  const weekItems = []
  const requestedWeekValue = String(request.url.query.week || '').trim()
  const isCalendarView = String(request.url.query.view || '') === 'calendar'
  const todayKey = dateutil.formatDate(now, dateutil.FORMATS.DATE)
  const currentMonthKey = todayKey.slice(0, 7)
  const requestedMonth = String(request.url.query.month || '').trim()
  const validMonth = /^\d{4}-\d{2}$/.test(requestedMonth) && parseDateValue(requestedMonth + '-01')
  const monthKey = validMonth && requestedMonth <= currentMonthKey ? requestedMonth : currentMonthKey
  const monthStartKey = monthKey + '-01'
  const nextMonthKey = dateutil.formatDate(dateutil.addMonths(monthStartKey, 1), 'YYYY-MM')
  const monthEndKey = dateutil.formatDate(dateutil.addDays(nextMonthKey + '-01', -1), dateutil.FORMATS.DATE)
  const previousMonthHref =
    '/reading-records?view=calendar&month=' + dateutil.formatDate(dateutil.addMonths(monthStartKey, -1), 'YYYY-MM')
  const nextMonthHref = '/reading-records?view=calendar&month=' + nextMonthKey
  const calendarHref = '/reading-records?view=calendar&month=' + monthKey
  const weeklyHref =
    requestedWeekValue && parseDateValue(requestedWeekValue)
      ? '/reading-records?view=weekly&week=' + encodeURIComponent(requestedWeekValue)
      : '/reading-records?view=weekly'
  const monthLabel = dateutil.formatDate(monthStartKey, 'YYYY년 M월')
  const calendarDays = []
  const calendarCells = []
  const daysByKey = {}
  const weekdayLabels = ['월', '화', '수', '목', '금', '토', '일']
  let monthSeconds = 0
  let readingDayCount = 0

  /**
   * 날짜를 한국시간 기준 해당 주 월요일로 맞춥니다.
   *
   * @param {Date} date 기준 날짜
   * @returns {Date} 주 시작 날짜
   */
  function getWeekStart(date) {
    const dateText = dateutil.formatDate(date, dateutil.FORMATS.DATE)
    const target = new Date(dateText + 'T00:00:00.000Z')
    const day = target.getUTCDay()
    const diff = day === 0 ? -6 : 1 - day

    target.setUTCDate(target.getUTCDate() + diff)

    return target
  }

  /**
   * YYYY-MM-DD 값을 날짜로 바꿉니다.
   *
   * @param {string} value 날짜 값
   * @returns {Date|null} 날짜
   */
  function parseDateValue(value) {
    const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)

    if (!match) {
      return null
    }

    const year = Number(match[1])
    const month = Number(match[2])
    const day = Number(match[3])
    const date = new Date(Date.UTC(year, month - 1, day, 0, 0, 0, 0))

    if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
      return null
    }

    return date
  }

  /**
   * 주차 이동 링크를 만듭니다.
   *
   * @param {Date} weekStart 주 시작 날짜
   * @returns {string} 이동 링크
   */
  function buildWeekHref(weekStart) {
    return '/reading-records?week=' + encodeURIComponent(dateutil.formatDate(weekStart, dateutil.FORMATS.DATE))
  }

  /**
   * 시간을 짧은 한국어 문구로 표시합니다.
   *
   * @param {number} minutes 분
   * @returns {string} 표시 문구
   */
  function formatMinutesLabel(minutes) {
    const safeMinutes = Math.max(0, Math.round(minutes))
    const hours = Math.floor(safeMinutes / 60)
    const restMinutes = safeMinutes % 60

    if (hours > 0 && restMinutes > 0) {
      return hours + '시간 ' + restMinutes + '분'
    }

    if (hours > 0) {
      return hours + '시간'
    }

    return safeMinutes + '분'
  }

  /**
   * 정수를 천 단위 쉼표 문자열로 만듭니다.
   *
   * @param {number} value 숫자 값
   * @returns {string} 표시 문자열
   */
  function formatIntegerLabel(value) {
    return String(Math.max(0, Math.floor(Number(value) || 0))).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
  }

  /**
   * 누적 시간을 짧게 표시합니다.
   *
   * @param {number} minutes 분
   * @returns {string} 표시 문구
   */
  function formatTotalMinutesLabel(minutes) {
    const safeMinutes = Math.max(0, Math.round(minutes))
    const hours = Math.floor(safeMinutes / 60)
    if (hours >= 100) {
      return formatIntegerLabel(hours) + '시간'
    }
    return formatMinutesLabel(safeMinutes)
  }

  const currentWeekStart = getWeekStart(now)
  const currentWeekKey = dateutil.formatDate(currentWeekStart, dateutil.FORMATS.DATE)
  const readingSummary = new DynamicModel({ totalSeconds: 0, currentWeekSeconds: 0 })
  let finishedBookCount = 0

  if (!isCalendarView) {
    dbg('page/reading-records:find-summary', { userId: userId })
    $app
      .db()
      .newQuery(
        `SELECT COALESCE(SUM(duration_seconds), 0) AS totalSeconds,
        COALESCE(SUM(CASE WHEN ended_at >= {:weekStart} AND ended_at < {:weekEnd}
          THEN duration_seconds ELSE 0 END), 0) AS currentWeekSeconds
      FROM reading_sessions
      WHERE user_id = {:userId} AND ended_at != '' AND duration_seconds > 0`
      )
      .bind({
        userId: userId,
        weekStart: dateutil.dbStartOfDay(currentWeekKey),
        weekEnd: dateutil.dbStartOfDay(dateutil.addDays(currentWeekKey, 7)),
      })
      .one(readingSummary)

    try {
      finishedBookCount = $app.countRecords('book_shelves', $dbx.hashExp({ user_id: userId, status: 'finished' }))
    } catch (exception) {
      finishedBookCount = 0
    }
  }
  const totalMinutes = Math.round(Number(readingSummary.totalSeconds || 0) / 60)
  const totalMinutesLabel = formatTotalMinutesLabel(totalMinutes)
  const currentWeekMinutes = Math.round(Number(readingSummary.currentWeekSeconds || 0) / 60)

  const requestedDate = parseDateValue(requestedWeekValue)
  let selectedWeekStart = requestedDate ? getWeekStart(requestedDate) : new Date(currentWeekStart.getTime())

  if (selectedWeekStart.getTime() > currentWeekStart.getTime()) {
    selectedWeekStart = new Date(currentWeekStart.getTime())
  }

  const previousWeekStart = new Date(selectedWeekStart.getTime())
  const nextWeekStart = new Date(selectedWeekStart.getTime())
  const periodStart = new Date(selectedWeekStart.getTime())
  const periodEnd = new Date(selectedWeekStart.getTime())

  previousWeekStart.setUTCDate(selectedWeekStart.getUTCDate() - 28)
  nextWeekStart.setUTCDate(selectedWeekStart.getUTCDate() + 28)
  periodStart.setUTCDate(selectedWeekStart.getUTCDate() - 21)
  periodEnd.setUTCDate(selectedWeekStart.getUTCDate() + 6)

  if (nextWeekStart.getTime() > currentWeekStart.getTime()) {
    nextWeekStart.setTime(currentWeekStart.getTime())
  }

  const isCurrentPeriod = selectedWeekStart.getTime() === currentWeekStart.getTime()
  const previousWeekHref = buildWeekHref(previousWeekStart)
  const nextWeekHref = buildWeekHref(nextWeekStart)
  const periodLabel =
    dateutil.formatDate(periodStart, 'YYYY.MM.DD') + ' ~ ' + dateutil.formatDate(periodEnd, 'YYYY.MM.DD')
  const weeklySecondsByKey = {}
  const weeklyBooksByKey = {}

  const sessionRows = arrayOf(
    new DynamicModel({ endedAt: '', durationSeconds: 0, bookId: '', bookTitle: '', coverUrl: '' })
  )

  const queryStartKey = isCalendarView ? monthStartKey : dateutil.formatDate(periodStart, dateutil.FORMATS.DATE)
  const queryEndKey = isCalendarView ? monthEndKey : dateutil.formatDate(periodEnd, dateutil.FORMATS.DATE)

  dbg('page/reading-records:find-sessions', {
    userId: userId,
    view: isCalendarView ? 'calendar' : 'weekly',
    periodStart: queryStartKey,
    periodEnd: queryEndKey,
  })

  $app
    .db()
    .newQuery(
      `SELECT reading_sessions.ended_at AS endedAt, reading_sessions.duration_seconds AS durationSeconds,
        reading_sessions.book_id AS bookId, COALESCE(books.title, '책 정보 없음') AS bookTitle,
                COALESCE(books.book_image_url, '') AS coverUrl
      FROM reading_sessions
      LEFT JOIN books ON books.id = reading_sessions.book_id
      WHERE reading_sessions.user_id = {:userId}
        AND reading_sessions.ended_at >= {:periodStart} AND reading_sessions.ended_at <= {:periodEnd}
        AND reading_sessions.duration_seconds > 0
      ORDER BY reading_sessions.ended_at DESC`
    )
    .bind({
      userId: userId,
      periodStart: dateutil.dbStartOfDay(queryStartKey),
      periodEnd: dateutil.dbEndOfDay(queryEndKey),
    })
    .all(sessionRows)

  for (let weekIndex = 3; weekIndex >= 0; weekIndex -= 1) {
    const weekStart = new Date(selectedWeekStart.getTime())

    weekStart.setUTCDate(selectedWeekStart.getUTCDate() - weekIndex * 7)
    const weekEnd = new Date(weekStart.getTime())

    weekEnd.setUTCDate(weekStart.getUTCDate() + 6)

    const weekKey = dateutil.formatDate(weekStart, dateutil.FORMATS.DATE)
    const weekStartLabel = dateutil.formatDate(weekStart, dateutil.FORMATS.DATE).slice(5)
    const weekEndLabel = dateutil.formatDate(weekEnd, dateutil.FORMATS.DATE).slice(5)
    weeklySecondsByKey[weekKey] = 0
    weeklyBooksByKey[weekKey] = {}
    weekItems.push({
      key: weekKey,
      label: weekStartLabel + ' ~ ' + weekEndLabel,
      minutes: 0,
      minutesLabel: '0분',
      books: [],
    })
  }

  if (isCalendarView) {
    const leadingDays = (Number(dateutil.formatDate(monthStartKey, 'd')) + 6) % 7
    for (let index = 0; index < leadingDays; index += 1) {
      calendarCells.push(null)
    }
    const dayCount = Number(dateutil.formatDate(monthEndKey, 'D'))
    for (let index = 0; index < dayCount; index += 1) {
      const key = dateutil.formatDate(dateutil.addDays(monthStartKey, index), dateutil.FORMATS.DATE)
      const day = {
        key: key,
        number: index + 1,
        label: dateutil.formatDate(key, 'M월 D일'),
        isToday: key === todayKey,
        isFuture: key > todayKey,
        seconds: 0,
        minutesLabel: '0분',
        booksById: {},
        books: [],
        cover: null,
        accessibleLabel: '',
      }
      daysByKey[key] = day
      calendarDays.push(day)
      calendarCells.push(day)
    }
    while (calendarCells.length % 7) {
      calendarCells.push(null)
    }
  }

  for (let index = 0; index < sessionRows.length; index += 1) {
    const row = sessionRows[index]
    const endedAtValue = String(row.endedAt || '').trim()
    const durationSeconds = Number(row.durationSeconds || 0)
    const endedAt = endedAtValue ? dateutil.toDate(endedAtValue) : null

    if (!endedAt || isNaN(endedAt.getTime()) || isNaN(durationSeconds) || durationSeconds < 1) {
      continue
    }

    const dayKey = dateutil.formatDate(endedAt, dateutil.FORMATS.DATE)
    const day = daysByKey[dayKey]
    if (day) {
      const bookId = String(row.bookId || '')
      if (!day.booksById[bookId]) {
        day.booksById[bookId] = {
          title: bookTitleService.getMainTitle(String(row.bookTitle || '제목 없음')),
          coverUrl: String(row.coverUrl || '').trim(),
          seconds: 0,
          minutesLabel: '',
        }
        day.books.push(day.booksById[bookId])
      }
      day.booksById[bookId].seconds += durationSeconds
      day.seconds += durationSeconds
    }

    const weekKey = dateutil.formatDate(getWeekStart(endedAt), dateutil.FORMATS.DATE)

    if (typeof weeklySecondsByKey[weekKey] === 'number') {
      weeklySecondsByKey[weekKey] += durationSeconds

      const bookId = String(row.bookId || '')
      const weeklyBooks = weeklyBooksByKey[weekKey]

      if (!weeklyBooks[bookId]) {
        weeklyBooks[bookId] = {
          title: bookTitleService.getMainTitle(String(row.bookTitle || '제목 없음')),
          seconds: 0,
          minutesLabel: '',
        }
      }

      weeklyBooks[bookId].seconds += durationSeconds
    }
  }

  for (let index = 0; index < weekItems.length; index += 1) {
    const seconds = weeklySecondsByKey[weekItems[index].key] || 0
    const minutes = Math.round(seconds / 60)

    weekItems[index].minutes = minutes
    weekItems[index].minutesLabel = formatMinutesLabel(minutes)
    const weeklyBooks = weeklyBooksByKey[weekItems[index].key]
    const bookIds = Object.keys(weeklyBooks)

    for (let bookIndex = 0; bookIndex < bookIds.length; bookIndex += 1) {
      const book = weeklyBooks[bookIds[bookIndex]]
      book.minutesLabel = book.seconds < 60 ? '1분 미만' : formatMinutesLabel(Math.round(book.seconds / 60))
      weekItems[index].books.push(book)
    }

    weekItems[index].books.sort(function (left, right) {
      return right.seconds - left.seconds
    })
  }

  let selectedDayKey = monthKey === currentMonthKey ? todayKey : monthStartKey
  for (let index = 0; index < calendarDays.length; index += 1) {
    const day = calendarDays[index]
    day.books.sort(function (left, right) {
      return right.seconds - left.seconds
    })
    day.cover = day.books.length ? day.books[0] : null
    day.minutesLabel = day.seconds > 0 && day.seconds < 60 ? '1분 미만' : formatMinutesLabel(day.seconds / 60)
    day.accessibleLabel =
      day.label
      + (day.isToday ? ' 오늘' : '')
      + ', '
      + (day.books.length ? day.books.length + '권 · ' + day.minutesLabel : '독서 기록 없음')
    for (let bookIndex = 0; bookIndex < day.books.length; bookIndex += 1) {
      const book = day.books[bookIndex]
      book.minutesLabel = book.seconds < 60 ? '1분 미만' : formatMinutesLabel(book.seconds / 60)
    }
    if (day.seconds > 0) {
      readingDayCount += 1
      monthSeconds += day.seconds
      if (monthKey !== currentMonthKey) selectedDayKey = day.key
    }
  }
  const monthMinutesLabel = monthSeconds > 0 && monthSeconds < 60 ? '1분 미만' : formatMinutesLabel(monthSeconds / 60)
</script>

<script>
  ;(function () {
    const storageKey = 'booklog.readingRecords.view'
    const url = new URL(window.location.href)
    const view = url.searchParams.get('view')

    try {
      if (view === 'calendar' || view === 'weekly') {
        window.localStorage.setItem(storageKey, view)
      } else if (url.searchParams.has('week')) {
        window.localStorage.setItem(storageKey, 'weekly')
      } else if (window.localStorage.getItem(storageKey) === 'calendar') {
        url.searchParams.set('view', 'calendar')
        window.location.replace(url.pathname + url.search + url.hash)
      }
    } catch (error) {
      // 저장소 사용이 제한된 브라우저에서는 기본 보기와 링크 이동을 유지합니다.
    }
  })()
</script>

<section class="space-y-6">
  <div class="space-y-3">
    <a
      href="/"
      class="inline-flex items-center gap-2 rounded-full border-none bg-white/78 px-3 py-2 text-sm font-medium text-stone-700 no-underline shadow-[0_10px_22px_rgba(70,52,31,0.08)] ring-0 outline-none">
      <span
        class="i-lucide-arrow-left h-4 w-4"
        aria-hidden="true"></span>
      메인으로
    </a>
    <div class="flex items-center justify-between gap-3">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-950 sm:text-3xl">독서 기록</h1>
      <a
        href="<%= isCalendarView ? weeklyHref : calendarHref %>"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white/80 px-3 py-2 text-sm font-semibold text-stone-700 no-underline shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500">
        <span
          class="<%= isCalendarView ? 'i-lucide-list' : 'i-lucide-calendar-days' %> h-4 w-4"
          aria-hidden="true"></span>
        <%= isCalendarView ? '주차별 보기' : '달력 보기' %>
      </a>
    </div>
  </div>

  <% if (!isCalendarView) { %>
  <section
    class="grid grid-cols-3 overflow-hidden rounded-[1.35rem] bg-white/82 shadow-[inset_0_0_0_1px_rgba(120,93,63,0.08)] sm:gap-3 sm:overflow-visible sm:bg-transparent sm:shadow-none">
    <div
      class="min-w-0 px-3 py-3 sm:rounded-[1.5rem] sm:bg-white/80 sm:px-4 sm:py-4 sm:shadow-[inset_0_0_0_1px_rgba(120,93,63,0.08)]">
      <p
        class="text-[10px] font-semibold tracking-[0.16em] text-stone-500 uppercase sm:text-[11px] sm:tracking-[0.2em]">
        이번 주
      </p>
      <p
        class="mt-1 text-[clamp(0.75rem,4vw,1rem)] font-semibold tracking-tight whitespace-nowrap text-stone-950 sm:mt-2 sm:text-2xl">
        <%= formatMinutesLabel(currentWeekMinutes) %>
      </p>
    </div>
    <div
      class="min-w-0 border-x border-stone-200/70 px-3 py-3 sm:rounded-[1.5rem] sm:border-x-0 sm:bg-white/80 sm:px-4 sm:py-4 sm:shadow-[inset_0_0_0_1px_rgba(120,93,63,0.08)]">
      <p
        class="text-[10px] font-semibold tracking-[0.16em] text-stone-500 uppercase sm:text-[11px] sm:tracking-[0.2em]">
        누적
      </p>
      <p
        class="mt-1 text-[clamp(0.75rem,4vw,1rem)] font-semibold tracking-tight whitespace-nowrap text-stone-950 sm:mt-2 sm:text-2xl">
        <%= totalMinutesLabel %>
      </p>
    </div>
    <div
      class="min-w-0 px-3 py-3 sm:rounded-[1.5rem] sm:bg-white/80 sm:px-4 sm:py-4 sm:shadow-[inset_0_0_0_1px_rgba(120,93,63,0.08)]">
      <p
        class="text-[10px] font-semibold tracking-[0.16em] text-stone-500 uppercase sm:text-[11px] sm:tracking-[0.2em]">
        완독
      </p>
      <p
        class="mt-1 text-[clamp(0.75rem,4vw,1rem)] font-semibold tracking-tight whitespace-nowrap text-stone-950 sm:mt-2 sm:text-2xl">
        <%= finishedBookCount %>권
      </p>
    </div>
  </section>

  <section
    class="rounded-[1.6rem] border border-stone-200/80 bg-white/80 p-4 shadow-[0_18px_45px_rgba(73,54,31,0.08)] backdrop-blur-sm sm:rounded-[2rem] sm:p-5">
    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-semibold tracking-tight text-stone-950 sm:text-xl">주차별 독서 시간</h2>
      </div>
      <div class="flex w-full flex-col gap-2 sm:w-auto sm:items-end">
        <div class="flex min-w-0 items-center justify-between gap-2 sm:justify-end">
          <a
            href="<%= previousWeekHref %>"
            aria-label="이전 4주"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#f5efe4] text-stone-700 no-underline shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1)] ring-0 outline-none">
            <span
              class="i-lucide-chevron-left h-4 w-4"
              aria-hidden="true"></span>
          </a>
          <p class="min-w-0 flex-1 text-center text-sm font-semibold tracking-tight text-stone-900 sm:min-w-[13.5rem]">
            <%= periodLabel %>
          </p>
          <% if (isCurrentPeriod) { %>
          <span
            aria-disabled="true"
            aria-label="다음 4주"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-300 shadow-[inset_0_0_0_1px_rgba(120,113,108,0.12)]">
            <span
              class="i-lucide-chevron-right h-4 w-4"
              aria-hidden="true"></span>
          </span>
          <% } else { %>
          <a
            href="<%= nextWeekHref %>"
            aria-label="다음 4주"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#f5efe4] text-stone-700 no-underline shadow-[inset_0_0_0_1px_rgba(118,87,52,0.1)] ring-0 outline-none">
            <span
              class="i-lucide-chevron-right h-4 w-4"
              aria-hidden="true"></span>
          </a>
          <% } %>
        </div>
        <% if (!isCurrentPeriod) { %>
        <a
          href="/reading-records?view=weekly"
          class="self-center text-xs font-semibold text-stone-500 no-underline sm:self-auto">
          이번 주로 돌아가기
        </a>
        <% } %>
      </div>
    </div>

    <div class="space-y-2">
      <% for (let index = 0; index < weekItems.length; index += 1) { const item = weekItems[index] %>
      <div x-data="{}">
        <button
          type="button"
          @click="$refs.weekDialog.showModal()"
          aria-haspopup="dialog"
          aria-controls="week-dialog-<%= item.key %>"
          aria-label="<%= item.label %> 독서 기록 보기"
          class="flex w-full cursor-pointer items-center justify-between gap-3 rounded-[1rem] border-none bg-[#fbf7ef] px-3 py-2 text-left text-sm shadow-[inset_0_0_0_1px_rgba(118,87,52,0.08)] hover:bg-[#f5efe4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500 sm:rounded-[1.1rem] sm:px-4 sm:py-3">
          <span class="font-medium text-stone-700"><%= item.label %></span>
          <span class="flex shrink-0 items-center gap-2 font-semibold text-stone-950">
            <%= item.minutesLabel %>
            <span
              class="i-lucide-chevron-right h-4 w-4 text-stone-400"
              aria-hidden="true"></span>
          </span>
        </button>
        <dialog
          id="week-dialog-<%= item.key %>"
          x-ref="weekDialog"
          aria-labelledby="week-title-<%= item.key %>"
          @click="if ($event.target === $el) $el.close()"
          class="fixed inset-0 m-auto max-h-[80dvh] w-[calc(100%-2rem)] max-w-md overflow-hidden rounded-[1.5rem] border-none bg-[#fbf7ef] p-0 text-stone-950 shadow-xl">
          <div
            class="flex max-h-[80dvh] flex-col"
            @click.stop>
            <div class="flex shrink-0 items-start justify-between gap-3 px-5 pt-5 pb-4">
              <div>
                <h3
                  id="week-title-<%= item.key %>"
                  class="text-lg font-semibold">
                  <%= item.label %> 독서 기록
                </h3>
                <p class="mt-1 text-sm text-stone-500">총 <%= item.minutesLabel %> · 세션 종료일 기준</p>
              </div>
              <button
                type="button"
                @click="$refs.weekDialog.close()"
                aria-label="닫기"
                class="inline-flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full border-none bg-[#f7f2e8] p-0 text-stone-700">
                <span
                  class="i-lucide-x h-4 w-4"
                  aria-hidden="true"></span>
              </button>
            </div>
            <div class="min-h-0 overflow-y-auto overscroll-contain px-5 pb-5">
              <% if (item.books.length) { %>
              <ul class="m-0 list-none space-y-2 p-0">
                <% for (let bookIndex = 0; bookIndex < item.books.length; bookIndex += 1) { const book = item.books[bookIndex] %>
                <li class="flex items-start justify-between gap-4 rounded-xl bg-white/80 px-3 py-3 text-sm">
                  <span class="min-w-0 font-medium break-words"><%= book.title %></span>
                  <span class="shrink-0 font-semibold"><%= book.minutesLabel %></span>
                </li>
                <% } %>
              </ul>
              <% } else { %>
              <p class="py-6 text-center text-sm text-stone-500">이 주차에는 독서 기록이 없습니다.</p>
              <% } %>
            </div>
          </div>
        </dialog>
      </div>
      <% } %>
    </div>
  </section>
  <% } else { %>
  <section
    x-data="{ selectedDay: '<%= selectedDayKey %>' }"
    aria-label="독서 달력"
    class="rounded-[1.6rem] border border-stone-200/80 bg-white/80 p-3 shadow-[0_18px_45px_rgba(73,54,31,0.08)] sm:rounded-[2rem] sm:p-5">
    <div class="mb-3 flex items-center justify-between gap-3">
      <a
        href="<%= previousMonthHref %>"
        aria-label="이전 달"
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#f5efe4] text-stone-700 no-underline focus-visible:outline-2 focus-visible:outline-stone-500">
        <span
          class="i-lucide-chevron-left h-4 w-4"
          aria-hidden="true"></span>
      </a>
      <div class="text-center">
        <h2 class="text-lg font-semibold text-stone-950"><%= monthLabel %></h2>
        <p class="mt-1 text-xs text-stone-500"><%= readingDayCount %>일 동안 읽었어요 · <%= monthMinutesLabel %></p>
      </div>
      <% if (monthKey === currentMonthKey) { %>
      <span
        aria-disabled="true"
        aria-label="다음 달"
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-300">
        <span
          class="i-lucide-chevron-right h-4 w-4"
          aria-hidden="true"></span>
      </span>
      <% } else { %>
      <a
        href="<%= nextMonthHref %>"
        aria-label="다음 달"
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#f5efe4] text-stone-700 no-underline focus-visible:outline-2 focus-visible:outline-stone-500">
        <span
          class="i-lucide-chevron-right h-4 w-4"
          aria-hidden="true"></span>
      </a>
      <% } %>
    </div>
    <% if (monthKey !== currentMonthKey) { %>
    <a
      href="/reading-records?view=calendar"
      class="mb-3 block text-center text-xs font-semibold text-stone-500 no-underline">
      이번 달로 돌아가기
    </a>
    <% } %>
    <div class="grid grid-cols-7 gap-1 text-center">
      <% for (let index = 0; index < weekdayLabels.length; index += 1) { %>
      <span class="py-2 text-xs font-medium text-stone-400"><%= weekdayLabels[index] %></span>
      <% } %>
      <% for (let index = 0; index < calendarCells.length; index += 1) { const day = calendarCells[index] %>
      <% if (!day) { %>
      <div aria-hidden="true"></div>
      <% } else { %>
      <button
        type="button"
        @click="selectedDay = '<%= day.key %>'"
        :aria-pressed="selectedDay === '<%= day.key %>'"
        aria-controls="reading-day-details"
        aria-label="<%= day.accessibleLabel %>"
        aria-current="<%= day.isToday ? 'date' : 'false' %>"
        <%= day.isFuture ? 'disabled' : '' %>
        :class="selectedDay === '<%= day.key %>' ? 'bg-[#eee3d1] ring-1 ring-inset ring-[#b89a72]' : 'bg-[#fbf7ef]'"
        class="flex min-h-[6.5rem] min-w-0 flex-col items-center gap-1 rounded-xl border-none px-0.5 py-2 text-stone-700 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500 enabled:cursor-pointer disabled:opacity-35 sm:min-h-[8rem] sm:gap-2">
        <span
          class="<%= day.isToday ? 'bg-stone-800 text-white' : '' %> inline-flex h-6 w-6 items-center justify-center rounded-full text-xs font-semibold">
          <%= day.number %>
        </span>
        <% if (day.cover) { %>
        <span
          class="relative block h-12 w-8 shrink-0 overflow-hidden rounded-[0.2rem] bg-[#d8c3a5] shadow-[2px_3px_5px_rgba(74,50,28,0.2)] sm:h-15 sm:w-10">
          <span
            class="absolute inset-0 flex items-center justify-center p-1 text-[8px] leading-tight text-stone-700"
            aria-hidden="true">
            <%= day.cover.title %>
          </span>
          <% if (day.cover.coverUrl) { %>
          <img
            src="<%= day.cover.coverUrl %>"
            alt=""
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            @error="$el.hidden = true"
            class="relative h-full w-full object-cover" />
          <% } %>
        </span>
        <% if (day.books.length > 1) { %>
        <span class="text-[10px] font-semibold text-stone-500">+<%= day.books.length - 1 %></span>
        <% } %>
        <% } %>
      </button>
      <% } %>
      <% } %>
    </div>
    <p class="mt-3 text-center text-xs text-stone-400">날짜를 누르면 읽은 책을 볼 수 있어요 · 세션 종료일 기준</p>
    <% if (!readingDayCount) { %>
    <p class="mt-4 rounded-xl bg-[#fbf7ef] p-4 text-center text-sm text-stone-500">
      이달에는 아직 독서 기록이 없습니다.
    </p>
    <% } %>
    <div
      id="reading-day-details"
      class="mt-5 border-t border-stone-200/70 pt-5"
      aria-live="polite"
      aria-atomic="true">
      <% for (let index = 0; index < calendarDays.length; index += 1) { const day = calendarDays[index] %>
      <div
        x-show="selectedDay === '<%= day.key %>'"
        style="<%= day.key === selectedDayKey ? '' : 'display: none' %>">
        <div class="mb-3 flex items-center justify-between gap-2">
          <h3 class="text-base font-semibold text-stone-950"><%= day.label %><%= day.isToday ? ' · 오늘' : '' %></h3>
          <span class="text-xs font-semibold text-stone-500"><%= day.books.length %>권 · <%= day.minutesLabel %></span>
        </div>
        <% if (day.books.length) { %>
        <ul class="m-0 list-none space-y-2 p-0">
          <% for (let bookIndex = 0; bookIndex < day.books.length; bookIndex += 1) { const book = day.books[bookIndex] %>
          <li class="flex items-center gap-3 rounded-xl bg-[#fbf7ef] p-3">
            <div class="relative h-15 w-10 shrink-0 overflow-hidden rounded-[0.25rem] bg-[#d8c3a5] shadow-sm">
              <span
                class="absolute inset-0 flex items-center justify-center p-1 text-center text-[9px] leading-tight text-stone-700"
                aria-hidden="true">
                표지 없음
              </span>
              <% if (book.coverUrl) { %>
              <img
                src="<%= book.coverUrl %>"
                alt="<%= book.title %> 표지"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                @error="$el.hidden = true"
                class="relative h-full w-full object-cover" />
              <% } %>
            </div>
            <p class="min-w-0 flex-1 text-sm font-medium break-words text-stone-900"><%= book.title %></p>
            <span class="shrink-0 text-xs font-semibold text-stone-700 sm:text-sm"><%= book.minutesLabel %></span>
          </li>
          <% } %>
        </ul>
        <% } else { %>
        <p class="rounded-xl bg-[#fbf7ef] px-3 py-6 text-center text-sm text-stone-500">
          이날에는 독서 기록이 없습니다.
        </p>
        <% } %>
      </div>
      <% } %>
    </div>
  </section>
  <% } %>
</section>
