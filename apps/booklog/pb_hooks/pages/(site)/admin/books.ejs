<script server>
  meta('title', '도서 관리')
  meta('description', '북로그 도서와 연결된 사용자를 관리합니다.')

  if (!request.auth || request.auth.get('admin_manager') !== true) {
    warn('page/admin/books:forbidden', { userId: request.auth ? request.auth.get('id') : '' })
    dbg('page/admin/books:redirect', { status: 303, redirectTo: '/', message: '관리자 권한이 필요합니다.' })
    redirect('/', { status: 303, message: '관리자 권한이 필요합니다.' })
    return
  }

  const queryText = String(request.url.query.q || '')
    .trim()
    .slice(0, 200)
  const scope = request.url.query.scope === 'all' ? 'all' : 'unused'
  const sort = request.url.query.sort === 'size' ? 'size' : 'newest'
  const requestedPage = Math.max(1, Math.floor(Number(request.url.query.page) || 1))
  const pageSize = 30
  const userId = String(request.auth.get('id') || '')

  function buildPageHref(page) {
    return '/admin/books?scope=' + scope + '&q=' + encodeURIComponent(queryText) + '&sort=' + sort + '&page=' + page
  }

  dbg('page/admin/books:start', { userId, method: request.method, scope, queryText })

  if (request.method === 'POST' && body().action === 'audio-start') {
    const form = body()
    const bookId = String(form.bookId || '').trim()
    const fileId = String(form.fileId || '').trim()
    let message = ''
    try {
      // 관리자는 자기 도서함에 없는 책도 생성할 수 있지만, EPUB이 그 책의 파일인지는 확인합니다.
      $app.findFirstRecordByFilter('book_files', 'id = {:fileId} && book_id = {:bookId}', { fileId, bookId })
      const audioData = resolve('book-audio-data')
      const job = audioData.findFileJob($app, fileId)
      const options = audioData.getModelOptions($app, fileId)
      const available = audioData.pickAvailableModel(options)
      const model = job ? String(job.get('model')) : available ? available.model : audioData.DEFAULT_MODEL
      const result = resolve('book-audio-job-service').requestJob($app, fileId, userId, audioData.getSettings(model))
      message = result.message || 'AI 오디오북 생성을 예약했습니다. 2분 안에 책을 분석해 생성을 시작합니다.'
      info('page/admin/books:audio-requested', { userId, bookId, fileId, model, accepted: !result.message })
    } catch (exception) {
      error('page/admin/books:audio-request-failed', {
        userId,
        bookId,
        fileId,
        error: String(exception.message || exception),
      })
      message = 'AI 오디오북 생성을 요청하지 못했습니다. 목록을 새로고침한 뒤 다시 시도해 주세요.'
    }
    const redirectTo = buildPageHref(requestedPage)
    dbg('page/admin/books:redirect', { status: 303, redirectTo, message })
    redirect(redirectTo, { status: 303, message })
    return
  }

  if (request.method === 'POST' && body().action === 'audio-delete') {
    const form = body()
    const bookId = String(form.bookId || '').trim()
    const fileId = String(form.fileId || '').trim()
    let message = ''
    try {
      $app.findFirstRecordByFilter('book_files', 'id = {:fileId} && book_id = {:bookId}', { fileId, bookId })
      const deleted = resolve('book-audio-job-service').deleteAudioBook($app, fileId)
      info('page/admin/books:audio-deleted', { userId, bookId, fileId, deleted })
      message = deleted.chunks + deleted.jobs > 0 ? 'AI 오디오북을 삭제했습니다.' : '삭제할 AI 오디오북이 없습니다.'
    } catch (exception) {
      error('page/admin/books:audio-delete-failed', {
        userId,
        bookId,
        fileId,
        error: String(exception.message || exception),
      })
      message = 'AI 오디오북을 삭제하지 못했습니다. 목록을 새로고침한 뒤 다시 시도해 주세요.'
    }
    const redirectTo = buildPageHref(requestedPage)
    dbg('page/admin/books:redirect', { status: 303, redirectTo, message })
    redirect(redirectTo, { status: 303, message })
    return
  }

  if (request.method === 'POST') {
    const form = body()
    const bookId = String(form.bookId || '').trim()
    const expectedUserCount = Number(form.userCount)
    let message = '책과 관련 데이터를 삭제했습니다.'

    try {
      if (form.action !== 'delete' || !bookId || !Number.isInteger(expectedUserCount) || expectedUserCount < 0) {
        throw new Error('삭제할 책 정보를 확인해 주세요.')
      }

      $app.runInTransaction(function (txApp) {
        const book = txApp.findRecordById('books', bookId)
        const connectedUsers = new DynamicModel({ total: 0 })
        txApp
          .db()
          .newQuery('SELECT count(DISTINCT user_id) AS total FROM book_shelves WHERE book_id = {:bookId}')
          .bind({ bookId })
          .one(connectedUsers)
        if (Number(connectedUsers.total) !== expectedUserCount) {
          throw new Error('연결 인원이 변경되었습니다. 목록을 확인한 뒤 다시 삭제해 주세요.')
        }

        txApp
          .findRecordsByFilter('push_send_logs', 'book_id = {:bookId}', '', 0, 0, { bookId })
          .forEach(function (record) {
            txApp.delete(record)
          })
        // 스키마의 cascadeDelete로 도서함·독서 기록·모든 EPUB·오디오 데이터를 함께 삭제합니다.
        // Record 삭제를 사용해야 EPUB와 음성 파일도 PocketBase에서 정리합니다.
        txApp.delete(book)
      })
      info('page/admin/books:deleted', { userId, bookId, connectedUserCount: expectedUserCount })
    } catch (exception) {
      const detail = String(exception.message || exception)
      error('page/admin/books:delete-failed', { userId, bookId, error: detail })
      message =
        detail.indexOf('연결 인원이 변경') === 0 || detail.indexOf('삭제할 책 정보') === 0
          ? detail
          : '책 삭제에 실패했습니다. 목록을 새로고침한 뒤 다시 시도해 주세요.'
    }

    const redirectTo = buildPageHref(requestedPage)
    dbg('page/admin/books:redirect', { status: 303, redirectTo, message })
    redirect(redirectTo, { status: 303, message })
    return
  }

  const unusedCondition = 'NOT EXISTS (SELECT 1 FROM book_shelves WHERE book_shelves.book_id = books.id)'
  const conditions = []
  const bindings = queryText ? { search: '%' + queryText + '%' } : {}
  if (scope === 'unused') conditions.push(unusedCondition)
  if (queryText) {
    conditions.push('(books.title LIKE {:search} OR books.author LIKE {:search})')
  }
  const whereSql = conditions.length ? ' WHERE ' + conditions.join(' AND ') : ''
  const summary = new DynamicModel({ total: 0, unused: 0 })
  $app
    .db()
    .newQuery(
      'SELECT count(*) AS total, coalesce(sum(CASE WHEN '
        + unusedCondition
        + ' THEN 1 ELSE 0 END), 0) AS unused FROM books'
    )
    .one(summary)
  const matched = new DynamicModel({ total: 0 })
  $app
    .db()
    .newQuery('SELECT count(*) AS total FROM books' + whereSql)
    .bind(bindings)
    .one(matched)
  const pageCount = Math.max(1, Math.ceil(Number(matched.total) / pageSize))
  const currentPage = Math.min(requestedPage, pageCount)
  let rows = arrayOf(
    new DynamicModel({
      bookId: '',
      title: '',
      author: '',
      userCount: 0,
      userNames: '',
      fileCount: 0,
      fileBytes: 0,
      audioCount: 0,
    })
  )
  $app
    .db()
    .newQuery(
      'SELECT books.id AS bookId, books.title AS title, books.author AS author, '
        + '(SELECT count(DISTINCT user_id) FROM book_shelves WHERE book_id = books.id) AS userCount, '
        + "coalesce((SELECT group_concat(coalesce(nullif(users.name, ''), users.email), ', ') FROM book_shelves JOIN users ON users.id = book_shelves.user_id WHERE book_shelves.book_id = books.id), '') AS userNames, "
        + '(SELECT count(*) FROM book_files WHERE book_id = books.id) AS fileCount, '
        + '(SELECT coalesce(sum(file_size), 0) FROM book_files WHERE book_id = books.id) AS fileBytes, '
        + "(SELECT count(*) FROM book_audio_chunks JOIN book_files ON book_files.id = book_audio_chunks.file_id WHERE book_files.book_id = books.id AND book_audio_chunks.audio_file != '') AS audioCount "
        + 'FROM books'
        + whereSql
        + ' ORDER BY books.created DESC, books.id ASC'
        + (sort === 'size' ? '' : ' LIMIT {:limit} OFFSET {:offset}')
    )
    .bind(Object.assign({}, bindings, { limit: pageSize, offset: (currentPage - 1) * pageSize }))
    .all(rows)

  // 용량순은 검색 결과 전체를 집계한 뒤 페이지를 나눕니다.
  const audioBytesByBook = {}
  const audioSizeUnknown = {}
  const storageBindings = {}
  const storageIds = rows.map(function (row, index) {
    storageBindings['id' + index] = String(row.bookId)
    return '{:id' + index + '}'
  })
  if (storageIds.length) {
    const audioRows = arrayOf(new DynamicModel({ bookId: '', chunkId: '', audioFile: '' }))
    $app
      .db()
      .newQuery(
        'SELECT book_files.book_id AS bookId, book_audio_chunks.id AS chunkId, book_audio_chunks.audio_file AS audioFile '
          + 'FROM book_audio_chunks JOIN book_files ON book_files.id = book_audio_chunks.file_id '
          + "WHERE book_audio_chunks.audio_file != '' AND book_files.book_id IN ("
          + storageIds.join(',')
          + ')'
      )
      .bind(storageBindings)
      .all(audioRows)
    if (audioRows.length) {
      const collectionId = $app.findCollectionByNameOrId('book_audio_chunks').id
      const filesystem = $app.newFilesystem()
      try {
        audioRows.forEach(function (chunk) {
          const bookId = String(chunk.bookId)
          try {
            const attributes = filesystem.attributes(collectionId + '/' + chunk.chunkId + '/' + chunk.audioFile)
            audioBytesByBook[bookId] = (audioBytesByBook[bookId] || 0) + Number(attributes.size)
          } catch (exception) {
            audioSizeUnknown[bookId] = true
            warn('page/admin/books:audio-size-unavailable', {
              bookId,
              chunkId: String(chunk.chunkId),
              error: String(exception),
            })
          }
        })
      } finally {
        filesystem.close()
      }
    }
  }
  if (sort === 'size') {
    // 집계하지 못한 도서는 정확한 용량으로 비교할 수 없어 뒤에 표시합니다.
    rows.sort(function (left, right) {
      const leftId = String(left.bookId)
      const rightId = String(right.bookId)
      const unknownOrder = Number(!!audioSizeUnknown[leftId]) - Number(!!audioSizeUnknown[rightId])
      if (unknownOrder) return unknownOrder
      const difference =
        Number(right.fileBytes)
        + (audioBytesByBook[rightId] || 0)
        - Number(left.fileBytes)
        - (audioBytesByBook[leftId] || 0)
      return difference || (leftId < rightId ? -1 : leftId > rightId ? 1 : 0)
    })
    rows = rows.slice((currentPage - 1) * pageSize, currentPage * pageSize)
  }

  function formatBytes(bytes) {
    if (bytes === 0) return '0 B'
    if (bytes < 1024) return bytes + ' B'
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB'
    if (bytes < 1024 * 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB'
    return (bytes / 1024 / 1024 / 1024).toFixed(2) + ' GB'
  }

  const audioData = resolve('book-audio-data')
  const audioJobService = resolve('book-audio-job-service')
  const audioFilesByBook = {}
  const fileBindings = {}
  const fileFilter = rows
    .map(function (row, index) {
      fileBindings['book' + index] = String(row.bookId)
      return 'book_id = {:book' + index + '}'
    })
    .join(' || ')
  if (fileFilter) {
    $app.findRecordsByFilter('book_files', fileFilter, 'created,id', 0, 0, fileBindings).forEach(function (file) {
      const fileId = String(file.get('id'))
      const job = audioData.findFileJob($app, fileId)
      const view = job ? audioJobService.jobView(job) : null
      const bookId = String(file.get('book_id'))
      ;(audioFilesByBook[bookId] = audioFilesByBook[bookId] || []).push({
        fileId,
        name: String(file.get('original_name') || 'EPUB'),
        statusLabel: view ? view.statusLabel : 'AI 오디오북 없음',
        errorMessage: view && (view.status === 'failed' || view.failedChunks > 0) ? view.errorMessage : '',
        hasFailure: !!view && (view.status === 'failed' || view.failedChunks > 0),
        canRequest: !view || view.canStart,
        requestLabel: view ? '생성 다시 시작' : 'AI 오디오북 생성',
        canDelete: !!job || audioData.countFileChunks($app, fileId) > 0,
      })
    })
  }

  const books = rows.map(function (row) {
    const title = String(row.title || '제목 없음')
    const userCount = Number(row.userCount || 0)
    return {
      audioFiles: audioFilesByBook[String(row.bookId)] || [],
      bookId: String(row.bookId),
      title,
      author: String(row.author || '저자 정보 없음'),
      userCount,
      userNames: String(row.userNames || ''),
      fileCount: Number(row.fileCount || 0),
      fileSizeLabel: formatBytes(Number(row.fileBytes || 0)),
      audioSizeLabel: audioSizeUnknown[String(row.bookId)]
        ? '확인 불가'
        : formatBytes(audioBytesByBook[String(row.bookId)] || 0),
      totalSizeLabel: audioSizeUnknown[String(row.bookId)]
        ? '확인 불가'
        : formatBytes(Number(row.fileBytes || 0) + (audioBytesByBook[String(row.bookId)] || 0)),
      audioCount: Number(row.audioCount || 0),
      deleteConfirmation:
        '「'
        + title
        + '」을 영구 삭제할까요? 연결 인원 '
        + userCount
        + '명의 기록과 EPUB·오디오 파일도 함께 삭제되며 복구할 수 없습니다.',
    }
  })
  const previousHref = currentPage > 1 ? buildPageHref(currentPage - 1) : ''
  const nextHref = currentPage < pageCount ? buildPageHref(currentPage + 1) : ''
  const formAction = buildPageHref(currentPage)
  const flashMessage = params.__flash ? String(params.__flash) : ''
  dbg('page/admin/books:loaded', { matchedCount: Number(matched.total), currentPage })
</script>

<section class="space-y-6">
  <div class="space-y-3">
    <a
      href="/"
      class="inline-flex items-center gap-2 rounded-full border-none bg-white/78 px-3 py-2 text-sm font-medium text-stone-700 no-underline shadow-[0_10px_22px_rgba(70,52,31,0.08)] ring-0 outline-none">
      <span
        class="i-lucide-arrow-left h-4 w-4"
        aria-hidden="true"></span>
      메인으로
    </a>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-950 sm:text-3xl">도서 관리</h1>
      <p
        class="m-0 inline-flex items-center rounded-full bg-white/78 px-3 py-1.5 text-sm font-medium text-stone-600 shadow-[inset_0_0_0_1px_rgba(120,93,63,0.08)]">
        전체 <%= summary.total %>권 · 미사용 <%= summary.unused %>권
      </p>
    </div>
  </div>

  <% if (flashMessage) { %>
  <div><%- include('flash-alert.ejs') %></div>
  <% } %>

  <section class="overflow-hidden rounded-lg border border-solid border-stone-200 bg-white/90">
    <form
      method="get"
      action="/admin/books"
      class="flex flex-wrap items-center gap-2 border-0 border-b border-solid border-stone-200 bg-[#faf7ef] p-3">
      <label
        class="relative block w-full min-w-0 flex-none sm:max-w-xs sm:flex-1"
        for="admin-book-search">
        <span class="sr-only">제목 또는 저자 검색</span>
        <span
          class="i-lucide-search pointer-events-none absolute top-1/2 left-2.5 h-3.5 w-3.5 -translate-y-1/2 text-stone-400"
          aria-hidden="true"></span>
        <input
          id="admin-book-search"
          type="search"
          name="q"
          value="<%= queryText %>"
          maxlength="200"
          placeholder="제목이나 저자 검색"
          class="box-border h-8 w-full rounded-md border border-solid border-stone-300 bg-white pr-2 pl-8 text-xs text-stone-900 placeholder:text-stone-400 focus-visible:outline-stone-500" />
      </label>
      <label
        class="sr-only"
        for="admin-book-scope">
        도서 범위
      </label>
      <select
        id="admin-book-scope"
        name="scope"
        class="box-border h-8 rounded-md border border-solid border-stone-300 bg-white px-2 text-xs text-stone-700 focus-visible:outline-stone-500">
        <option
          value="unused"
          <%= scope === 'unused' ? 'selected' : '' %>>
          미사용 도서
        </option>
        <option
          value="all"
          <%= scope === 'all' ? 'selected' : '' %>>
          전체 도서
        </option>
      </select>
      <label
        class="sr-only"
        for="admin-book-sort">
        정렬
      </label>
      <select
        id="admin-book-sort"
        name="sort"
        class="box-border h-8 rounded-md border border-solid border-stone-300 bg-white px-2 text-xs text-stone-700 focus-visible:outline-stone-500">
        <option
          value="newest"
          <%= sort === 'newest' ? 'selected' : '' %>>
          최신순
        </option>
        <option
          value="size"
          <%= sort === 'size' ? 'selected' : '' %>>
          용량 큰 순
        </option>
      </select>
      <button
        type="submit"
        class="inline-flex h-8 shrink-0 items-center justify-center rounded-md border-0 bg-stone-800 px-3 text-xs font-semibold text-white hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500">
        검색
      </button>
    </form>

    <div
      class="flex flex-wrap items-center justify-between gap-1 border-0 border-b border-solid border-stone-200 px-3 py-2 text-xs text-stone-500">
      <p class="m-0">
        <span class="font-semibold text-stone-800"><%= scope === 'unused' ? '미사용 도서' : '전체 도서' %></span>
        · 검색 결과
        <strong class="font-semibold text-stone-800 tabular-nums"><%= matched.total %></strong>
        권
      </p>
    </div>

    <div
      class="overflow-x-auto focus-visible:outline-stone-500"
      role="region"
      aria-label="도서 관리 목록"
      tabindex="0">
      <table class="w-full min-w-[860px] table-fixed border-collapse text-left text-xs leading-5">
        <caption class="sr-only">도서별 연결 사용자, EPUB·오디오 총용량과 AI 오디오북 관리</caption>
        <thead class="bg-stone-100/80 text-stone-500">
          <tr>
            <th
              scope="col"
              class="w-[24%] px-3 py-2 font-medium">
              도서 / 저자
            </th>
            <th
              scope="col"
              class="w-[16%] px-3 py-2 font-medium">
              연결 사용자
            </th>
            <th
              scope="col"
              class="w-[19%] px-3 py-2 text-right font-medium">
              총용량
              <span class="block text-[11px] font-normal">EPUB + 오디오</span>
            </th>
            <th
              scope="col"
              class="px-3 py-2 font-medium">
              AI 오디오북
            </th>
            <th
              scope="col"
              class="w-16 px-3 py-2 text-right font-medium">
              관리
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (!books.length) { %>
          <tr>
            <td
              colspan="5"
              class="px-3 py-10 text-center text-stone-500">
              해당하는 도서가 없습니다.
            </td>
          </tr>
          <% } %>
          <% books.forEach(function (book) { %>
          <tr class="border-0 border-t border-solid border-stone-200/80 align-top hover:bg-[#faf7ef]">
            <th
              scope="row"
              class="px-3 py-2.5 text-left font-normal">
              <h2 class="m-0 text-[13px] leading-5 font-semibold break-words text-stone-950"><%= book.title %></h2>
              <p class="m-0 break-words text-stone-500"><%= book.author %></p>
              <p class="m-0 font-mono text-[11px] text-stone-400"><%= book.bookId %></p>
            </th>
            <td class="px-3 py-2.5">
              <span class="font-semibold tabular-nums"><%= book.userCount %>명</span>
              <% if (book.userNames) { %>
              <p class="m-0 break-all text-stone-500"><%= book.userNames %></p>
              <% } else { %>
              <span class="ml-1 rounded bg-[#efe2d2] px-1.5 py-0.5 text-[11px] text-[#8e5521]">미사용</span>
              <% } %>
            </td>
            <td class="px-3 py-2.5 text-right whitespace-nowrap tabular-nums">
              <span class="font-semibold text-stone-950"><%= book.totalSizeLabel %></span>
              <p class="m-0 text-[11px] text-stone-500">EPUB <%= book.fileSizeLabel %> · <%= book.fileCount %>개</p>
              <p class="m-0 text-[11px] text-stone-500">오디오 <%= book.audioSizeLabel %> · <%= book.audioCount %>개</p>
            </td>
            <td class="px-3 py-2.5">
              <div class="space-y-2">
                <% if (!book.audioFiles.length) { %>
                <span class="text-stone-400">EPUB 없음</span>
                <% } %>
                <% book.audioFiles.forEach(function (file) { %>
                <div class="space-y-1">
                  <p class="m-0 font-medium text-stone-700"><%= file.statusLabel %></p>
                  <% if (book.audioFiles.length > 1) { %>
                  <p class="m-0 text-[11px] break-all text-stone-500"><%= file.name %></p>
                  <% } %>
                  <% if (file.hasFailure) { %>
                  <details class="rounded-md bg-rose-50 px-2 py-1 text-xs text-rose-800">
                    <summary class="cursor-pointer font-medium focus-visible:outline-stone-500">실패 사유</summary>
                    <p class="mt-1 mb-0 max-h-40 overflow-y-auto break-all whitespace-pre-wrap">
                      <%= file.errorMessage || '저장된 오류 내용이 없습니다.' %>
                    </p>
                  </details>
                  <% } %>
                  <div class="flex flex-wrap items-center gap-1">
                    <% if (file.canRequest) { %>
                    <form
                      method="post"
                      action="<%= formAction %>"
                      class="m-0 shrink-0">
                      <input
                        type="hidden"
                        name="action"
                        value="audio-start" />
                      <input
                        type="hidden"
                        name="bookId"
                        value="<%= book.bookId %>" />
                      <input
                        type="hidden"
                        name="fileId"
                        value="<%= file.fileId %>" />
                      <button
                        type="submit"
                        class="inline-flex h-7 items-center justify-center rounded-md border-0 bg-[#efe2d2] px-2 text-xs font-semibold text-[#8e5521] ring-0 transition hover:bg-[#ead9c4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500">
                        <%= file.requestLabel %>
                      </button>
                    </form>
                    <% } %>
                    <% if (file.canDelete) { %>
                    <form
                      method="post"
                      action="<%= formAction %>"
                      onsubmit="return confirm(this.dataset.confirm)"
                      data-confirm="「<%= book.title %>」의 AI 오디오북 음성과 청취 기록을 모두 삭제할까요? EPUB은 남습니다."
                      class="m-0 shrink-0">
                      <input
                        type="hidden"
                        name="action"
                        value="audio-delete" />
                      <input
                        type="hidden"
                        name="bookId"
                        value="<%= book.bookId %>" />
                      <input
                        type="hidden"
                        name="fileId"
                        value="<%= file.fileId %>" />
                      <button
                        type="submit"
                        class="inline-flex h-7 items-center justify-center rounded-md border-0 bg-rose-50 px-2 text-xs font-semibold text-rose-700 shadow-[inset_0_0_0_1px_rgba(225,29,72,0.12)] ring-0 transition hover:bg-rose-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500">
                        오디오북 삭제
                      </button>
                    </form>
                    <% } %>
                  </div>
                </div>
                <% }) %>
              </div>
            </td>
            <td class="px-3 py-2.5 text-right">
              <form
                method="post"
                action="<%= formAction %>"
                onsubmit="return confirm(this.dataset.confirm)"
                data-confirm="<%= book.deleteConfirmation %>"
                class="shrink-0">
                <input
                  type="hidden"
                  name="action"
                  value="delete" />
                <input
                  type="hidden"
                  name="bookId"
                  value="<%= book.bookId %>" />
                <input
                  type="hidden"
                  name="userCount"
                  value="<%= book.userCount %>" />
                <button
                  type="submit"
                  class="inline-flex h-7 items-center justify-center rounded-md border-0 bg-rose-50 px-2 text-xs font-semibold text-rose-700 shadow-[inset_0_0_0_1px_rgba(225,29,72,0.12)] ring-0 transition hover:bg-rose-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500"
                  aria-label="<%= book.title %> 영구 삭제">
                  삭제
                </button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <nav
      aria-label="도서 목록 페이지"
      class="flex items-center justify-between gap-3 border-0 border-t border-solid border-stone-200 bg-[#faf7ef] px-3 py-2 text-xs">
      <div class="w-12">
        <% if (previousHref) { %>
        <a
          href="<%= previousHref %>"
          class="inline-flex h-7 items-center rounded-md border border-solid border-stone-200 bg-white px-2 font-medium text-stone-700 no-underline hover:bg-stone-100">
          이전
        </a>
        <% } %>
      </div>
      <span class="text-stone-500 tabular-nums">
        <%= currentPage %> / <%= pageCount %> 페이지 · <%= matched.total %>권
      </span>
      <div class="w-12 text-right">
        <% if (nextHref) { %>
        <a
          href="<%= nextHref %>"
          class="inline-flex h-7 items-center rounded-md border border-solid border-stone-200 bg-white px-2 font-medium text-stone-700 no-underline hover:bg-stone-100">
          다음
        </a>
        <% } %>
      </div>
    </nav>
  </section>
</section>
