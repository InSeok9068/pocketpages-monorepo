    "@pocketpages/test-support": "file:packages/test-support",
    "@types/node": "^24.13.2",
    "@unocss/cli": "66.10.5",
    "@unocss/preset-icons": "66.10.5",
    "@unocss/preset-wind4": "66.10.5",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-plugin-jsdoc": "^65.0.0",
